    },
    {
      "id": "A30120-zh-00012",
      "text": "人数",
      "source_hash": "4db37806d287be242e3efa91b3cb3701d6d7388dbb9376b6c97b4fab03a452f8"
    },
    {
      "id": "A30120-zh-00013",
      "text": "类别",
      "source_hash": "d8ba487317ac4e370c544ff11fee92077c5dfe235d14d8d93e213e278685f7be"
    },
    {
      "id": "A30120-zh-00014",
      "text": "人数",
      "source_hash": "4db37806d287be242e3efa91b3cb3701d6d7388dbb9376b6c97b4fab03a452f8"
    },
    {
      "id": "A30120-zh-00015",
      "text": "报考总人数",
      "source_hash": "9d52db1c705a53a53ae4b1ab980ed73fca4027e7126e64008db9e2448de09c97"
    },
    {
      "id": "A30120-zh-00017",
      "text": "身体及体能",
      "source_hash": "dd63b4eada4d0ab098137fdff2566260c0abbd602d37c03ce81387240885248d"
    },
    {
      "id": "A30120-zh-00018",
      "text": "面试考试",
      "source_hash": "8077a1a3433e850ee7a68a29180d5014d1a1f08e43da0dd73948b3d1e5682985"
    },
    {
      "id": "A30120-zh-00019",
      "text": "报考类别",
      "source_hash": "e4b8e8fc003cecf636141c979ceeab1c6aa6392973c04119eb53ba055c7e6194"
    },
    {
      "id": "A30120-zh-00026",
      "text": "身体及体能",
      "source_hash": "dd63b4eada4d0ab098137fdff2566260c0abbd602d37c03ce81387240885248d"
    },
    {
      "id": "A30120-zh-00027",
      "text": "面试考试",
      "source_hash": "8077a1a3433e850ee7a68a29180d5014d1a1f08e43da0dd73948b3d1e5682985"
    },
    {
      "id": "A30120-zh-00028",
      "text": "合格者",
      "source_hash": "f23c18d2fbb90844de6aa178e06527edb4478bf38bfa28012ff0578ff07da138"
    },
    {
      "id": "A30118-zh-00029",
      "text": "每分钟20次以上",
      "source_hash": "706bf65509f254855095e600a4d14823d5c9b023c5bdec6c6063aef7bee9f536"
    },
    {
      "id": "A30118-zh-00030",
      "text": "每分钟20次以上",
      "source_hash": "706bf65509f254855095e600a4d14823d5c9b023c5bdec6c6063aef7bee9f536"
    },
    {
      "id": "A30120-zh-00020",
      "text": "弃考人数",
      "source_hash": "357d559fb319068f861caa6cb12a0da9b708c000e879f677de07b8b31cde86e3"
    },
    {
      "id": "A30120-zh-00021",
      "text": "体能检查弃考人数",
      "source_hash": "f51ebf5abd869afc4a7f8ca94039a9a359c5d1c6eaba91315bfeefc36670ae2b"
    },
    {
      "id": "A30120-zh-00022",
      "text": "弃考人数",
      "source_hash": "357d559fb319068f861caa6cb12a0da9b708c000e879f677de07b8b31cde86e3"
    },
    {
      "id": "A30120-zh-00023",
      "text": "弃考人数",
      "source_hash": "357d559fb319068f861caa6cb12a0da9b708c000e879f677de07b8b31cde86e3"
    },
    {
      "id": "A30120-zh-00029",
      "text": "不合格人数",
      "source_hash": "ed7ddcf9e7e5735190ff8a9805926a2032e7dbf7cdcc3384cc470583c9b2bca3"
    },
    {
      "id": "A30120-zh-00031",
      "text": "不合格人数",
      "source_hash": "ed7ddcf9e7e5735190ff8a9805926a2032e7dbf7cdcc3384cc470583c9b2bca3"
    },
    {
      "id": "A30120-zh-00032",
      "text": "不合格人数",
      "source_hash": "ed7ddcf9e7e5735190ff8a9805926a2032e7dbf7cdcc3384cc470583c9b2bca3"
    },
    {
      "id": "A30120-zh-00033",
      "text": "不合格人数",
      "source_hash": "ed7ddcf9e7e5735190ff8a9805926a2032e7dbf7cdcc3384cc470583c9b2bca3"
    },
    {
      "id": "A30120-zh-00052",
      "text": "2. “能力倾向测验”、“体格及体能检查”和“最终结果”栏应填写“弃考”、“不合格”或“合格”。",
      "source_hash": "a5bdea02a93afd260df5a23e823b4694fd33c015877cbfc1a8b97d960d7b15ce"
    },
    {
      "id": "A30120-zh-00053",
      "text": "3. 在“笔试”和“面试”栏中，填写“弃考”或各科成绩（实践考试仅填写总分）。",
      "source_hash": "47938b524032b102dd1d77520a09c8ef54de78fcd791604bd988a4d6969ff498"
    }
  ],
