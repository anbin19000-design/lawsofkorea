  "edits": [
    {
      "id": "A35094-zh-00001",
      "text": "■《幼儿教育法》[附表2] <2026年5月19日修订>"
    },
    {
      "id": "A35094-zh-00002",
      "text": "教师资格标准（与第二十二条第二款有关）"
    },
    {
      "id": "A35094-zh-00003",
      "text": "资格"
    },
    {
      "id": "A35094-zh-00004",
      "text": "资格标准"
    },
    {
      "id": "A35094-zh-00005",
      "text": "等级"
    },
    {
      "id": "A35094-zh-00006",
      "text": "正式教师"
    },
    {
      "id": "A35094-zh-00007",
      "text": "1. 持有幼儿园正式教师（二级）资格证书并具有三年以上教育经历者"
    },
    {
      "id": "A35094-zh-00008",
      "text": "（一级）"
    },
    {
      "id": "A35094-zh-00009",
      "text": "且接受规定的再教育者"
    },
    {
      "id": "A35094-zh-00010",
      "text": "2. 持有幼儿园正式教师（二级）资格证书，在教育研究生院或教育部长指定"
    },
    {
      "id": "A35094-zh-00011",
      "text": "的研究生院教育系主修幼儿园教育课程"
    },
    {
      "id": "A35094-zh-00012",
      "text": "取得硕士学位并具有一年以上教育经历者"
    },
    {
      "id": "A35094-zh-00013",
      "text": "正式教师"
    },
    {
      "id": "A35094-zh-00014",
      "text": "1. 大学幼儿教育系毕业者"
    },
    {
      "id": "A35094-zh-00015",
      "text": "（二级）"
    },
    {
      "id": "A35094-zh-00016",
      "text": "2. 大学（包括专科大学及同等以上各类学校和依《终身教育法》"
    },
    {
      "id": "A35094-zh-00017",
      "text": "第三十一条第四款认可专科大学学历的终身教育设施）"
    },
    {
      "id": "A35094-zh-00018",
      "text": "毕业、在学期间取得规定保育及教师教育学分者"
    },
    {
      "id": "A35094-zh-00019",
      "text": "3. 教育研究生院或教育部长指定的研究生院教育系"
    },
    {
      "id": "A35094-zh-00020",
      "text": "主修幼儿园教育课程并取得硕士学位者"
    },
    {
      "id": "A35094-zh-00021",
      "text": "4. 持有幼儿园准教师资格证书并具有两年以上教育经历"
    },
    {
      "id": "A35094-zh-00022",
      "text": "且接受规定的再教育者"
    },
    {
      "id": "A35094-zh-00023",
      "text": "准教师"
    },
    {
      "id": "A35094-zh-00024",
      "text": "1. 通过幼儿园准教师资格审查者"
    },
    {
      "id": "A35094-zh-00025",
      "text": "保健教师"
    },
    {
      "id": "A35094-zh-00026",
      "text": "1. 持有保健教师（二级）资格证书并具有三年以上保健教师"
    },
    {
      "id": "A35094-zh-00027",
      "text": "（一级）"
    },
    {
      "id": "A35094-zh-00028",
      "text": "工作经历且完成资格进修者"
    },
    {
      "id": "A35094-zh-00029",
      "text": "保健教师"
    },
    {
      "id": "A35094-zh-00030",
      "text": "1. 大学或产业大学护理系毕业并于在学期间取得规定"
    },
    {
      "id": "A35094-zh-00031",
      "text": "（二级）"
    },
    {
      "id": "A35094-zh-00032",
      "text": "教师教育学分且持有护士执照者"
    },
    {
      "id": "A35094-zh-00033",
      "text": "2. 专科大学护理系毕业并于在学期间取得规定教师教育"
    },
    {
      "id": "A35094-zh-00034",
      "text": "学分且持有护士执照者"
    },
    {
      "id": "A35094-zh-00035",
      "text": "营养教师"
    },
    {
      "id": "A35094-zh-00036",
      "text": "1. 持有营养教师（二级）资格证书并具有三年以上营养教师"
    },
    {
      "id": "A35094-zh-00037",
      "text": "（一级）"
    },
    {
      "id": "A35094-zh-00038",
      "text": "工作经历且完成资格进修者"
    },
    {
      "id": "A35094-zh-00039",
      "text": "营养教师"
    },
    {
      "id": "A35094-zh-00040",
      "text": "1. 大学或产业大学食品学或营养学相关专业毕业"
    },
    {
      "id": "A35094-zh-00041",
      "text": "（二级）"
    },
    {
      "id": "A35094-zh-00042",
      "text": "在学期间取得规定教师教育学分并持有营养师执照"
    },
    {
      "id": "A35094-zh-00043",
      "text": "者"
    },
    {
      "id": "A35094-zh-00044",
      "text": "2. 持有营养师执照，且在教育研究生院或教育部长指定"
    },
    {
      "id": "A35094-zh-00045",
      "text": "的研究生院教育系完成营养教育课程并取得硕士学位"
    },
    {
      "id": "A35094-zh-00046",
      "text": "者"
    },
    {
      "id": "A35094-zh-00047",
      "text": "备注"
    },
    {
      "id": "A35094-zh-00048",
      "text": "1. 园长、园监及依《初等及中等教育法》规定的校长、副校长、教育长、"
    },
    {
      "id": "A35094-zh-00049",
      "text": "教育督导官、教育督导员、教育研究官及教育研究员的工作年限"
    },
    {
      "id": "A35094-zh-00050",
      "text": "可视为教育经历年限。"
    },
    {
      "id": "A35094-zh-00051",
      "text": "2. 本表中的专科大学包括原初级大学、专门学校及实业高等专门学校"
    },
    {
      "id": "A35094-zh-00052",
      "text": "。"
    }
  ],
