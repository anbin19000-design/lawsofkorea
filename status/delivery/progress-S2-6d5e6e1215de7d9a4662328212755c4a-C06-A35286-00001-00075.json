  "edits": [
    {
      "id": "A35286-zh-00001",
      "text": "■《幼儿教育法实施令》[附表2] <2026年4月14日修订>"
    },
    {
      "id": "A35286-zh-00002",
      "text": "行政罚款征收标准（与第三十七条有关）"
    },
    {
      "id": "A35286-zh-00003",
      "text": "1. 一般标准"
    },
    {
      "id": "A35286-zh-00004",
      "text": "甲. 依据违法次数加重征收行政罚款的标准，适用于最近一年内因"
    },
    {
      "id": "A35286-zh-00005",
      "text": "相同违法行为已被处以行政罚款的情形。此时期间"
    },
    {
      "id": "A35286-zh-00006",
      "text": "自对违法行为处以行政罚款之日计算至该处罚后再次"
    },
    {
      "id": "A35286-zh-00007",
      "text": "实施相同违法行为被查处之日"
    },
    {
      "id": "A35286-zh-00008",
      "text": "。"
    },
    {
      "id": "A35286-zh-00009",
      "text": "乙. 依甲目加重处罚时，加重处罚的适用次数"
    },
    {
      "id": "A35286-zh-00010",
      "text": "为实施该违法行为前所受处罚的次数（甲目期限内曾受两次以上行政罚款的，"
    },
    {
      "id": "A35286-zh-00011",
      "text": "以较高次数为准）之后的下一次"
    },
    {
      "id": "A35286-zh-00012",
      "text": "。"
    },
    {
      "id": "A35286-zh-00013",
      "text": "丙. 征收机关在以下任一情形下，可将第二项"
    },
    {
      "id": "A35286-zh-00014",
      "text": "行政罚款金额减少至多二分之一；但"
    },
    {
      "id": "A35286-zh-00015",
      "text": "对拖欠行政罚款者不适用。"
    },
    {
      "id": "A35286-zh-00016",
      "text": "1）违法者符合《秩序违反行为规制法实施令》第二条之二第一款"
    },
    {
      "id": "A35286-zh-00017",
      "text": "各项任一规定者"
    },
    {
      "id": "A35286-zh-00018",
      "text": "2）违法者已纠正或消除违法行为造成的后果"
    },
    {
      "id": "A35286-zh-00019",
      "text": "3）认定违法系轻微疏忽、错误等过失所致的"
    },
    {
      "id": "A35286-zh-00020",
      "text": "情形"
    },
    {
      "id": "A35286-zh-00021",
      "text": "4）考虑违法程度、动机及其后果等，认定有必要减轻金额的"
    },
    {
      "id": "A35286-zh-00022",
      "text": "情形"
    },
    {
      "id": "A35286-zh-00023",
      "text": "丁. 征收机关在以下任一情形下，可将第二项"
    },
    {
      "id": "A35286-zh-00024",
      "text": "行政罚款金额增加至多二分之一；但"
    },
    {
      "id": "A35286-zh-00025",
      "text": "即使存在多个加重理由，也不得超过本法第三十五条第一款"
    },
    {
      "id": "A35286-zh-00026",
      "text": "规定的最高罚款额。"
    },
    {
      "id": "A35286-zh-00027",
      "text": "1）通知被处罚人违法状态后超过一个月"
    },
    {
      "id": "A35286-zh-00028",
      "text": "仍未纠正违法行为的情形"
    },
    {
      "id": "A35286-zh-00029",
      "text": "2）违法内容、程度重大，认定给幼儿或监护人等造成"
    },
    {
      "id": "A35286-zh-00030",
      "text": "较大损害的情形"
    },
    {
      "id": "A35286-zh-00031",
      "text": "2. 个别标准"
    },
    {
      "id": "A35286-zh-00032",
      "text": "违法行为"
    },
    {
      "id": "A35286-zh-00033",
      "text": "依据法条"
    },
    {
      "id": "A35286-zh-00034",
      "text": "行政罚款金额（万韩元）"
    },
    {
      "id": "A35286-zh-00035",
      "text": "第一次违反"
    },
    {
      "id": "A35286-zh-00036",
      "text": "第二次违反"
    },
    {
      "id": "A35286-zh-00037",
      "text": "第三次及以上违反"
    },
    {
      "id": "A35286-zh-00038",
      "text": "甲. 违反本法第二十八条之二"
    },
    {
      "id": "A35286-zh-00039",
      "text": "本法第三十五条"
    },
    {
      "id": "A35286-zh-00040",
      "text": "300"
    },
    {
      "id": "A35286-zh-00041",
      "text": "400"
    },
    {
      "id": "A35286-zh-00042",
      "text": "500"
    },
    {
      "id": "A35286-zh-00043",
      "text": "，"
    },
    {
      "id": "A35286-zh-00044",
      "text": "使用幼儿园或与其"
    },
    {
      "id": "A35286-zh-00045",
      "text": "类似名称的"
    },
    {
      "id": "A35286-zh-00046",
      "text": "情形"
    },
    {
      "id": "A35286-zh-00048",
      "text": "乙. 删除。<2021年"
    },
    {
      "id": "A35286-zh-00049",
      "text": "7月13日>"
    },
    {
      "id": "A35286-zh-00050",
      "text": "丙. 未依本法第十七条第一款"
    },
    {
      "id": "A35286-zh-00051",
      "text": "本法第三十五条"
    },
    {
      "id": "A35286-zh-00052",
      "text": "100"
    },
    {
      "id": "A35286-zh-00053",
      "text": "200"
    },
    {
      "id": "A35286-zh-00054",
      "text": "300"
    },
    {
      "id": "A35286-zh-00055",
      "text": "规定实施健康"
    },
    {
      "id": "A35286-zh-00056",
      "text": "第二款"
    },
    {
      "id": "A35286-zh-00057",
      "text": "检查的情形。但"
    },
    {
      "id": "A35286-zh-00058",
      "text": "幼儿园园长"
    },
    {
      "id": "A35286-zh-00059",
      "text": "已向幼儿的"
    },
    {
      "id": "A35286-zh-00060",
      "text": "监护人就幼儿健康检查"
    },
    {
      "id": "A35286-zh-00061",
      "text": "作出三次以上"
    },
    {
      "id": "A35286-zh-00062",
      "text": "通知（包括要求提交健康"
    },
    {
      "id": "A35286-zh-00063",
      "text": "检查结果通知书）"
    },
    {
      "id": "A35286-zh-00064",
      "text": "的，不在此限"
    },
    {
      "id": "A35286-zh-00065",
      "text": "。"
    },
    {
      "id": "A35286-zh-00067",
      "text": "丁. 未履行本法第十七条之三"
    },
    {
      "id": "A35286-zh-00068",
      "text": "本法第三十五条"
    },
    {
      "id": "A35286-zh-00069",
      "text": "100"
    },
