    {
      "id": "A26702-zh-00006",
      "source_hash": "d863b15e68dfb5c3c785619bb7562fd6bf8808be374e0a0cf325b9dd9ea4e4db",
      "text": "2. 所在地："
    },
    {
      "id": "A26702-zh-00008",
      "source_hash": "e86ce0080eb241ce6b6ead9bfc4ff2207d82e7d50d96ca2715aeae1ddcd5d835",
      "text": "3. 入住定员："
    },
    {
      "id": "A26702-zh-00009",
      "source_hash": "9f96b8e22cc06bfafc548ef472e33b60548b190f17dbc04b1da176a50d2c6d2c",
      "text": "人"
    },
    {
      "id": "A26702-zh-00010",
      "source_hash": "45b3406d840b631f502e6b6b8283d6ca62a2472b7bb96f01afd9de971b99718d",
      "text": "4. 运营法人名称："
    },
