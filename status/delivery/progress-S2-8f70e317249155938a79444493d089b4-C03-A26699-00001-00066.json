    },
    {
      "id": "A26699-zh-00020",
      "source_hash": "49fcc0b198e50d110d33bf7a2810aab92c0dbe182ff1c1579d86ad450f86cd64",
      "text": "诊疗科目"
    },
    {
      "id": "A26699-zh-00021",
      "source_hash": "72b8cbdf8773c47da3a176b9b498628926cfa0c402aed0d7f44c589042914e47",
      "text": "工作人员"
    },
    {
      "id": "A26699-zh-00022",
      "source_hash": "5a849f1fc9d520fe3fc6c5527b3ed46b776b38a878724fb77858177cfaac612c",
      "text": "共计"
    },
    {
      "id": "A26699-zh-00023",
      "source_hash": "7643fa9d8233b8cda097a5d349bcd68c6e77ecef7b56b7d3dfda9b28bc533886",
      "text": "人（医生"
    },
    {
      "id": "A26699-zh-00024",
      "source_hash": "4b580fd4da7e34ac88eed3ee81f23ee37af229b7dbefb8dc086c61a1ebea07c6",
      "text": "人，护士"
    },
    {
      "id": "A26699-zh-00025",
      "source_hash": "83d6e245e6e7e718103bd493e41c90ea4bed24ba47e82f7ad69f95b29b004ca7",
      "text": "人，其他人员"
    },
    {
      "id": "A26699-zh-00026",
      "source_hash": "1201d4e0ce1cdea263a1949e6adbdd6a7726dae6ebf7f8ef10986a5482c3c0d6",
