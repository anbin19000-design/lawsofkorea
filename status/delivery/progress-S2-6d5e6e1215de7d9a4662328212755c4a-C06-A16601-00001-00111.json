    },
    {
      "id": "A16601-zh-00045",
      "text": "依《幼儿教育法实施令》第九条第一款及该法实施规则第二条第一款，现申请幼儿园设立认可，"
    },
    {
      "id": "A16601-zh-00046",
      "text": "内容如上。"
    },
    {
      "id": "A16601-zh-00052",
      "text": "受理机构负责人"
    },
    {
      "id": "A16601-zh-00053",
      "text": "敬启"
    },
    {
      "id": "A16601-zh-00055",
      "text": "（背面）"
    },
    {
      "id": "A16601-zh-00056",
      "text": "提交文件"
    },
    {
      "id": "A16601-zh-00057",
      "text": "1. 幼儿园规章1份"
    },
    {
      "id": "A16601-zh-00058",
      "text": "手续费"
    },
    {
      "id": "A16601-zh-00059",
      "text": "2. 校地及实习用地地籍图1份"
    },
    {
      "id": "A16601-zh-00060",
      "text": "3. 校舍（包括体育场）平面图1份"
    },
    {
      "id": "A16601-zh-00061",
      "text": "无"
    },
    {
      "id": "A16601-zh-00062",
      "text": "4. 设立人为法人时，登记及出资相关文件1份"
    },
    {
      "id": "A16601-zh-00063",
      "text": "5. 设立人为私人时，证明费用支付及偿还能力的文件1份"
    },
    {
      "id": "A16601-zh-00064",
      "text": "6. 对拟任命为有关幼儿园园长的人，"
    },
    {
      "id": "A16601-zh-00065",
      "text": "甲. 资格证明文件1份"
    },
    {
      "id": "A16601-zh-00066",
      "text": "乙. 性犯罪经历查询同意书1份"
    },
    {
      "id": "A16601-zh-00067",
      "text": "丙. 身份情况陈述书1份"
    },
    {
      "id": "A16601-zh-00068",
      "text": "7. 设施与设备相关文件"
    },
    {
      "id": "A16601-zh-00069",
      "text": "8. 获认可后拟补充设施的年度补充计划1份（仅符合《高中以下各级学校设立及运营规定"
    },
    {
      "id": "A16601-zh-00070",
      "text": "实施规则》第四条第一款正文者提交）"
    },
    {
      "id": "A16601-zh-00071",
      "text": "9. 年度教育设施及设备确保计划的履行情况报告书1份（仅符合《高中以下各级学校"
    },
    {
      "id": "A16601-zh-00072",
      "text": "设立及运营规定实施规则》第四条第一款正文者提交）"
    },
    {
      "id": "A16601-zh-00073",
      "text": "10. 法人章程及有关理事会会议记录副本各1份（仅符合《高中以下各级学校设立及运营"
    },
    {
      "id": "A16601-zh-00074",
      "text": "规定》第十五条第二款但书的法人提交）"
    },
    {
      "id": "A16601-zh-00075",
      "text": "11. 拟设立幼儿园者为私人时，依《国民健康保险法》第五十二条的健康检查"
    },
    {
      "id": "A16601-zh-00076",
      "text": "结果通知书、医生诊断书等可确认是否属于《幼儿教育法》第八条之二第二项及第三项"
    },
    {
      "id": "A16601-zh-00077",
      "text": "规定的不合格事由的文件1份"
    },
    {
      "id": "A16601-zh-00078",
      "text": "负责公务员"
    },
    {
      "id": "A16601-zh-00079",
      "text": "1. 校地及实习用地的地籍图、土地登记簿及土地登记事项证明书"
    },
    {
      "id": "A16601-zh-00080",
      "text": "核实事项"
    },
    {
      "id": "A16601-zh-00081",
      "text": "2. 校舍建筑物登记簿（一般／集合）及建筑登记事项证明书"
    },
    {
      "id": "A16601-zh-00082",
      "text": "3. 设立、经营者为法人：法人登记事项证明书"
    },
    {
      "id": "A16601-zh-00083",
      "text": "4. 设立、经营者为私人：居民登记簿摘录（可用身份证核实的，"
    },
    {
      "id": "A16601-zh-00084",
      "text": "出示身份证即可）"
    },
    {
      "id": "A16601-zh-00085",
      "text": "5. 依《电气安全管理法实施规则》第十八条签发的电气安全检查确认书"
    },
    {
      "id": "A16601-zh-00086",
      "text": "行政信息共同利用同意书"
    },
    {
      "id": "A16601-zh-00087",
      "text": "本人同意公务员依《电子政府法》第三十六条第一款以行政信息共同利用方式"
    },
    {
      "id": "A16601-zh-00088",
      "text": "核实上述第3、4、5项。"
    },
    {
      "id": "A16601-zh-00089",
      "text": "※ 不同意公务员核实或无法依《电子政府法》第三十六条第一款通过行政信息共同利用"
    },
    {
      "id": "A16601-zh-00090",
      "text": "核实的，应由申请人自行提交有关文件。"
    },
    {
      "id": "A16601-zh-00093",
      "text": "填写方法"
    },
    {
      "id": "A16601-zh-00094",
      "text": "不得填写灰色栏（受理编号、受理日期）。"
    },
    {
      "id": "A16601-zh-00095",
      "text": "○ 关于申请人提交的文件："
    },
    {
      "id": "A16601-zh-00096",
      "text": "－身份情况陈述书（简式）采用《保安业务规定实施规则》附表格式第21号。"
    },
    {
      "id": "A16601-zh-00097",
      "text": "－性犯罪经历查询同意书采用《儿童、青少年性保护法实施规则》附表格式第10号。"
    },
    {
      "id": "A16601-zh-00098",
      "text": "－第4、5及7至9项文件格式可能因受理机构而异，应提前咨询"
    },
    {
      "id": "A16601-zh-00099",
      "text": "有关受理机构。"
    },
    {
      "id": "A16601-zh-00100",
      "text": "○ 申请人经设立人委托的，"
    },
    {
      "id": "A16601-zh-00101",
      "text": "须出示受托人及委托人的身份证明文件（居民身份证、驾驶执照、护照等）。"
    },
    {
      "id": "A16601-zh-00102",
      "text": "办理程序"
    },
    {
      "id": "A16601-zh-00103",
      "text": "受理"
    },
    {
      "id": "A16601-zh-00104",
      "text": "办理"
    },
    {
      "id": "A16601-zh-00105",
      "text": "通知"
    },
    {
      "id": "A16601-zh-00106",
      "text": "（认可与否等）"
    },
    {
      "id": "A16601-zh-00108",
      "text": "受理机构"
    },
    {
      "id": "A16601-zh-00109",
      "text": "移送"
    },
    {
      "id": "A16601-zh-00110",
      "text": "办理机构（部门）"
    },
    {
      "id": "A16601-zh-00111",
      "text": "※ 可依受理机构情况适当调整"
    }
