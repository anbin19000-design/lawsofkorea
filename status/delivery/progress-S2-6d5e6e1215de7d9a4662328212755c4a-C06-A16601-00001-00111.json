  "edits": [
    {
      "id": "A16601-zh-00001",
      "text": "■《幼儿教育法实施规则》[附表格式第1号] <2022年12月1日修订>"
    },
    {
      "id": "A16601-zh-00002",
      "text": "学校设立认可申请书"
    },
    {
      "id": "A16601-zh-00003",
      "text": "※ 请参阅背面填写方法，申请人不得填写深色栏。"
    },
    {
