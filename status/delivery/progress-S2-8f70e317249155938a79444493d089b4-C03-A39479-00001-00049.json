  "checked_rows": 49,
  "corrected_rows": 47,
  "source_ko_blob_sha": "cf045f80edc2f938db0d4fe8220fd7d22754c72b",
  "source_zh_blob_sha": "6aba81b8dd9749b92f915ab8a9faf4b1d2cd399c",
  "edits": [
    {
      "id": "A39479-zh-00001",
      "source_hash": "cc69881e849a916217f10e8126b91bbea2f191b283ea12a8fe680673d839b028",
      "text": "■ 《防止人口贩运等及保护受害者等法施行令》〔附表六〕"
    },
    {
      "id": "A39479-zh-00003",
      "source_hash": "a617cf3ccc65ba6af0228b05b78c02b61364dbd74e669da8ea55dab0e5a320b6",
      "text": "1. 一般标准"
    },
    {
      "id": "A39479-zh-00004",
      "source_hash": "7ac7ffb007933777d2a6f3c82b350b4e248f0a52470bb6500c70c0c7fdfcd6ab",
      "text": "甲. 按违法次数加重行政罚款的标准，适用于最近三年内因相同违法"
    },
    {
      "id": "A39479-zh-00005",
      "source_hash": "231d79f07f8eb08c2a5a982f812e7f6abc2df1f47d7ee622f3b85a14dac4e471",
      "text": "行为曾受到行政罚款处分的情形。此时，期间的计算以"
    },
    {
      "id": "A39479-zh-00006",
      "source_hash": "b4a88c8bbc3894481bd77300ab4021f0c997fd64e5345f04783d417d2772baa6",
      "text": "受到该违法行为行政罚款处分之日及处分后再次实施相同违法行为"
    },
    {
      "id": "A39479-zh-00007",
      "source_hash": "8124c54590e8d32b809acc109df8750a4cbce3daccee548b10f245584ce305d5",
      "text": "而被查获之日为准。"
    },
    {
      "id": "A39479-zh-00008",
      "source_hash": "5e774f299a1c9f4bdf53d1003d4882c1a654a5dee2483746a282b7e4484a1d9e",
      "text": "乙. 依据甲目加重罚款时，加重处罚适用的次数应为该违法"
    },
    {
      "id": "A39479-zh-00009",
      "source_hash": "e94d6ecbd26d16f63fd0550bd73ad894798b37e4f24ba9fed29dbf438aa4983f",
      "text": "行为以前的处罚次数（甲目规定期间内有两次以上罚款处分时，"
    },
    {
      "id": "A39479-zh-00010",
      "source_hash": "3a1004e8ef673dc82c59b8deff719e4bf3a48af05a231e160d618998d658bad0",
      "text": "以较高的次数为准）的下一次数。"
    },
    {
      "id": "A39479-zh-00011",
      "source_hash": "9695929cff463f12817f635b9e107bda25132d6c503adbb851790358a862a49e",
      "text": "丙. 处罚机关在下列任一情形下，可以按照第二项的个别标准"
    },
    {
      "id": "A39479-zh-00012",
      "source_hash": "37f3728de65d586f269bf817f1b1e6e85a98f45f0a9dab78b358216a56143393",
      "text": "在罚款金额二分之一的范围内减轻罚款。但"
    },
    {
      "id": "A39479-zh-00013",
      "source_hash": "756b00d5e9ee937bf6feb95e06e9b4dd86e445f66f57362db703901c90278b88",
      "text": "对拖欠行政罚款的违法者不适用。"
    },
    {
      "id": "A39479-zh-00014",
      "source_hash": "474a13a9236c94201152c9a16b464c60368d3b640e1a7bd22636a8b368190f95",
      "text": "1）违法行为系因轻微疏忽或者错误造成的。"
    },
    {
      "id": "A39479-zh-00015",
      "source_hash": "e1d7f15fdf919f32a67dbaac7d011776fbb9ab8f1b292c81f53c64ae916d3ebc",
      "text": "2）违法行为内容及程度轻微，造成的损害较小的。"
    },
    {
      "id": "A39479-zh-00016",
      "source_hash": "8a94056faeee08bc3a4b70461e1836e118d973a2bd1fd6f8f450dac77d3b3423",
      "text": "3）认定违法者已努力纠正或者消除违法状态的"
    },
    {
      "id": "A39479-zh-00017",
      "source_hash": "e366814d4287af1b8b841620197dcac3e19e622ef692112ed2a40a1de031b809",
      "text": "情形。"
    },
    {
      "id": "A39479-zh-00018",
      "source_hash": "f9668fcccd0b87646bf78315f4fdabb3b504405ddd98090201eeb2dac016c4f9",
      "text": "4）其他考虑违法行为的程度、动机及结果等，认为有必要减轻行政罚款"
    },
    {
      "id": "A39479-zh-00019",
      "source_hash": "c2c8f22ed0de0e449a6e68ce3031c05ba2b42bd0d46878f1b980e02506b43171",
      "text": "金额的情形。"
    },
    {
      "id": "A39479-zh-00020",
      "source_hash": "1d6f6bce78138ea58d3cc062dbce45c849d57266d25052a404c84318174a0c95",
      "text": "2. 个别标准"
    },
    {
      "id": "A39479-zh-00021",
      "source_hash": "903aa577eae3314c52694d8cb0c32f8a688802c384b7267385dc97b9afdad866",
      "text": "违法行为"
    },
    {
      "id": "A39479-zh-00022",
      "source_hash": "d7794cf130b736a7916042cc14e3a797206fad2daf25ed41a53aacbb091b1bea",
      "text": "依据"
    },
    {
      "id": "A39479-zh-00023",
      "source_hash": "1d2f5cf8953164d7603f6583712130e09b95295a11e6dd7895dd2ea1a4d2f74f",
      "text": "行政罚款金额"
    },
    {
      "id": "A39479-zh-00024",
      "source_hash": "532b0a8da32810e919895f72bdc1ed7b7800d66b47796273db7ab8199922e316",
      "text": "法律条文"
    },
    {
      "id": "A39479-zh-00025",
      "source_hash": "ac189b9e31e9838a8787fe8abff8ba8c3814870d10b0614331e1c1ec6057b415",
      "text": "第一次违法"
    },
    {
      "id": "A39479-zh-00026",
      "source_hash": "314bcec12380f24803e2bfa65febfcfa6fe1a7f86b41c9c618bcf6b34456277c",
      "text": "第二次违法"
    },
    {
      "id": "A39479-zh-00027",
      "source_hash": "2baccbbfd9dcedcd31af769068d619dd28aef5d540f8845cd399bb4fe519a252",
      "text": "第三次及以上违法"
    },
    {
      "id": "A39479-zh-00028",
      "source_hash": "d1db94ed1caa78d78c8e7940991e48b72c4982f0b6566b2467d38a12f21956a0",
      "text": "甲. 无正当理由未依法"
    },
    {
      "id": "A39479-zh-00030",
      "source_hash": "a10537a356d47b6e7f1d9bbc5c523fa81a3ff6d1a274eed00df574c918fe3302",
      "text": "第二十一条第二款"
    },
    {
      "id": "A39479-zh-00031",
      "source_hash": "4a7af30a523264d3c79bc7c1f0927e5343856e210e0ceedc33489805a5fde871",
      "text": "法第五十条第一款"
    },
    {
      "id": "A39479-zh-00032",
      "source_hash": "e902678d690bc0adf1bb0a997013d3b85c4786f185c9633793b20e237730b418",
      "text": "进行举报的情形"
    },
    {
      "id": "A39479-zh-00033",
      "source_hash": "ede351fe5e476d447b630db7ddf3e4cbb0fb0ddb62c9d655b857a650e56b4c61",
      "text": "乙. 对依法第四十五条第一款"
    },
    {
      "id": "A39479-zh-00034",
      "source_hash": "f12d616b4dacb160a8aaab9948a1e124e5dbfc571373dda5f582337bfc886a14",
      "text": "150万韩元"
    },
    {
      "id": "A39479-zh-00035",
      "source_hash": "ec32def14caae856350cdc14244dd3cc180dfc63aee66aad0d0de00b92811a2c",
      "text": "200万韩元"
    },
    {
      "id": "A39479-zh-00036",
      "source_hash": "f3e90a216210195c0d6772a6faae2138079d72ec2fddfb85cc7ae26e3dc05470",
      "text": "300万韩元"
    },
    {
      "id": "A39479-zh-00037",
      "source_hash": "8b6b3190ca78746d8617d307059ea1c41a2139cd6e0383001b2849f45dafb3ae",
      "text": "有关公务员进行的进入、"
    },
    {
      "id": "A39479-zh-00038",
      "source_hash": "aa86bf815935cd602568de8ab94d93e889163a280dca8370588bcc955cd93972",
      "text": "法第五十条第二款"
    },
    {
      "id": "A39479-zh-00039",
      "source_hash": "f79bf6db2cb06e308d3a7b2175a09fc27efbff2efe608d6a34e8a7c98022a9ac",
      "text": "检查予以拒绝、妨碍或者"
    },
    {
      "id": "A39479-zh-00040",
      "source_hash": "57b5987e7319edde8155347fa1f58b08caa454086a07ad01b45a54bceadba267",
      "text": "第一项"
    },
    {
      "id": "A39479-zh-00041",
      "source_hash": "8178f6e95adcf1446076014068d3655dd6c78d266d9d42bfd8b4e2fc91a60adb",
      "text": "规避的情形"
    },
    {
      "id": "A39479-zh-00042",
      "source_hash": "5a4e61ec9a416d9b2d0833f4c10acab0f88c6eb232f3f27f61861c7e749ffdf6",
      "text": "丙. 违反法第四十六条规定的"
    },
    {
      "id": "A39479-zh-00043",
      "source_hash": "f12d616b4dacb160a8aaab9948a1e124e5dbfc571373dda5f582337bfc886a14",
      "text": "150万韩元"
    },
    {
      "id": "A39479-zh-00044",
      "source_hash": "ec32def14caae856350cdc14244dd3cc180dfc63aee66aad0d0de00b92811a2c",
      "text": "200万韩元"
    },
    {
      "id": "A39479-zh-00045",
      "source_hash": "f3e90a216210195c0d6772a6faae2138079d72ec2fddfb85cc7ae26e3dc05470",
      "text": "300万韩元"
    },
    {
      "id": "A39479-zh-00046",
      "source_hash": "a00cc1a32aeeaeef9d016002c0941e5ec7aeb5754efa14a1d846ad21dfb0d551",
      "text": "禁止使用类似名称的义务"
    },
    {
      "id": "A39479-zh-00047",
      "source_hash": "aa86bf815935cd602568de8ab94d93e889163a280dca8370588bcc955cd93972",
      "text": "法第五十条第二款"
    },
    {
      "id": "A39479-zh-00048",
      "source_hash": "df1b02cf1ea37295d5b59ff6b17c7936b62223e956d3adafc789ccd0849b41cf",
      "text": "的情形"
    },
    {
      "id": "A39479-zh-00049",
      "source_hash": "71437aa09522b625a53a3d6fe73cdfdd2b8cc106b48a83fb309fe2fc4612c3cc",
      "text": "第二项"
    }
  ],
