  "edits": [
    {
      "id": "A26701-zh-00001",
      "source_hash": "308b6cf362bb14bdc29b895b9ca424483a17fbe87b73fbd35bbd68680531ce77",
      "text": "■ 《防止人口贩运等及保护受害者等法施行规则》〔附表格式第九号〕"
    },
    {
      "id": "A26701-zh-00002",
      "source_hash": "7c0dbca399d1f81c88b641cc22cc7f65e8c960324c6e4be59b92415d3093cba7",
      "text": "人口贩运等受害者支援设施指定申请书"
    },
    {
      "id": "A26701-zh-00003",
      "source_hash": "a3c1fbd2cef06fcfb82a0b35f78cc2a758ceb09cdc3489c5e3f6552f56ade4dd",
      "text": "※在〔 〕内的相应位置打√。"
    },
    {
      "id": "A26701-zh-00004",
      "source_hash": "b736160e9f7f0d321a2b458369e87ad0a76a9b7c00b4454ad463a28ce8d1d95b",
      "text": "受理编号"
    },
    {
      "id": "A26701-zh-00005",
      "source_hash": "5a4e38a1578eaec376cc5e1ad28f33f019956fc98d46f14b142cad94c5b1d1a5",
      "text": "受理日期和时间"
    },
    {
      "id": "A26701-zh-00006",
      "source_hash": "0b53beb448ea9caab555a2008aafaddf46ce8b8d662609949810cf258b29ccb5",
      "text": "办理日期和时间"
    },
    {
      "id": "A26701-zh-00010",
      "source_hash": "135b2d53c337583773ec05ac31eb1e280c78db754abfe7dcfb462196f269bdae",
      "text": "姓名（代表人）"
    },
    {
      "id": "A26701-zh-00012",
      "source_hash": "9c635dfe3b527939800a75a08c73a174d782945e784ebacca95c2a70eeaab86b",
      "text": "法人名称（法人登记号码）"
    },
    {
      "id": "A26701-zh-00015",
      "source_hash": "d6190fb77a7ff6d9c9ed4b3404454b31c394bfcb69afd9e10bf3affcb9d022f7",
      "text": "设施概况"
    },
    {
      "id": "A26701-zh-00018",
      "source_hash": "ef4403031e6e67eb6ff612ac7f030ff5fcf2e12e2b56fe2fa253adc78b0c68bb",
      "text": "所在地"
    },
    {
      "id": "A26701-zh-00019",
      "source_hash": "e5ac93c257305de93a487c1ced0a64993a58dab1ab2b277227fa514e6d658068",
      "text": "设施负责人姓名"
    },
    {
      "id": "A26701-zh-00021",
      "source_hash": "53b8b3cbc7a11fd0d9ada2d552deea61d684fba25e7a14e707c34d7b8995c410",
      "text": "预计开始运营日期"
    },
    {
      "id": "A26701-zh-00022",
      "source_hash": "53810a3e9123c0cd88342cf17c63376a647c775f5d964ace7d49a76d24c5524e",
      "text": "入住定员（人）"
    },
    {
      "id": "A26701-zh-00023",
      "source_hash": "25b97dd897d354fcec632766e0669bb1c978329964ab3f6a3d2f4c2d83e84403",
      "text": "设施设备"
    },
    {
      "id": "A26701-zh-00025",
      "source_hash": "1534653f3e1368421deef3cfcd121844ee31cc01d31762eb12651ea26c4e4935",
      "text": "㎡（起居室"
    },
    {
      "id": "A26701-zh-00026",
      "source_hash": "906d72552712b06d1341b0c66c3132ade3c3d7e40973d429862221486a2d45f1",
      "text": "㎡、办公室"
    },
    {
      "id": "A26701-zh-00027",
      "source_hash": "fadf1164c123c71418d3063da6a3d0f9e3c470acab749bc4ca1ef07e3b4b3400",
      "text": "㎡、浴室"
    },
    {
      "id": "A26701-zh-00028",
      "source_hash": "6f63aedf231eb1a332b6a3c8132caec378ef5042827b167a3ded50cf9ce83138",
      "text": "㎡、餐厅"
    },
    {
      "id": "A26701-zh-00029",
      "source_hash": "50e5c3c9b2790920894ec2b94733a7f510fa7d543848666e2e62b300ac49a5f3",
      "text": "㎡、其他"
    },
    {
      "id": "A26701-zh-00030",
      "source_hash": "72b8cbdf8773c47da3a176b9b498628926cfa0c402aed0d7f44c589042914e47",
      "text": "工作人员"
    },
    {
      "id": "A26701-zh-00032",
      "source_hash": "c86e732914be7c62cceb494e3334bff973c497d6a57dfb85ac58e02ce47059e9",
      "text": "人（设施负责人"
    },
    {
      "id": "A26701-zh-00033",
      "source_hash": "67bd15f85cc625c8ebca9df4fad70f780ad248bf87a2d1cdaf79ac1d329938d1",
      "text": "人、咨询员"
    },
    {
      "id": "A26701-zh-00034",
      "source_hash": "6990da5251842d48b61cbdad8faa00e6a6696d3e865eae8a96097cbae3aada2a",
      "text": "人、其他"
    },
    {
      "id": "A26701-zh-00035",
      "source_hash": "1201d4e0ce1cdea263a1949e6adbdd6a7726dae6ebf7f8ef10986a5482c3c0d6",
      "text": "人）"
    },
    {
      "id": "A26701-zh-00036",
      "source_hash": "5a13e9a56c2ff2aa24d98c63099030cb462b49dc83fb346bd3f58f0d43143088",
      "text": "依照《防止人口贩运等及保护受害者等法》第三十三条第二款、同法施行令第二十三条第二款及"
    },
    {
      "id": "A26701-zh-00037",
      "source_hash": "966a189828d52453ca2a14433dbc26df1d16d805372d6a57cc4d849471ba3979",
      "text": "同法施行规则第八条第一款，申请将人口贩运等受害者支援设施指定为（〔 〕"
    },
    {
      "id": "A26701-zh-00038",
      "source_hash": "3527dce0a858c2392f127fa5dcac50cf134b1c6e99b5249a6d4f049aeac4dba4",
      "text": "一般支援设施、〔 〕"
    },
    {
      "id": "A26701-zh-00039",
      "source_hash": "b66dd4fe75b5e7e5ad3df020ca48b5f88cbda4d8be872e1479967028f0cfa8d7",
      "text": "残疾人支援设施、〔 〕"
    },
    {
      "id": "A26701-zh-00040",
      "source_hash": "b637bbe1734ea13729c569b3d328497e22bc0ba065ad2bc03d1ce451d58df588",
      "text": "儿童"
    },
    {
      "id": "A26701-zh-00041",
      "source_hash": "128759e5e2b9e83b530e12676d8a46821ef12b08deb64ba6ba47457e7c2abe70",
      "text": "及青少年支援设施、〔 〕"
    },
    {
      "id": "A26701-zh-00042",
      "source_hash": "923287ef3c15b5e20799d2c01e7508205cab0a81410c85b9c83cd69af67e032b",
      "text": "外国人支援设施、〔 〕"
    },
    {
      "id": "A26701-zh-00043",
      "source_hash": "72f060f15a454594d4203441e2867d4da04a26b3b5be941f3774f43c62d4d28f",
      "text": "自立支援共同生活设施）中的相应类型。"
    },
    {
      "id": "A26701-zh-00049",
      "source_hash": "247bf6dc11bcb23190bea6fe005b4aff2cc34f0f5b579af8fe7e4a003b81c840",
      "text": "特别市长、广域市长、特别自治市长"
    },
    {
      "id": "A26701-zh-00051",
      "source_hash": "22dbca15d2d9b9d7b8068524a957845972874b3f476cbfd058d70ccf9ad74e98",
      "text": "道知事、特别自治道知事"
    },
    {
      "id": "A26701-zh-00052",
      "source_hash": "90c592621154c95a8fb9b73dbe3665fd29f724a4f20758fa586607dc4c70ea07",
      "text": "市长、郡守、区厅长"
    },
    {
      "id": "A26701-zh-00054",
      "source_hash": "7a9f7e9137d1b02b5ee900cfb4bcb118fe3f139955ef989f57a3e8481f0c8a28",
      "text": "1. 法人章程（仅限申请人为法人）"
    },
    {
      "id": "A26701-zh-00055",
      "source_hash": "0313408cdf794fea03a1b1d6758e8ad6cc7c6a9f70b7256de98dafab6a45bf1a",
      "text": "手续费"
    },
    {
      "id": "A26701-zh-00056",
      "source_hash": "9b9f765e005f6811c5e986daa041057cea83f9af6c19ca7d70a7ef3c9ab707c9",
      "text": "申请人提交文件"
    },
    {
      "id": "A26701-zh-00057",
      "source_hash": "096e49fe016e4340d7bb42b47281cea6673c70383767682ddc8f4385c73fe662",
      "text": "2. 租赁合同（仅限租赁不动产）"
    },
    {
      "id": "A26701-zh-00058",
      "source_hash": "72ea3d64ace5bc9414498b815d4305c8867b0942a508179e0657ad60d1274daa",
      "text": "无"
    },
    {
      "id": "A26701-zh-00059",
      "source_hash": "407478cf41576521e993b7f10659d068a191186b1d0e647aec8b863fe3581e99",
      "text": "3. 标示支援设施各结构部分面积的平面图"
    },
    {
      "id": "A26701-zh-00060",
      "source_hash": "b22e4d3e8f2818c2f914f3bb0a944293d7c58df11d8f1936c3330765339ba3b0",
      "text": "4. 证明支援设施负责人资格的文件"
    },
    {
      "id": "A26701-zh-00061",
      "source_hash": "aaca37e4a37deb7d59629d336a69c37050ed562c990b8680b474ee60429d37e2",
      "text": "5. 支援设施工作人员名单及其资格证明文件"
    },
    {
      "id": "A26701-zh-00062",
      "source_hash": "5df9740b236dafbc177ad3b378aa444fd8dc4efe290b45770ef2327d0e24385c",
      "text": "6. 支援设施运营计划及收支预算书"
    },
    {
      "id": "A26701-zh-00063",
      "source_hash": "b827c74bf8d6e87420e0f5fbb59551e36f9d2f125502ccc70f9f11139bd8294d",
      "text": "经办公务员"
    },
    {
      "id": "A26701-zh-00064",
      "source_hash": "4236e13cff2fc275a6feae03a45c519bc07957a3eb60d3fa0f341e0a33dbcdba",
      "text": "申请人无需提交的文件"
    },
    {
      "id": "A26701-zh-00065",
      "source_hash": "3486a6087d87e50bcf758506b6bccde6b51fbf7497a643d5b3e1badc2149d5ff",
      "text": "法人登记事项证明书（仅限申请人为法人）"
    },
    {
      "id": "A26701-zh-00066",
      "source_hash": "1a5be3c5938c8c2cedf096bb1485ce5f53335572edc7c3dbbf132e7bf9927045",
      "text": "核实事项"
    },
    {
      "id": "A26701-zh-00067",
      "source_hash": "cfcfac7cdbc4a8edcd84a4eb4e42cedbd6fb2deb8c4b267fa7d0b4c0b3c14306",
      "text": "、建筑物登记事项证明书、土地登记事项证明书"
    },
    {
      "id": "A26701-zh-00068",
      "source_hash": "95feaec4b7c659e23eed05f185f0235114aaabc2fdbaf32a827a4f01ee9addf2",
      "text": "及建筑物台账"
    },
    {
      "id": "A26701-zh-00069",
      "source_hash": "d783b555c92130e621ca7c660ddd7d2d06ead305d3c1b9eec9e388600dd300aa",
      "text": "申请人不同意核实时须自行提交的文件"
    },
    {
      "id": "A26701-zh-00070",
      "source_hash": "d6333795ae9cf9160801f8a77c4b781b0d80002fe506471b4e3f88f83479bd90",
      "text": "营业者登记证、国家技术资格证（仅在需要资格证时）"
    },
    {
      "id": "A26701-zh-00071",
      "source_hash": "d8e5229a3f6ca53573d3964a984afe1ac4fb444f74e51cf31361890ba177c373",
      "text": "不同意核实时"
    },
    {
      "id": "A26701-zh-00072",
      "source_hash": "4baca921dfdc66e9b39fe6f3b3f2265b183ca2b8aadaaec6171ac27845d02255",
      "text": "须自行提交"
    },
    {
      "id": "A26701-zh-00073",
      "source_hash": "7a75dfb4f98958b7a32c3f19046d3b04a2959a4b408c360771276c41f7f9e542",
      "text": "行政信息共同利用同意书"
    },
    {
      "id": "A26701-zh-00074",
      "source_hash": "c9b10df2527127ea18b556946c54ecd34af4184b48195d70f5331c986474353a",
      "text": "本人同意经办公务员为办理本申请，依《电子政府法》第三十六条第一款，通过行政信息共同利用机制"
    },
    {
      "id": "A26701-zh-00075",
      "source_hash": "8039545810c56c1326e547bcc99867fb23d8932f3a5c8679eb13a813dd61ea19",
      "text": "核实上述经办公务员核实事项。* 如不同意，申请人须自行提交相关文件。"
    },
    {
      "id": "A26701-zh-00078",
      "source_hash": "2879222415672d201abfe3e634d8339e67e1459aae97a4f34b023760aaf0d94f",
      "text": "办理流程"
    },
    {
      "id": "A26701-zh-00079",
      "source_hash": "d756749ae151055bb3f2fb59a27fb00c3964fefb2a90809570b03e8c0189e1ab",
      "text": "申请书"
    },
    {
      "id": "A26701-zh-00080",
      "source_hash": "d995d6ab415d91d191bafde064de400b1e66d82532d91ec0cc02d72258ce5cda",
      "text": "受理"
    },
    {
      "id": "A26701-zh-00083",
      "source_hash": "021c5aafa7889683ed9497da4156ab07cee0df64a71291bb9942398856e3b8d1",
      "text": "制作指定书"
    },
    {
      "id": "A26701-zh-00084",
      "source_hash": "fc0aec8efc9cf7434964f86433311e24f2998ef6e36c7e3904222fa29065b276",
      "text": "签发"
    },
    {
      "id": "A26701-zh-00085",
      "source_hash": "4f961469c457130737f277d3bf7109e25b7b49eeb89e618f98200b9f308ad3d3",
      "text": "填写"
    },
    {
      "id": "A26701-zh-00087",
      "source_hash": "9396c10d93302dbba9312782ff942498dad6175d8204a0d88924939ea947eee9",
      "text": "市、道"
    },
    {
      "id": "A26701-zh-00088",
      "source_hash": "9396c10d93302dbba9312782ff942498dad6175d8204a0d88924939ea947eee9",
      "text": "市、道"
    },
    {
      "id": "A26701-zh-00089",
      "source_hash": "9396c10d93302dbba9312782ff942498dad6175d8204a0d88924939ea947eee9",
      "text": "市、道"
    },
    {
      "id": "A26701-zh-00090",
      "source_hash": "9396c10d93302dbba9312782ff942498dad6175d8204a0d88924939ea947eee9",
      "text": "市、道"
    },
    {
      "id": "A26701-zh-00091",
      "source_hash": "0248793fbf588e5a70331f74a4b2fb1b4b3b963a155976d13c5a8dbcc1200eab",
      "text": "市、郡、区"
    },
    {
      "id": "A26701-zh-00092",
      "source_hash": "0248793fbf588e5a70331f74a4b2fb1b4b3b963a155976d13c5a8dbcc1200eab",
      "text": "市、郡、区"
    },
    {
      "id": "A26701-zh-00093",
      "source_hash": "0248793fbf588e5a70331f74a4b2fb1b4b3b963a155976d13c5a8dbcc1200eab",
      "text": "市、郡、区"
    },
    {
      "id": "A26701-zh-00094",
      "source_hash": "0248793fbf588e5a70331f74a4b2fb1b4b3b963a155976d13c5a8dbcc1200eab",
      "text": "市、郡、区"
    }
  ],
  "note": "Compared Korean support-facility designation application 95 XML form rows. Fixed facility purpose, type choices, occupancy capacity and personnel, enclosures and official checks, MTQ corruption row 66, consent and administration workflow. Previously reviewed processing-period row 7 excluded. Number, area and date values preserved."
