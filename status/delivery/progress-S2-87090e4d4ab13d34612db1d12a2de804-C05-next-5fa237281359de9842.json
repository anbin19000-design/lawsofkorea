  "edits": [
    {
      "id": "B2-zh-00064",
      "text": "附则（《女性家族部及其所属机关组织规定》）<第24446号，2013年3月23日>\n\n"
    },
    {
      "id": "B2-zh-00067",
      "text": "第三条（其他法令的修订）①至⑪省略。\n\n  ⑫《单亲家庭支援法施行令》部分修订如下。\n\n  将第十三条第二款第一项甲目中的“教育科学技术部部长”改为“教育部部长”。\n\n"
    },
    {
      "id": "B2-zh-00069",
      "text": "附则（《为确立敏感信息及唯一识别信息处理依据而部分修订〈公共机构运营法施行令〉等法令的总统令》）<第25532号，2014年8月6日>\n\n本令自2014年8月7日起施行。\n\n"
    },
    {
      "id": "B2-zh-00070",
      "text": "附则（《为整顿规制（包括设定规制重新审查期限）而部分修订〈建筑法施行令〉等法令的总统令》）<第25840号，2014年12月9日>\n\n"
    },
    {
      "id": "B2-zh-00073",
      "text": "第十六条（关于修订《单亲家庭支援法施行令》的过渡措施）对本令施行前的违法行为适用行政罚款征收标准时，尽管《单亲家庭支援法施行令》附表2第2项的规定已修订，仍适用原规定。\n\n"
    },
    {
      "id": "B2-zh-00074",
      "text": "附则（《因引入基准中位收入及改革定制型福利给付体系而部分修订〈高等教育法施行令〉等法令的总统令》）<第26683号，2015年11月30日>\n\n"
    },
    {
      "id": "B2-zh-00077",
      "text": "附则（《为设定规制重新审查期限等而部分修订〈加盟事业交易公正化相关法律施行令〉等法令的总统令》）<第27751号，2016年12月30日>\n\n"
    },
    {
      "id": "B2-zh-00082",
      "text": "第二条（关于金融信息等范围的适用例）第十一条第一项的修订规定，自本令施行后依本法第十一条第一款申请福利给付的情形起适用。\n\n"
    },
    {
      "id": "B2-zh-00084",
      "text": "附则（《信用信息利用及保护相关法律施行令》）<第30893号，2020年8月4日>\n\n"
    },
    {
      "id": "B2-zh-00087",
      "text": "第三条（其他法令的修订）①至<63>省略。\n\n  <64>《单亲家庭支援法施行令》部分修订如下。\n\n  将第十四条第一款各项以外部分中的“依《信用信息利用及保护相关法律》第二条第六项规定的信用信息集中机构”改为“依《信用信息利用及保护相关法律》第二十五条第二款第一项规定的综合信用信息集中机构”。\n\n  <65>省略。\n\n"
    },
    {
      "id": "B2-zh-00092",
      "text": "附则（《性别平等家族部及其所属机关组织规定》）<第35806号，2025年10月1日>\n\n"
    }
