  "edits": [
    {
      "id": "A26697-zh-00001",
      "source_hash": "34d3fe9cd4e245fae2190545c29a49a5e6b68fa00965c77e96336c1ab80ea20c",
      "text": "■ 《防止人口贩运等及保护受害者等法施行规则》〔附表格式第五号〕"
    },
    {
      "id": "A26697-zh-00002",
      "source_hash": "b6ef554c92c1ee06c5c51142ea35929d24f513f49937876ea1d846a0a7057648",
      "text": "（正面）"
    },
    {
      "id": "A26697-zh-00003",
      "source_hash": "6bd97999072b232d8cd94cf86fda36720720ed6feb04f549921a9efc668ded2d",
      "text": "地方人口贩运等"
    },
    {
      "id": "A26697-zh-00004",
      "source_hash": "dcb0f88e206ca6862c383a82cc60d52ff722f8a7fea981b163d06337f9ad9e79",
      "text": "受害者权益保护机构"
    },
    {
      "id": "A26697-zh-00005",
      "source_hash": "ee9cc0ea56e9d3c42dcae8fcba35283522deb53a2f6aca8ad4593c3c24c0ff2d",
      "text": "工作人员证"
    },
    {
      "id": "A26697-zh-00006",
      "source_hash": "2e63f5b827c348476bf272ad172a40696b961d7bc8e083949baedbeb248dd08c",
      "text": "（地区—流水号）"
    },
    {
      "id": "A26697-zh-00010",
      "source_hash": "b06910591c25b83bd1faecbca816a220f87bd03d53fd906b4b395e399d89fb3d",
      "text": "（脱帽上半身照片，"
    },
    {
      "id": "A26697-zh-00011",
      "source_hash": "4d7ef3d2d63daa91a72dc501444b2de041833071f9fd728fd9b61e8123781f26",
      "text": "无背景且于最近六个月内"
    },
    {
      "id": "A26697-zh-00012",
      "source_hash": "7bcde218c376a3a7561a149b7128a62a3870597a7461fbae6fd085dc1a05c0db",
      "text": "拍摄）"
    },
    {
      "id": "A26697-zh-00013",
      "source_hash": "9f96b8e22cc06bfafc548ef472e33b60548b190f17dbc04b1da176a50d2c6d2c",
      "text": "姓名"
    },
    {
      "id": "A26697-zh-00014",
      "source_hash": "d0d4846e2f55d14b2788851adaa78876764396683276302525dc01d3ac7f6ecc",
      "text": "特别市长、广域市长、道知事"
    },
    {
      "id": "A26697-zh-00015",
      "source_hash": "6ce6163f2531180bf1303c3b6b19d6d7df589a187c26fb1b9479f5e52810f3b6",
      "text": "特别自治市长、特别自治道知事"
    },
    {
      "id": "A26697-zh-00016",
      "source_hash": "ec17887e7e81fe5671c49ad009e284a0c773e4367b8839689d1adfca6bf7e8f9",
      "text": "70毫米×100毫米（肯特纸180克/平方米）"
    },
    {
      "id": "A26697-zh-00017",
      "source_hash": "d6d87e05c543e71cabaccf3ed61804e7e814d1a465e94f4fdc59f331ba61f822",
      "text": "（背面）"
    },
    {
      "id": "A26697-zh-00018",
      "source_hash": "8c57fafb0573bcf5d4c3c3c8fe9cf393c03159f4d399668c98e2647a9c26c956",
      "text": "所属"
    },
    {
      "id": "A26697-zh-00019",
      "source_hash": "acf07872b4df353f19ed5878de48f13dbf164021f225b97f3bb868a41f0f94ae",
      "text": "机构："
    },
    {
      "id": "A26697-zh-00020",
      "source_hash": "64d51be8700bbdf2df4b18e1c3eddcbed9e0087e2c280c4e2f518630ea16fabc",
      "text": "职务（职级）："
    },
    {
      "id": "A26697-zh-00021",
      "source_hash": "bb35ab6d24daaf2db64eb43bf943f7653ff4f0c84bda2dede78d9ba7680b3f92",
      "text": "姓"
    },
    {
      "id": "A26697-zh-00022",
      "source_hash": "5daba86942ae7632cf685423e33d14cad623923921e9e5d29702b410a9e9f5ff",
      "text": "名："
    },
    {
      "id": "A26697-zh-00024",
      "source_hash": "651b2e6efe82252888e9f333fd56470837c758da5cfbb6c0e63bc09eb3e86424",
      "text": "兹证明上述人员依照《防止人口贩运等及保护受害者"
    },
    {
      "id": "A26697-zh-00025",
      "source_hash": "472d300a2314ea389ef3d4f5acda14c6506468d35686f0cf0d7a3e0accc14618",
      "text": "等法》第二十二条第三款及同法"
    },
    {
      "id": "A26697-zh-00026",
      "source_hash": "f0d4ca855033eb69ccf042ddd2d7fd16ffad8a538ee6ff3b422f86dd7ba216c2",
      "text": "施行规则第六条第一款的规定，为○○地方人口贩运等"
    },
    {
      "id": "A26697-zh-00027",
      "source_hash": "6b2ebefdb9dfd1e927d76233f17263974f3b8c1d7eec61389ba4432ac0e6fbe5",
      "text": "受害者权益保护机构工作人员。"
    },
    {
      "id": "A26697-zh-00028",
      "source_hash": "1dea1df8e723b726b6801f9695b44f605789db9a3ff4c66dc45491ba1ce0fc96",
      "text": "特此证明。"
    },
    {
      "id": "A26697-zh-00032",
      "source_hash": "d0d4846e2f55d14b2788851adaa78876764396683276302525dc01d3ac7f6ecc",
      "text": "特别市长、广域市长、道知事"
    },
    {
      "id": "A26697-zh-00034",
      "source_hash": "6ce6163f2531180bf1303c3b6b19d6d7df589a187c26fb1b9479f5e52810f3b6",
      "text": "特别自治市长、特别自治道知事"
    },
    {
      "id": "A26697-zh-00035",
      "source_hash": "d97ef7cd7bc68091d87bdb9c1a1043db0e8620e3e9aa624237d6cbf1b3af23d9",
      "text": "1. 本证持有人系地方人口贩运等受害者权益保护"
    },
    {
      "id": "A26697-zh-00036",
      "source_hash": "be798caaaa9e51b5382683e00ae68e630763eb6eb701e74670314abf94405432",
      "text": "机构工作人员，可以陪同开展人口贩运等受害者"
    },
    {
      "id": "A26697-zh-00037",
      "source_hash": "4176492c7d94ff81ad327f5f67269a3f8c637c3f5dd4084c382aeb83d05e51b5",
      "text": "救助活动；依据《防止人口贩运等及保护受害者"
    },
    {
      "id": "A26697-zh-00038",
      "source_hash": "b4502b8e2855ce109d2b70e16d1dc86a5ff54504eb20871b1ea8c641f5772fd7",
      "text": "等法》第十七条、第十八条或者第二十二条规定，"
    },
    {
      "id": "A26697-zh-00039",
      "source_hash": "fd9ccec4e1a72ab394795330f6484fc6307a1310c4afc6fb270af5651112a6f9",
      "text": "可以陪同参与侦查机关调查、证人讯问等程序，"
    },
    {
      "id": "A26697-zh-00040",
      "source_hash": "4f2e3e7e07e919635b73a3767e6117d012e35a0b4ff4d26ffe3f32b01e001cc5",
      "text": "并在场陪同。"
    }
  ],
  "note": "Checked both sides of local victim-rights protection agency staff ID form against Korean. Corrected official act title, authority, photo requirements, body text, statute references and 70x100 millimeter card size incorrectly stated as centimeters. Valid existing dates and surrender/mailbox instructions retained."
}