    {
      "id": "A30911-zh-00396",
      "text": "3. 按水质及水生态系统状态划分的生物学特征说明表"
    },
    {
      "id": "A30911-zh-00397",
      "text": "生物等级"
    },
    {
      "id": "A30911-zh-00398",
      "text": "生物指示物种"
    },
    {
      "id": "A30911-zh-00399",
      "text": "栖息地及生物特征"
    },
    {
      "id": "A30911-zh-00400",
      "text": "等级"
    },
    {
      "id": "A30911-zh-00401",
      "text": "底栖生物"
    },
    {
      "id": "A30911-zh-00402",
      "text": "鱼类"
    },
    {
      "id": "A30911-zh-00403",
      "text": "非常"
    },
    {
      "id": "A30911-zh-00406",
      "text": "—水体非常清澈，水流较快。"
    },
    {
      "id": "A30911-zh-00407",
      "text": "良好"
    },
    {
      "id": "A30911-zh-00409",
      "text": "山鳟、金刚雅罗鱼、热目鱼、柳鱼等栖息"
    },
    {
      "id": "A30911-zh-00410",
      "text": "。"
    },
    {
      "id": "A30911-zh-00412",
      "text": "—河床主要由岩石和砾石构成"
    },
    {
      "id": "A30911-zh-00413",
      "text": "良好"
    },
    {
      "id": "A30911-zh-00415",
      "text": "。"
    },
    {
      "id": "A30911-zh-00417",
      "text": "—附着藻类极少。"
    },
    {
      "id": "A30911-zh-00418",
      "text": "良好"
    },
    {
      "id": "A30911-zh-00420",
      "text": "—水质清澈，水流略快或适中。"
    },
    {
      "id": "A30911-zh-00422",
      "text": "等蜉蝣"
    },
    {
      "id": "A30911-zh-00423",
      "text": "或正常。"
    },
    {
      "id": "A30911-zh-00426",
      "text": "—河床主要由砾石和沙子构成"
    },
    {
      "id": "A30911-zh-00428",
      "text": "。"
    },
    {
      "id": "A30911-zh-00430",
      "text": "—附着藻类较少。"
    },
    {
      "id": "A30911-zh-00431",
      "text": "一般"
    },
    {
      "id": "A30911-zh-00434",
      "text": "—水体稍浑浊，水流较慢。"
    },
    {
      "id": "A30911-zh-00437",
      "text": "。"
    },
    {
      "id": "A30911-zh-00438",
      "text": "稍微"
    },
    {
      "id": "A30911-zh-00439",
      "text": "—河床主要由细砾石和沙子组成。"
    },
    {
      "id": "A30911-zh-00440",
      "text": "较差"
    },
    {
      "id": "A30911-zh-00441",
      "text": "。"
    },
    {
      "id": "A30911-zh-00442",
      "text": "—附着藻类呈绿色且较多。"
    },
    {
      "id": "A30911-zh-00443",
      "text": "稍微"
    },
    {
      "id": "A30911-zh-00446",
      "text": "—水体非常浑浊，水流缓慢。"
    },
    {
      "id": "A30911-zh-00447",
      "text": "较差"
    },
    {
      "id": "A30911-zh-00450",
      "text": "。"
    },
    {
      "id": "A30911-zh-00452",
      "text": "—河床主要由沙子和粉砂构成，"
    },
    {
      "id": "A30911-zh-00453",
      "text": "非常"
    },
    {
      "id": "A30911-zh-00454",
      "text": "一般呈黑色。"
    },
    {
      "id": "A30911-zh-00455",
      "text": "较差"
    },
    {
      "id": "A30911-zh-00456",
      "text": "—附着藻类呈棕色或灰色"
    },
    {
      "id": "A30911-zh-00457",
      "text": "且非常多。"
