  "edits": [
    {
      "id": "B3-zh-00051",
      "text": "将第二条各项以外部分中的“女性家族部令”改为“保健福利家族部令”。\n\n将第三条第一款、第三条之二各项以外部分、第六条第二款、第十条第六款及第十一条第二款中的“女性家族部部长”分别改为“保健福利家族部部长”。\n\n"
    },
    {
      "id": "B3-zh-00052",
      "text": "将第十二条中的“保健福利部部长”改为“保健福利家族部部长”。\n\n<91>至<94>省略。\n\n"
    },
    {
      "id": "B3-zh-00053",
      "text": "附则（《保健福利家族部及其所属机关组织规定施行规则》）<第84号，2008年12月31日>\n\n"
    },
    {
      "id": "B3-zh-00055",
      "text": "第二条（其他法令的修订）①至⑤省略。\n\n⑥《单亲家庭支援法施行规则》部分修订如下。\n\n"
    },
    {
      "id": "B3-zh-00056",
      "text": "将第三条之二各项以外部分中的“女性家族部令”改为“保健福利家族部令”。\n\n"
    },
    {
      "id": "B3-zh-00058",
      "text": "附则（《女性家族部组织规定施行规则》）<第1号，2010年3月19日>\n\n"
    },
    {
      "id": "B3-zh-00060",
      "text": "第二条（其他法令的修订）①至⑭省略。\n\n⑮《单亲家庭支援法施行规则》部分修订如下。\n\n"
    },
    {
      "id": "B3-zh-00061",
      "text": "将第二条各项以外部分及第三条之二各项以外部分中的“保健福利家族部令”分别改为“女性家族部令”。\n\n将第三条、第六条第二款、第十条第六款、第十一条第二款及第十二条中的“保健福利家族部部长”分别改为“女性家族部部长”。\n\n"
    }
