  "edits": [
    {
      "id": "A5223-zh-00001",
      "text": "■ 《单亲家庭支援法施行规则》[附表2] <2023年10月12日修订>"
    },
    {
      "id": "A5223-zh-00003",
      "text": "1. 选址条件"
    },
    {
      "id": "A5223-zh-00004",
      "text": "单亲家庭福利设施应充分考虑保健、卫生、供水、安全、环境及交通便利等因素，设置于舒适的环境中。"
    },
    {
      "id": "A5223-zh-00005",
      "text": ""
    },
    {
      "id": "A5223-zh-00006",
      "text": "2. 各类设施的规模"
    },
    {
      "id": "A5223-zh-00008",
      "text": "入住定员"
    },
    {
      "id": "A5223-zh-00010",
      "text": "甲. 分娩支援设施"
    },
    {
      "id": "A5223-zh-00011",
      "text": "1）本法第十九条第一款第一项甲目及"
    },
    {
      "id": "A5223-zh-00012",
      "text": "30人以上、70人以下"
    },
    {
      "id": "A5223-zh-00014",
      "text": "乙目规定的设施"
    },
    {
      "id": "A5223-zh-00015",
      "text": "10人以上、不满30人"
    },
    {
      "id": "A5223-zh-00017",
      "text": "2）本法第十九条第一款第一项丙目"
    },
    {
      "id": "A5223-zh-00018",
      "text": "5人以上、30人以下"
    },
    {
      "id": "A5223-zh-00020",
      "text": "规定的设施"
    },
    {
      "id": "A5223-zh-00021",
      "text": "乙. 养育支援设施"
    },
    {
      "id": "A5223-zh-00022",
      "text": "5户以上、30户以下"
    },
    {
      "id": "A5223-zh-00023",
      "text": "20.79平方米×定员（户）"
    },
    {
      "id": "A5223-zh-00024",
      "text": ""
    },
    {
      "id": "A5223-zh-00025",
      "text": "丙. 生活支援设施"
    },
    {
      "id": "A5223-zh-00026",
      "text": "10户以上、30户以下"
    },
    {
      "id": "A5223-zh-00027",
