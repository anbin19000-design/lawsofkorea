  "document": {
    "key": "B2",
    "kind": "대통령령",
    "title": "의무경찰대 설치 및 운영에 관한 법률 시행령",
    "source_hash": "da345505912da9c84c24a63989aee8605f2465beea1b28313585cd363b8b2504",
    "rows_checked": 8,
    "rows_corrected": 5,
    "document_review_state": "DOCUMENT_ROWS_CHECKED"
  },
  "range": {
    "first_row_id": "B2-zh-00265",
    "last_row_id": "B2-zh-00272",
