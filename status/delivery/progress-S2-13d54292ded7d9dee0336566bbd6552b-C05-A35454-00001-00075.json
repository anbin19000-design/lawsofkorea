  "edits": [
    {
      "id": "A35454-zh-00001",
      "text": "■ 《宇宙开发促进法施行令》[附表] <2015年7月20日修订>"
    },
    {
      "id": "A35454-zh-00002",
      "text": "行政罚款征收标准（与第二十四条有关）"
    },
    {
      "id": "A35454-zh-00003",
      "text": "1. 一般标准"
    },
    {
      "id": "A35454-zh-00004",
      "text": "甲. 按违法次数确定的行政罚款标准，适用于最近三年内曾因同一违法行为"
    },
    {
      "id": "A35454-zh-00005",
      "text": "受到行政罚款的情形。此时，以对违法行为作出行政罚款处分之日及"
    },
    {
      "id": "A35454-zh-00006",
      "text": "再次查获同一违法行为之日分别为基准，"
    },
    {
      "id": "A35454-zh-00007",
      "text": "计算违法行为次数。"
    },
    {
      "id": "A35454-zh-00008",
      "text": "乙. 征收机关遇下列任一情形时，可将第二项规定的行政罚款金额"
    },
    {
      "id": "A35454-zh-00009",
      "text": "在其二分之一范围内予以减轻。但是，对于拖欠行政罚款的违法行为人"
    },
    {
      "id": "A35454-zh-00010",
      "text": "不得适用上述减轻规定。"
    },
    {
      "id": "A35454-zh-00011",
      "text": "1）违法行为人符合《违反秩序行为规制法施行令》第二条之二第一款各项"
    },
    {
      "id": "A35454-zh-00012",
      "text": "任一情形时"
    },
    {
      "id": "A35454-zh-00013",
      "text": "2）违法行为人已纠正或消除违法行为造成的后果时"
    },
    {
      "id": "A35454-zh-00014",
      "text": "3）认定违法行为因轻微疏忽、错误等过失所致时"
    },
    {
      "id": "A35454-zh-00015",
      "text": "4）违法行为后果轻微时"
    },
    {
      "id": "A35454-zh-00016",
      "text": "5）其他考虑违法行为程度、动机及后果等，认定有必要"
    },
    {
      "id": "A35454-zh-00017",
      "text": "减轻罚款金额时"
    },
    {
      "id": "A35454-zh-00018",
      "text": "丙. 征收机关遇下列任一情形时，可将第二项规定的行政罚款金额"
    },
    {
      "id": "A35454-zh-00019",
      "text": "在其二分之一范围内加重。但即使存在多项加重原因，"
    },
    {
      "id": "A35454-zh-00020",
      "text": "行政罚款金额仍不得超过本法第二十九条第一款及第二款"
    },
    {
      "id": "A35454-zh-00021",
      "text": "规定的上限。"
    },
    {
      "id": "A35454-zh-00022",
      "text": "1）违法状态持续两个月以上时"
    },
    {
      "id": "A35454-zh-00023",
      "text": "2）其他考虑违法行为程度、动机及后果等，认定有必要"
    },
    {
      "id": "A35454-zh-00024",
      "text": "加重罚款金额时"
    },
    {
      "id": "A35454-zh-00025",
      "text": "2. 个别标准"
    },
    {
      "id": "A35454-zh-00026",
      "text": "（单位：万韩元）"
    },
    {
      "id": "A35454-zh-00027",
      "text": "违法行为"
    },
    {
      "id": "A35454-zh-00028",
      "text": "依据法条"
    },
    {
      "id": "A35454-zh-00029",
      "text": "行政罚款金额"
    },
    {
      "id": "A35454-zh-00030",
      "text": "第一次违法"
    },
    {
      "id": "A35454-zh-00031",
      "text": "第二次违法"
    },
    {
      "id": "A35454-zh-00032",
      "text": "第三次以上"
    },
    {
      "id": "A35454-zh-00033",
      "text": "违法"
    },
    {
      "id": "A35454-zh-00034",
      "text": "甲. 违反本法第八条第一款或第二款规定，"
    },
    {
      "id": "A35454-zh-00035",
      "text": "本法第二十九条第一款"
    },
    {
      "id": "A35454-zh-00039",
      "text": "未对人造宇宙物体"
    },
    {
      "id": "A35454-zh-00040",
      "text": "第一项"
    },
    {
      "id": "A35454-zh-00041",
      "text": "进行预备登记的情形"
    },
    {
      "id": "A35454-zh-00042",
      "text": ""
    },
    {
      "id": "A35454-zh-00043",
      "text": "乙. 违反本法第八条第五款规定，"
    },
    {
      "id": "A35454-zh-00044",
      "text": "本法第二十九条第一款"
    },
    {
      "id": "A35454-zh-00048",
      "text": "未对人造宇宙物体进行登记"
    },
    {
      "id": "A35454-zh-00049",
      "text": "第二项"
    },
    {
      "id": "A35454-zh-00050",
      "text": "的情形"
    },
    {
      "id": "A35454-zh-00051",
      "text": "丙. 违反本法第八条第六款规定，"
    },
    {
      "id": "A35454-zh-00052",
      "text": "本法第二十九条第二款"
    },
    {
      "id": "A35454-zh-00056",
      "text": "未在十五日内通知变更情况，"
    },
    {
      "id": "A35454-zh-00057",
      "text": "第一项"
    },
    {
      "id": "A35454-zh-00058",
      "text": "或作出虚假通知"
    },
    {
      "id": "A35454-zh-00059",
      "text": "的情形"
    },
    {
      "id": "A35454-zh-00060",
      "text": "丁. 违反本法第十一条第一款但书，"
    },
    {
      "id": "A35454-zh-00061",
      "text": "本法第二十九条第一款"
    },
    {
      "id": "A35454-zh-00065",
      "text": "未申报变更事项"
    },
    {
      "id": "A35454-zh-00066",
      "text": "第三项"
    },
    {
      "id": "A35454-zh-00067",
      "text": "的情形"
    },
    {
      "id": "A35454-zh-00068",
      "text": "戊. 拒绝、妨碍或回避本法第十六条第三款规定的"
    },
    {
      "id": "A35454-zh-00069",
      "text": "本法第二十九条第二款"
    },
    {
      "id": "A35454-zh-00073",
      "text": "事故调查的情形"
    },
    {
      "id": "A35454-zh-00074",
      "text": "第二项"
    },
