    {
      "id": "A35093-zh-00001",
      "text": "■《幼儿教育法》[附表1] <2013年3月23日修订>"
    },
    {
      "id": "A35093-zh-00002",
      "text": "园长、园监资格标准（与第二十二条第一款有关）"
    },
    {
      "id": "A35093-zh-00003",
      "text": "资格"
    },
    {
      "id": "A35093-zh-00004",
      "text": "资格标准"
    },
    {
      "id": "A35093-zh-00005",
      "text": "类别"
    },
    {
      "id": "A35093-zh-00006",
      "text": "园长"
    },
    {
      "id": "A35093-zh-00007",
      "text": "1. 持有幼儿园园监资格证书，具有三年以上教育经历，且"
    },
    {
      "id": "A35093-zh-00008",
      "text": "接受规定的再教育者"
    },
    {
      "id": "A35093-zh-00009",
      "text": "2. 学识丰富、德望高尚，符合总统令规定标准"
    },
    {
      "id": "A35093-zh-00010",
      "text": "并得到教育部长认可者"
    },
    {
      "id": "A35093-zh-00011",
      "text": "园监"
    },
    {
      "id": "A35093-zh-00012",
      "text": "1. 持有幼儿园正式教师（一级）资格证书，具有三年以上教育经历"
    },
    {
      "id": "A35093-zh-00013",
      "text": "且接受规定的再教育者"
    },
    {
      "id": "A35093-zh-00014",
      "text": "2. 持有幼儿园正式教师（二级）资格证书，具有六年以上教育经历"
    },
    {
      "id": "A35093-zh-00015",
      "text": "且接受规定的再教育者"
    },
    {
      "id": "A35093-zh-00016",
      "text": "备注：园长、园监，以及依《初等及中等教育法》规定的校长、副校长、"
    },
    {
      "id": "A35093-zh-00017",
      "text": "教育长、教育督导官、教育督导员、教育研究官及教育研究员的工作经历年限"
    },
    {
      "id": "A35093-zh-00018",
      "text": "可视为教育经历年限。"
    }
