  "edits": [
    {
      "id": "A5225-zh-00001",
      "text": "■ 《单亲家庭支援法施行规则》[附表4] <2024年11月26日修订>"
    },
    {
      "id": "A5225-zh-00002",
      "text": "单亲家庭福利设施从业人员的资格标准（与第十条之二第二款有关）"
    },
    {
      "id": "A5225-zh-00003",
      "text": "1. 单亲家庭福利设施负责人的资格标准"
    },
    {
      "id": "A5225-zh-00004",
      "text": "甲. 依《社会福利事业法》取得一级社会福利师资格后，具有三年以上社会"
    },
    {
      "id": "A5225-zh-00005",
      "text": "福利工作经历的人"
    },
    {
      "id": "A5225-zh-00006",
      "text": "乙. 依《社会福利事业法》取得二级以上社会福利师资格后，具有五年以上"
    },
    {
      "id": "A5225-zh-00007",
      "text": "社会福利工作经历的人"
    },
    {
      "id": "A5225-zh-00008",
      "text": "丙. 在国家或地方自治团体担任七级以上公务员，具有五年以上社会福利"
    },
    {
      "id": "A5225-zh-00009",
      "text": "工作经历的人"
    },
    {
      "id": "A5225-zh-00010",
      "text": "丁. 作为社会福利设施或社会福利团体的工作人员，具有七年以上社会福利"
    },
    {
      "id": "A5225-zh-00011",
      "text": "工作经历的人"
    },
    {
      "id": "A5225-zh-00012",
      "text": "戊. 具有《健康家庭基本法》规定的健康家庭师资格，并在以《健康家庭基本法》"
    },
    {
      "id": "A5225-zh-00013",
      "text": "第二十一条第二款各项事项为主要业务的设施及机构中具有七年以上"
    },
    {
      "id": "A5225-zh-00014",
      "text": "工作经历的人"
    },
    {
      "id": "A5225-zh-00015",
      "text": "己. 具有《医疗法》规定的护士资格，并具有七年以上社会福利"
    },
    {
      "id": "A5225-zh-00016",
      "text": "工作经历的人"
    },
    {
      "id": "A5225-zh-00017",
      "text": "2. 单亲家庭福利设施从业人员的资格标准"
    },
    {
      "id": "A5225-zh-00018",
      "text": "甲. 事务局长"
    },
    {
      "id": "A5225-zh-00019",
      "text": "（1）依《社会福利事业法》取得二级以上社会福利师资格后，具有两年以上"
    },
    {
      "id": "A5225-zh-00020",
      "text": "社会福利工作经历的人"
    },
    {
      "id": "A5225-zh-00021",
      "text": "（2）在国家或地方自治团体担任一般职公务员，具有两年以上社会福利"
    },
    {
      "id": "A5225-zh-00022",
      "text": "工作经历的人"
    },
    {
      "id": "A5225-zh-00023",
      "text": "（3）作为社会福利设施或社会福利团体的工作人员，具有三年以上社会福利"
    },
    {
      "id": "A5225-zh-00024",
      "text": "工作经历的人"
    },
    {
      "id": "A5225-zh-00025",
      "text": "（4）具有《健康家庭基本法》规定的健康家庭师资格，并在以该法"
    },
    {
      "id": "A5225-zh-00026",
      "text": "第二十一条第二款各项事项为主要业务的设施及机构中具有两年以上"
    },
    {
      "id": "A5225-zh-00027",
      "text": "工作经历的人"
    },
    {
      "id": "A5225-zh-00028",
      "text": "乙. 生活福利师"
    },
    {
      "id": "A5225-zh-00029",
      "text": "（1）具有《社会福利事业法》规定的二级以上社会福利师资格的人"
    },
    {
      "id": "A5225-zh-00030",
      "text": "（2）具有《健康家庭基本法》规定的健康家庭师资格，并在以该法"
    },
    {
      "id": "A5225-zh-00031",
      "text": "第二十一条第二款各项事项为主要业务的设施及机构中具有两年以上"
    },
    {
      "id": "A5225-zh-00032",
      "text": "工作经历的人"
    },
    {
      "id": "A5225-zh-00033",
      "text": "（3）具有三年以上《社会福利事业法》第二条第一项规定的社会福利咨询工作"
    },
    {
      "id": "A5225-zh-00034",
      "text": "经历的人"
    },
    {
      "id": "A5225-zh-00035",
      "text": "（4）具有《青少年基本法》第二十一条及第二十二条规定的青少年指导师或青少年咨询师"
    },
    {
      "id": "A5225-zh-00036",
      "text": "资格的人"
    },
    {
      "id": "A5225-zh-00037",
      "text": "（5）在大学主修心理学、教育学、女性学、社会学、社会事业学、法学、神学、医学、"
    },
    {
      "id": "A5225-zh-00038",
      "text": "护理学或社会福利学并已毕业的人（包括预计毕业者），或者"
    },
    {
      "id": "A5225-zh-00039",
      "text": "依照法令被认可具有同等以上学历的人"
    },
    {
      "id": "A5225-zh-00040",
      "text": "丙. 生活指导员"
    },
    {
      "id": "A5225-zh-00041",
      "text": "依《初等及中等教育法》从高中以上学校毕业的人（包括预计毕业者），"
    },
    {
      "id": "A5225-zh-00042",
      "text": "或依照法令被认可具有同等以上学历的人"
    },
    {
      "id": "A5225-zh-00043",
      "text": "丁. 护士"
    },
    {
      "id": "A5225-zh-00044",
      "text": "具有《医疗法》规定的护士资格的人（包括护理助理）。但具有护理助理"
    },
    {
      "id": "A5225-zh-00045",
      "text": "资格的人，应具有三年以上社会福利工作经历。"
    },
    {
      "id": "A5225-zh-00046",
      "text": "戊. 营养师"
    },
    {
      "id": "A5225-zh-00047",
      "text": "具有《国民营养管理法》规定的营养师资格的人"
    },
    {
      "id": "A5225-zh-00048",
      "text": "己. 厨师"
    },
    {
      "id": "A5225-zh-00049",
      "text": "具有《食品卫生法》规定的厨师资格的人"
    },
    {
      "id": "A5225-zh-00050",
      "text": "庚. 管理人员"
    },
    {
      "id": "A5225-zh-00051",
      "text": "身体健康且不存在录用限制事由的人"
    }
