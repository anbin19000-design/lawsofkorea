kr-013607-211421-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2813988","source_hash":"f8f2f24b56190768906f4b29cb676d764546e63aa622e064e92cac22747abfac","text":"a. 违反该法第21条，国家航空"},{"id":"A38482-zh-00044","doc":"A38482","law_id":"kr-013607-211421-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2813989","source_hash":"a968c71e4328c48864299ea73f9db0bc1e5e30a115290a1e42ff20665fefe433","text":"《法案》第25条第1款"},{"id":"A38482-zh-00045","doc":"A38482","law_id":"kr-013607-211421-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2813990","source_hash":"1a6562590ef19d1045d06c4055742d38288e9e6dcd71ccde5cee80f1d5a774eb","text":"50"},{"id":"A38482-zh-00046","doc":"A38482","law_id":"kr-013607-211421-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2813991","source_hash":"9ae2bdd7beedc2e766c6b76585530e16925115707dc7a06ab5ee4aa2776b2c7b","text":"150"},{"id":"A38482-zh-00047","doc":"A38482","law_id":"kr-013607-211421-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2813992","source_hash":"1e472b39b105d349bcd069c4a711b44a2fffb8e274714bb07ecfff69a9a7f67b","text":"250"},{"id":"A38482-zh-00048","doc":"A38482","law_id":"kr-013607-211421-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2813993","source_hash":"3e16961bf1abec0ba26618aefbfa4d4ef3b1853a607cd152ff646b73a1037763","text":"非博物馆人士 国家航空博物馆"},{"id":"A38482-zh-00049","doc":"A38482","law_id":"kr-013607-211421-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2813994","source_hash":"b79e9a1d00b59d16f1c8d3672ef8d1119cf536c1a332478d9efb3c0ccb47dab6","text":"如果使用与管子名称相似的名称"}]}