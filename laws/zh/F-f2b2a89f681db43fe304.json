:2065277","source_hash":"428d3c0682571fb7d25e2503602919c68bf7e8bb698388a3b6c020f3cbde934c","text":"8 人"},{"id":"A28952-zh-00008","doc":"A28952","law_id":"kr-003494-278339-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2065278","source_hash":"e0849dabd3fcfc29de2b235ae6c8f6e81cfd59f73c5ed80326e52166e910c9ac","text":"至 2027 年 12 月 31 日"},{"id":"A28952-zh-00009","doc":"A28952","law_id":"kr-003494-278339-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2065279","source_hash":"6f11c2520b6db7d862670b562a61f88bb3a924dc68636c1b2ecf82209bed08ee","text":"(四年级 1 人，五年级 4 人,"},{"id":"A28952-zh-00010","doc":"A28952","law_id":"kr-003494-278339-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2065280","source_hash":"331547b8206f1122ad57a02bc588967f402909259dc7d72117190cabb4f0dee1","text":"2 六年级学生，1 名七年级学生)"},{"id":"A28952-zh-00011","doc":"A28952","law_id":"kr-003494-278339-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2065281","source_hash":"6ed2774d5704540853d461f8c886be7e18b5b6b78e7e13160a6594b7ac959802","text":"2. 贸易调查处，裁决支持科"},{"id":"A28952-zh-00012","doc":"A28952","law_id":"kr-003494-278339-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2065282","source_hash":"428d3c0682571fb7d25e2503602919c68bf7e8bb698388a3b6c020f3cbde934c","text":"8 人"},{"id":"A28952-zh-00013","doc":"A28952","law_id":"kr-003494-278339-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2065283","source_hash":"e0849dabd3fcfc29de2b235ae6c8f6e81cfd59f73c5ed80326e52166e910c9ac","text":"至 2027 年 12 月 31 日"},{"id":"A28952-zh-00014","doc":"A28952","law_id":"kr-003494-278339-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2065284","source_hash":"6f11c2520b6db7d862670b562a61f88bb3a924dc68636c1b2ecf82209bed08ee","text":"(四年级 1 人，五年级 4 人,"},{"id":"A28952-zh-00015","doc":"A28952","law_id":"kr-003494-278339-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2065285","source_hash":"331547b8206f1122ad57a02bc588967f402909259dc7