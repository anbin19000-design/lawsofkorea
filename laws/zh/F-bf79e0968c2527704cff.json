_hash":"976f28fd918213641079dd606068861e20db1e8a09b5a0b7138f1bb8c6b9dbc2","text":"33.97"},{"id":"A39889-zh-00015","doc":"A39889","law_id":"kr-014992-280335-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2885013","source_hash":"7c7830a3075a7c80798fa05cd24d4ca5293472492b6a204d5cbdd0776efeae27","text":"和出口公司产品的人员"},{"id":"A39889-zh-00016","doc":"A39889","law_id":"kr-014992-280335-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2885014","source_hash":"ad41459d19a0ffa5604243bdb7a2bc514829907cbc0db2aa9d9c2042960dec7c","text":"3。其他供应商"},{"id":"A39889-zh-00017","doc":"A39889","law_id":"kr-014992-280335-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2885015","source_hash":"976f28fd918213641079dd606068861e20db1e8a09b5a0b7138f1bb8c6b9dbc2","text":"33.97"},{"id":"A39889-zh-00018","doc":"A39889","law_id":"kr-014992-280335-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2885016","source_hash":"c8c09bfee0e14664f75e0d7de7d492a63e1d904029fb6fb64339cc471e70d8bc","text":"备注：第3款的供应商和第1款或第2款的供应商[关于]《海关法实施令》第23条"},{"id":"A39889-zh-00019","doc":"A39889","law_id":"kr-014992-280335-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2885017","source_hash":"dd08cc650e22e08c6b8c1a54010f18f9993be1c1781b093b1df30a5a7f56fecb","text":"根据第1款规定，存在特殊关系的供应商，根据第3款规定，对供应商进行反倾销。"},{"id":"A39889-zh-00020","doc":"A39889","law_id":"kr-014992-280335-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2885018","source_hash":"588d12faf5790f23f3c05cb087f26248d6b2baf7e0b727c6d8fe8d72a4c59191","text":"尽管存在关税税率，但与他相关的供应商的反倾销税率为"},{"id":"A39889-zh-00021","doc":"A39889","law_id":"kr-014992-280335-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2885019","source_hash":"97fd758fc60fc9251a5005f68a161700690e909dddd2dad158a5748a6bd9f7b0","text":"应用。"}]}