start":null,"end":null,"target_id":"XML:2034230","source_hash":"101c4f9d2f0fd31a3c738e8d42290aec5e120eaff2d9f84a75c6123262c7a42f","text":"空军检控署"},{"id":"A28562-zh-00025","doc":"A28562","law_id":"kr-002965-241419-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2034231","source_hash":"6b86b273ff34fce19d6b804eff5a3f5747ada4eaa22f1d49c01e52ddb7875b4b","text":"1"},{"id":"A28562-zh-00026","doc":"A28562","law_id":"kr-002965-241419-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2034232","source_hash":"19581e27de7ced00ff1ce50b2047e7a567c76b1cbaebabe5ef03f7c3017bb5b7","text":"9"},{"id":"A28562-zh-00027","doc":"A28562","law_id":"kr-002965-241419-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2034233","source_hash":"19581e27de7ced00ff1ce50b2047e7a567c76b1cbaebabe5ef03f7c3017bb5b7","text":"9"},{"id":"A28562-zh-00028","doc":"A28562","law_id":"kr-002965-241419-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2034234","source_hash":"9400f1b21cb527d7fa3d3eabba93557a18ebe7a2ca4e471cfe5e4c5b4ca7f767","text":"19"},{"id":"A28562-zh-00029","doc":"A28562","law_id":"kr-002965-241419-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2034236","source_hash":"6b86b273ff34fce19d6b804eff5a3f5747ada4eaa22f1d49c01e52ddb7875b4b","text":"1"},{"id":"A28562-zh-00030","doc":"A28562","law_id":"kr-002965-241419-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2034237","source_hash":"ef2d127de37b942baad06145e54b0c619a1f22327b2ebbcfbec78f5564afe39d","text":"5"},{"id":"A28562-zh-00031","doc":"A28562","law_id":"kr-002965-241419-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2034238","source_hash":"031b4af5197ec30a926f48cf40e11a7dbc470048a21e4003b7a3c07c5dab1baa","text":"51"},{"id":"A28562-zh-00032","doc":"A28562","law_id":"kr-002965-241419-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2034239","source_hash":"98010bd9270f9b100b6214a21754fd33bdc8d41b2bc9f9dd16ff54d3c34ffd71","text":"48"},{"id":"A28562-zh-00