2c932e01a309a9b9b0812e1da93fa9579fb5","text":"（签名或印章）"},{"id":"A37626-zh-00026","doc":"A37626","law_id":"kr-011812-265147-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2750059","source_hash":"7a6608d63755b7bb64e63cba03fa377ce0873c6cba9dab20bab6c9a0ae89cfa2","text":"联系人姓名"},{"id":"A37626-zh-00027","doc":"A37626","law_id":"kr-011812-265147-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2750060","source_hash":"bb4d371241885409036896fae7ada6d3fc74d5e66e40977ecec3551c3bb879a4","text":"联系人电话号码"},{"id":"A37626-zh-00028","doc":"A37626","law_id":"kr-011812-265147-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2750061","source_hash":"d3fcbadac4da42c1a1025d7231674ac185d663f7e8ad8b510be48949724a65eb","text":"卫生及福利部长"},{"id":"A37626-zh-00029","doc":"A37626","law_id":"kr-011812-265147-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2750062","source_hash":"2099cd7f323c38ac89f0ebc4dd140529ccb048fb87aa42935038b81b0325020d","text":"您的"},{"id":"A37626-zh-00030","doc":"A37626","law_id":"kr-011812-265147-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2750063","source_hash":"92fb7736dfc7cc41a1e0aa0ec53450b9c41601da936d4a2211119ca2d31423b7","text":"特区市长 · 大都会区市长 · 省长 · 特别自治省省长"}]}