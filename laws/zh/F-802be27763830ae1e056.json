L:2585139","source_hash":"a96d2ba38b084d3fc27ed07a4eee58f61b47686c274d984bab9981642301bb70","text":"汽车"},{"id":"A35392-zh-00013","doc":"A35392","law_id":"kr-010015-270629-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2585140","source_hash":"890d0c5f367818a2ac402de1d8d7507c84febfafcdff6b7ee9076d0c3f34fbbd","text":"2. 铁轮类型"},{"id":"A35392-zh-00014","doc":"A35392","law_id":"kr-010015-270629-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2585141","source_hash":"dfb5c655738add79724abaf741a94cd5033abe0af5b29985e4416362620a00b7","text":"钢轮式转向架（车身，使车辆能够在轨道上运行）"},{"id":"A35392-zh-00015","doc":"A35392","law_id":"kr-010015-270629-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2585142","source_hash":"e1021f00c1b8c2334706afbda25ac00111279f01f86b46cb93af9f57977b57b9","text":"轻轨车辆"},{"id":"A35392-zh-00016","doc":"A35392","law_id":"kr-010015-270629-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2585143","source_hash":"df846bc03f7de31a4ac759749a945f882e08b587cc0fc499cc0c5a71d2be55f5","text":"（以下简称“该部件”）的设备，该设备的轴载荷为 13.5"},{"id":"A35392-zh-00017","doc":"A35392","law_id":"kr-010015-270629-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2585144","source_hash":"675d76dfe515fa476641965c716a032af1a8fe8e09cf4d0f32c959b53d31e3eb","text":"电动列车重量小于"},{"id":"A35392-zh-00018","doc":"A35392","law_id":"kr-010015-270629-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2585145","source_hash":"8d88476c3de133bb77ab960977583fec4110d8df68696644e34ae8cfeb175673","text":"3. 橡胶轮类型"},{"id":"A35392-zh-00019","doc":"A35392","law_id":"kr-010015-270629-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2585146","source_hash":"49b3be10543a1ac186ead906b52cfbc10a4b6516145c7a13b95977810f78caa1","text":"轴重不超过13.5吨的橡胶轮转向架电动车辆"},{"id":"A35392-zh-00020","doc":"A35392","law_id":"kr-010015-270629-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2585147","source_hash":"e1021f00c1b8c2334706afbda25ac00111279f01f86b46cb93