ML:2597141","source_hash":"4165c0cf9d6285d9ed1843f1dc74d827dc543444a842fec4f5c5f68ac1e39987","text":"根据[规则]第三条的规定，我特此申请准许设立上述公司。"},{"id":"A35605-zh-00014","doc":"A35605","law_id":"kr-010210-161926-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2597142","source_hash":"f5ca38f748a1d6eaf726b8a42fb575c3c71f1864a8143301782de13da2d9202b","text":"20"},{"id":"A35605-zh-00015","doc":"A35605","law_id":"kr-010210-161926-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2597143","source_hash":"ef1661bfe1d0b773aea1bc51daf1dfa70e9d997454acf123165fd7df67dc959c","text":"申请人"},{"id":"A35605-zh-00016","doc":"A35605","law_id":"kr-010210-161926-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2597144","source_hash":"a4078b6f9e07c62bed459673f80e462a3cfea1ce79a01ed03010c819be600415","text":"（密封）"},{"id":"A35605-zh-00017","doc":"A35605","law_id":"kr-010210-161926-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2597145","source_hash":"a80593bdb11d4a86f7b9dc80a646c18533b150e789e004a8929b9db3f087f720","text":"法院行政办公室主任"},{"id":"A35605-zh-00018","doc":"A35605","law_id":"kr-010210-161926-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2597146","source_hash":"2099cd7f323c38ac89f0ebc4dd140529ccb048fb87aa42935038b81b0325020d","text":"您的"},{"id":"A35605-zh-00019","doc":"A35605","law_id":"kr-010210-161926-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2597147","source_hash":"415c12cfe236ffa5094f9e3a7709063457a807995edc8ff53226e774fda2c5bd","text":"附件"},{"id":"A35605-zh-00020","doc":"A35605","law_id":"kr-010210-161926-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2597148","source_hash":"3af63873311a4af67dc8d1583f3080835c22edcbc350928c054b9767b3068071","text":"1. 载明创始人姓名、出生日期、地址和传记的文件（创始人"},{"id":"A35605-zh-00021","doc":"A35605","law_id":"kr-010210-161926-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2597149","source_hash":"985fd3e85a3cb1524eb79884ccf710fba18a0ddf7a5b52a82dc00a2d6ac1c282","text"