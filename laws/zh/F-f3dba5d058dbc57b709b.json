t_id":"XML:2683083","source_hash":"4f387f83fe95d6cdcce516da0027cf86c30fce784fba5de21ac222018248d00a","text":"文本文件(txt)"},{"id":"A36830-zh-00011","doc":"A36830","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683084","source_hash":"3c35374b4b56a4f17ae0265f4a7c36d6b85fb65acfa930e21a91d945c97b4139","text":"各种图像文件"},{"id":"A36830-zh-00012","doc":"A36830","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683085","source_hash":"a31ef2e29c67f568ecc45cb60f5ce2799c23a612a6624a51acdf02011e4f84ba","text":"(jpg, bmp, gif, tif, tiff)"},{"id":"A36830-zh-00013","doc":"A36830","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683086","source_hash":"c7170a449aa59504fdc0508245437a1d4e54328c973a28be91a115712a4facea","text":"电子文档等的容量"},{"id":"A36830-zh-00014","doc":"A36830","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683087","source_hash":"5b6e8678df2e5ca3857d8eb41eaaa15e7642b4543b9d8484b1c822da1f9dd933","text":"10兆字节或更少"},{"id":"A36831-zh-00001","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683088","source_hash":"991f04591394e5bc3360458675af5d299614fbfcf6cc5e0b5ce8022ad37ff3da","text":"[附件表单]"},{"id":"A36831-zh-00002","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683089","source_hash":"72c64cc2843da7820960fb7bdbb6980bfa42877deb6f938e807b9364af57d6af","text":"公证人指定申请"},{"id":"A36831-zh-00003","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683090","source_hash":"ef1661bfe1d0b773aea1bc51daf1dfa70e9d997454acf123165fd7df67dc959c","text":"申请人"},{"id":"A36831-zh-00004","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683091","source_hash":"f6a97759688986d940c9d63f904e42396e5f3c7af40acd6792de77665771ea80","text":"名称 (Name)"},{"id":"A36831-zh-00005","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683092","source_hash":"a50cfab9e507b35b983be953b8d23342958fd7a024e1f2d788e8bde2908da352","text":"办公地址"},{"id":"A36831-zh-00006","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683093","source_hash":"9027cb630e2732d15ed2a28f90d06a54f25e043ba4939defe299abfe42319113","text":"（计划安装地点）"},{"id":"A36831-zh-00007","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683094","source_hash":"cbd8975e279b620616cc2248caa1ec6c5348d1ba599415015b1022b65aa614ef","text":"(电话号码:"},{"id":"A36831-zh-00008","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683095","source_hash":"5182a773d77d36cf944ed28b7e3d27a289636d0d7d86c5119fd9dc9c9487833f","text":"《公证法》第66-3条及指定公证人事务处理规则等"},{"id":"A36831-zh-00009","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683096","source_hash":"42b8cd423bb7e966f6691247fc1ddae2357f7927db0b5a4c2f6c65075156d510","text":"我谨根据第二条规定申请指定公证人。"},{"id":"A36831-zh-00010","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683097","source_hash":"e23df8834a583975acd6211b467ad76c25a41bf4421ec3bb39ef556748700f54","text":"年份"},{"id":"A36831-zh-00011","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683098","source_hash":"ed8a406d02b187b85782da65937796100f2514b5c66e30bbdc760370421dda93","text":"月份"},{"id":"A36831-zh-00012","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2683099","source_hash":"dfc76879e2f5c3ead09186ff1c6b635624f96b7adbd71d94c37566429ca5df6f","text":"日"},{"id":"A36831-zh-00013","doc":"A36831","law_id":"kr-011238-240293-ko","scope":"ANNEX","start":