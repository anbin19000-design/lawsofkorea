──────────────────────\n\n  符合条件│                                                                                  \n\n  심사│                                                                                  \n\n  原因│                                                                                  \n\n───┼─────────────────────────────────────────\n\n  符合条件│                                                                                  \n\n  심사│                                                                                  \n\n  요구│                                                                                  \n\n  注释│                                                                                  \n\n───┼─────────────────────────────────────────\n\n  附件│1. 公务员人事档案及绩效管理卡                                                \n\n  文件│2. 非管理层工作期间的相关资料                                               \n\n      │3.                                                                                \n\n      │4.                                                                                \n\n───┴─────────────────────────────────────────\n\n"},{"id":"A35862-zh-00001","doc":"A35862","law_id":"kr-010475-256391-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2611310","source_hash":"7419001ce5c0cd735fb7c133fc48a116c049517a1a1f54aaf40609445e129b4d","text":"■ 高级审计机关人事管理及运作等规定 [附件1] <2015年7月17日修订>"},{"id":"A35862-zh-00002","doc":"A35862","law_id":"kr-010475-256391-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2611311","source_hash":"238ebef96a32dcde65bfb06941f77bd41059af9a8f910228e2c5042aa9c9b7b4","text":"资格审查决议请求"},{"id":"A35862-zh-00003","doc":"A35862","law_id":"kr-010475-256391-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2611312","source_hash":"e5415d573a6f0220c6cf8337802d05943401ee2febc6b87855c4db2f2a300052","text":"人力资源"},{"id":"A35862-zh-00004","doc":"A35862","law_id":"kr-010475-256391-ko","scope":"ANNEX","start":null,"end":null,"target