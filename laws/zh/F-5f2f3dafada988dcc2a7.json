_hash":"77f71a30b4a0174c5c41036e38cebfa1b6de708b22ffa172d4f5ef668ae74c8d","text":"第一条（生效日期）本法令自2024年12月27日起生效。\n\n省略第 2 至 5 条\n\n"},{"id":"B1-zh-00058","doc":"B1","law_id":"kr-003921-287143-ko","scope":"BODY","start":5140,"end":5263,"target_id":"bde3fecf94850e3eb94810ae2333268554e7e9f21111d2b69e4d48d1da17c035","source_hash":"a2a781694aaea998147b610078b7f72be1b1e4f88e7cee088fa466a147276cba","text":"第六条（修改其他法律）①至⑬ 已省略\n\n  ⑭ 海员劳动关系委员会条例部分内容修订如下。\n\n  在附表“群山海员劳动委员会所在地”一栏中，“全罗北道”应改为“全北特别自治道”。\n\n  省略 ⑮ 到 <34>\n\n"},{"id":"B1-zh-00059","doc":"B1","law_id":"kr-003921-287143-ko","scope":"BODY","start":5263,"end":5313,"target_id":"016f9520aca6d55921f7a583a19cb6950e724c24de0a09e0faaacf56409647d4","source_hash":"f957b237db426465d09fe0da02699ff70862bdbb01e8c8677d2a38f5ae02b34c","text":"增补（光州全罗南综合特区设立特别法实施令）<第36423号，2026年6月23日>\n\n"},{"id":"B1-zh-00060","doc":"B1","law_id":"kr-003921-287143-ko","scope":"BODY","start":5313,"end":5356,"target_id":"bd713de7658d3758a3808e3bef8cf47590d933b43345d2fadcf5290d887c1feb","source_hash":"a8048ce9f1cfabc123b8648a042e7aa3a34e654a0ec237bf2e83894d0967dd17","text":"第一条（生效日期）本法令自2026年7月1日起生效。<但书略>\n\n"},{"id":"B1-zh-00061","doc":"B1","law_id":"kr-003921-287143-ko","scope":"BODY","start":5356,"end":5364,"target_id":"02b665b44de8cc678a0b012a8452ef7e8d8dc26dab3ea49995396659c5d5cfd4","source_hash":"1fa2d78222cc5f3a7b268ba3015a524a8e57a9355a8b17e0ae4253566ef34323","text":"第 2 条省略\n\n"},{"id":"B1-zh-00062","doc":"B1","law_id":"kr-003921-287143-ko","scope":"BODY","start":5364,"end":6147,"target_id":"e61c91f7bc30113f094314565f867dc12bd608272a20f3088542695e91d90250","source_hash":"4a75c489c89e92d3e90f972fcee710436126c278be10293374afd00779652b94","text":"第三条（修改其他法律）①至<41> 已省略\n\n  <42> 海员劳资关系委员会条例部分内容修订如下。\n\n  在附表的木浦海员劳动关系委员会和丽水海员劳动关系委员会的地点栏中，“全罗南道”应分别改为“全罗南道-光州综合特别市”。\n\n  <43> 至 <78> 已省略\n\n海员劳工委员会的名称和所在地\n■ 海员劳动关系委员会规章 [附表] <2026年6月23日修订>  \n\n  海员劳资关系委员会的名称和地址                      \n\n┏━━━━━━━━━┯━━━━━━━━━━━━━━┓\n\n┃名称 │位置 ┃\n\n┠─────────┼──────────────┨\n\n┃仁川海员劳动委员会│仁川广域市┃\n\n┃群山海员劳动委员会│全北特别自治道群山市┃\n\n┃木浦海员劳动委员会│全南光州综合特别市木浦市┃\n\n┃丽水海员劳动委员会│全南光州综合特别市丽水市┃\n\n┃马山海员劳动委员会│庆尚南道马山市┃\n\n┃釜山海员劳动委员会│釜山广域市┃\n\n┃蔚山海员劳动委员会│庆尚南道蔚山市┃\n\n┃浦项海员劳动委员会│庆尚北道浦项市┃\n\n┃东海海员劳动委员会│江原道东海市┃\n\n┃济州海员劳动委员会│济州道济州市┃\n\n┃大山海员劳动委员会│忠清南道瑞山市┃\n\n┃平泽海员劳动委员会│京畿道平泽市┃\n\n┗━━━━━━━━━┷━━━━━━━━━━━━━━┛"},{"id":"A29385-zh-00001","doc":"A29385","law_id":"kr-003921-287143-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2115416","source_hash":"73d043013d5001bcc5554cba5b6deddb934f157770755397e2ebb764058de631","text":"■ 海员劳动关系委员会规章 [附表] <2026年6月23日修订>"},{"id":"A29385-zh-00002","doc":"A29385","law_id":"kr-003921-287143-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2115417","source_hash":"49900d08980eaf5cdb0d00d0464d0f25a2e5166f1390d010b8b7ccb098d5d073","text":"海员劳资关系委员会的名称和地址"},{"id":"A29385-zh-00003","doc":"A29385","law_id":"kr-003921-287143-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2115418","source_hash":"4cda38a249ab558190e607c4e4e9aca9c14c4591b75debb9989be5cba4ceab0f","text":"名称"},{"id":"A29385-zh-00004","doc":"A29385","law_id":"kr-003921-287143-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2115419","source_hash":"6c0b9dd710ab0fde0a72b7e27e9e8eedd48f92b9dc0a01ef0a0eb3e55a73df19","text":"位置"},{"id":"A29385-zh-00005","doc":"A29385","law_id":"kr-003921-287143-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2115420","source_hash":"f428a9ba410615c441267183fb14a92f44087ab6f384f055e0ee88cf140efc64","text":"仁川海员劳动委员会"},{"id":"A29385-zh-00006","doc":"A29385","law_id":"kr-003921-287143-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2115421","source_hash":"5e118a4e49c9a77118d2f724ae890d45f76e059c64460629abd6ee970165a5ae","text":"仁川广域市"},{"id":"A29385-zh-00007","doc":"A29385","law_id":"kr-003921-287143-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2115422","source_hash":"0ca393ec65b5a67e4145e83c2b28b8be90a5224836a646458cfab32ab7d1041e","text":"群山海员劳动委员会"},{"id":"A2938