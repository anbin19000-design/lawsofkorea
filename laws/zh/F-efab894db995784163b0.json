4878-273185-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2880892","source_hash":"ad57366865126e55649ecb23ae1d48887544976efea46a48eb5d85a6eeb4d306","text":"100"},{"id":"A39784-zh-00037","doc":"A39784","law_id":"kr-014878-273185-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2880893","source_hash":"27badc983df1780b60c2b3fa9d3a19a00e46aac798451f0febdca52920faaddf","text":"200"},{"id":"A39784-zh-00038","doc":"A39784","law_id":"kr-014878-273185-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2880894","source_hash":"983bd614bb5afece5ab3b6023f71147cd7b6bc2314f9d27af7422541c6558389","text":"300"},{"id":"A39784-zh-00039","doc":"A39784","law_id":"kr-014878-273185-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2880895","source_hash":"22e0d23ba74147b90a023f8fc4adb0c589686395d3b41c7000791dd734e59270","text":"批准，第32届亚洲"},{"id":"A39784-zh-00040","doc":"A39784","law_id":"kr-014878-273185-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2880896","source_hash":"0ebe7e2570816f9fab12762ca25010a3f37fad2e2efa1dced00d82930c6d89e3","text":"APEC峰会"},{"id":"A39784-zh-00041","doc":"A39784","law_id":"kr-014878-273185-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2880897","source_hash":"8d11c593a1b6205aac35f09e1929f1dbef366f49fa6bdcde204fc815aa77feae","text":"或"},{"id":"A39784-zh-00042","doc":"A39784","law_id":"kr-014878-273185-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2880898","source_hash":"0925aa90ecffa7d68ff7837a8061fc0727ed11f2ac486e261ce991adc65577ed","text":"案例"}]}