","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647927","source_hash":"983bd614bb5afece5ab3b6023f71147cd7b6bc2314f9d27af7422541c6558389","text":"300"},{"id":"A36235-zh-00036","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647928","source_hash":"983bd614bb5afece5ab3b6023f71147cd7b6bc2314f9d27af7422541c6558389","text":"300"},{"id":"A36235-zh-00037","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647929","source_hash":"983bd614bb5afece5ab3b6023f71147cd7b6bc2314f9d27af7422541c6558389","text":"300"},{"id":"A36235-zh-00038","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647930","source_hash":"d99e148981e6055fd10d5ed2474e4e3e72c83244c5bd2e6f49fd3cd76f63e97e","text":"使用华进振兴机构的名称"},{"id":"A36235-zh-00039","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647931","source_hash":"f5e4e4349fd802d03fc0dd00fa0df1fc40a4e4d48d454a054787ac6977dded2c","text":"第 1 学期"},{"id":"A36235-zh-00040","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647932","source_hash":"0925aa90ecffa7d68ff7837a8061fc0727ed11f2ac486e261ce991adc65577ed","text":"案例"},{"id":"A36235-zh-00041","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647933","source_hash":"579de44c71363629d373e1e64eb35802593f6651e83fc11773570ec43740b4ee","text":"b. 孝门违反了该法第14条的规定"},{"id":"A36235-zh-00042","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647934","source_hash":"199592f0b3494a376561228326e3baa6936e20f1ed57d659bb4b9bc0958bd1df","text":"该法第十五条"},{"id":"A36235-zh-00043","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647935","source_hash":"ad57366865126e55649ecb23ae1d48887544976efea46a48eb5d85a6eeb4d306","text":"100"},{"id":"A36235-zh-00044","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647936","source_hash":"27badc983df1780b60c2b3fa9d3a19a00e46aac798451f0febdca52920faaddf","text":"200"},{"id":"A36235-zh-00045","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647937","source_hash":"983bd614bb5afece5ab3b6023f71147cd7b6bc2314f9d27af7422541c6558389","text":"300"},{"id":"A36235-zh-00046","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647938","source_hash":"aa5385bcfdeddbfab62c77e1d55dffa4d477dab73da4af864fba049be777ce24","text":"与华进振兴院名称相似的名称"},{"id":"A36235-zh-00047","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647939","source_hash":"f5e4e4349fd802d03fc0dd00fa0df1fc40a4e4d48d454a054787ac6977dded2c","text":"第 1 学期"},{"id":"A36235-zh-00048","doc":"A36235","law_id":"kr-010658-203319-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2647940","source_hash":"953c5e360ae647e8c1cbb40f4d652829b56215790dd5123321292bbd62c959c0","text":"，则使用"},{"id":"B3-zh-00001","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":0,"end":22,"target_id":"7bc706efc8e3e2b74f79003a59744da380fd59eb7b732159cb224888c4a0ef8d","source_hash":"1a0ee41ee5d38340ce5df29cc0b79859a30de97017bb6803869496b3ccfba5d3","text":"《促进和支持孝道法》实施细则"},{"id":"B3-zh-00002","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":0,"end":84,"target_id":"bce690dcb7a935679072842115bd507c8b62abb8cd5a7871125693ab428693a2","source_hash":"18c3f01fcfccc178200ae8b5ed44255f1a6ac655917833a6a3b99c74f400be10","text":"第一条（目的）本规则的目的是规定《孝道促进和扶助法》及其执行法令所委托的事项，以及为实施该法所必需的事项。\n\n"},{"id":"B3-zh-00003","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":84,"end":454,"target_id":"a7bd0a7f87dd7063d9d4fa45e5e8480cd976742734f1efee0079cbfc9e9730d5","source_hash":"0e863e0a0fa1aadd84a0a7c6b68e07069d2430535564db365611db0c84b2b8c7","text":"第二条（关于赡养父母等家庭状况的调查）\n① 根据《孝道促进和扶助法》（以下简称“本法”）第六条第三款的规定，对赡养父母等家庭实际情况进行调查的事项如下：\n1. 关于家庭组成和赡养父母等家庭关系的事项。\n2. 与经济状况有关的事项，例如收入、资产以及赡养父母家庭的住房等。\n3. 关于赡养父母方式等事宜。\n4. 关于对父母支持的意识和态度等事项。\n5. 关于需要父母支持等事宜。\n6. 其他需要调查的有关受抚养人（例如父母）的事项\n② 国家和地方政府可以委托专门的研究机构或组织或相关专家按照第1款规定进行事实调查。\n\n"},{"id":"B3-zh-00004","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":454,"end":639,"target_id":"63529924f46fb9299d442ea0acad0a93f03c3d4a0a4d6b1dce7d850658ee588a","source_hash":"71cce804fc9b5838bb0f00c666e1ac169a0815e88863d0ad7bd87b8c8a930a2b","text":"第三条（经营计划及结算报告）  依据本法第七条设立的孝文花振兴院，应于每个财政年度结束后两个月内，向厚生劳动大臣提交下列各款所列文件。<2010年3月19日修订>\n1. 下一财政年度的业务计划及收支预算\n2. 本财政年度业务报告和财务报表\n3. 相关财政年度末的资产清单副本一份\n\n"},{"id":"B3-zh-00005","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":639,"end":659,"target_id":"6581d96e1624873a6393103b65a67af4ad2981917b9c95893debb9abf8caa53d","source_hash":"4cf3b046c3659d36f3d05553d7ae730264b2e12d6bed1d5393f568654149b9fb","text":"文章 4 已删除 <2018.4.24>\n\n"},{"id":"B3-zh-00006","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":659,"end":705,"target_id":"c15fb2f7392f5bdb6829b71a32324bc9b6101ec47ff91e8617b595a8f0983ed8","source_hash":"cc91db1482590ca04d093231630c485476977574021f83bd3e54d8726b16a492","text":"补充规定 <2008年4月4日第6号>\n\n该规定自2008年8月4日起生效。\n\n"},{"id":"B3-zh-00007","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":705,"end":748,"target_id":"2f74e334229e132221622e6dc0bec01e94cedccb992e94db8ca5427eaab63784","source_hash":"1b800b02f2f97094b470bad7beac317903d33ee6904d95a8c088f5df74bbbdd6","text":"增补（卫生福利部及其附属机构组织结构实施细则）<2010年3月19日第1号>\n\n"},{"id":"B3-zh-00008","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":748,"end":786,"target_id":"a63e4394da5ce5adc02a184cc7a39976a44ffa1cf616a1a69c4283517d1e3a92","source_hash":"17f62718ec8681372d471c3803ff3647ee41b5c21c983badb3168350a437f2a5","text":"第一条（生效日期）本规则自公布之日起生效。<但书略>\n\n"},{"id":"B3-zh-00009","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":786,"end":794,"target_id":"6d1705b2cc346b5a1dabb1f99b739e33db824fe9f294d6d3c1606388cd00ebdb","source_hash":"1fa2d78222cc5f3a7b268ba3015a524a8e57a9355a8b17e0ae4253566ef34323","text":"条款 2 省略\n\n"},{"id":"B3-zh-00010","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":794,"end":874,"target_id":"5b384c17b0221f142ea92478c77d51ba10d4cd675ffcde92751d5f138fc2530d","source_hash":"ccd10f5fcdaf51aa46367049361866124d1c58077da0d6bf3346db878a362bf7","text":"第三条（修改其他法律）①至<82>款省略\n\n  《促进和支持孝道法》实施细则部分内容修改如下。\n\n"},{"id":"B3-zh-00011","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":874,"end":933,"target_id":"a6a92065f5acc0dd1ae130cb12cfdb4c2324a2a407eb346fb8ee65143726c043","source_hash":"f8648a46691c0cd2007c3393275713a47159527dc87b3f7d9dbac8db965dee12","text":"  除第3条各款外，其余部分“卫生、福利及家庭事务大臣”应改为“卫生及福利大臣”。\n\n  <84> 省略\n\n"},{"id":"B3-zh-00012","doc":"B3","law_id":"kr-010736-203336-ko","scope":"BODY","start":933,"end":974,"target_id":"8017b4e119f4178a8e4632c8f7d00ec78c9193e186707e8305135757581a66e9","source_hash":"570b301bc46501f36a21a9925d20daf08651d44388917fae55e03ea0908ea7c4","text":"补充规定 <第568号，2018年4月24日>\n\n本规则自颁布之日起生效。"}]}