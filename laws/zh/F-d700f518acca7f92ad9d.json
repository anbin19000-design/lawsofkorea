│○法院行政办公室主任 │ ┃\n\n┃ │ │指定位置支持 │ ┃\n\n┃ │ │Imja │ ┃\n\n┃ │ │○副部长级官员法院公众 │ ┃\n\n┃ │ │Muwon │ ┃\n\n┠────┼──────┼─────────┼──────────────┨\n\n┃乘用车│大型·中型·│○各机构试验│○最低使用寿命：车辆┃\n\n┃（商业）│小型轻便│商业和一般业务│自新注册之日起「水┃\n\n┃ │ │物资管制法 ┃\n\n"},{"id":"A31126-zh-00001","doc":"A31126","law_id":"kr-005817-285841-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2297320","source_hash":"1dd24156e7f9786bf1313adccd67f1b11efaa2004825cb1552b633d628da5333","text":"■ 法院公共车辆管理规则 [附件] <2026年5月6日修订>"},{"id":"A31126-zh-00002","doc":"A31126","law_id":"kr-005817-285841-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2297321","source_hash":"26d0ab5695c55df75ad33f7281d0dccd94cdffc838f3999b8ee15936ebbf562e","text":"车辆使用、尺寸、分配目标以及车辆管理和运营标准（与第二条第二款有关）"},{"id":"A31126-zh-00003","doc":"A31126","law_id":"kr-005817-285841-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2297322","source_hash":"dfa401cd0e8a723cfd38ff4ae39af0ea0efcd86d0767a5a435a57a3fdaf70882","text":"使用"},{"id":"A31126-zh-00004","doc":"A31126","law_id":"kr-005817-285841-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2297323","source_hash":"c238359b8033a59e4febea9d7768f5facd654a81618fe4c1c44b90114fe230e8","text":"规模"},{"id":"A31126-zh-00005","doc":"A31126","law_id":"kr-005817-285841-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2297324","source_hash":"6fe6dade087bcf2985b2060acd89244d1c75a713ce96a57fa0621a0d53c724a7","text":"分配目标"},{"id":"A31126-zh-00006","doc":"A31126","law_id":"kr-005817-285841-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2297325","source_hash":"54e4b859ba29fe3c9f2c63d43d1d51bfb158033a959a3377374baad2e976ae05","text":"车辆管理和操作标准"},{"id":"A31126-zh-00007","doc":"A31126","law_id":"kr-005817-285841-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2297326","source_hash":"829b4c27812a2af42184e82644059376bc56252e5e90df3a3f5ea4a2037f9379","text":"乘用车"},{"id":"A31126-zh-00008","doc":"A31126","law_id":"kr-005817-285841-ko","scope":"ANNEX","start":