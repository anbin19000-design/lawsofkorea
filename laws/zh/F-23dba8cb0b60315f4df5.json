2,"end":11002,"target_id":"23122bd3e230c88f5cac5684fcb276430f2fa27ccb8cf4c7f16160ca5f9cc3cb","source_hash":"93bab4a96d34949dca88dfc5d50da57b05757adebc983770d8a0d3d8c3a67d8c","text":"  第9条中，“军事检察机关检察官”应改为“军事检察官”。 \n\n  ③ 至 ⑪ 省略\n\n"},{"id":"B1-zh-00106","doc":"B1","law_id":"kr-002656-281467-ko","scope":"BODY","start":11002,"end":11044,"target_id":"030531020cc794acecaae571074d9f1177adde77a02eb946871ea46bcdfa67f9","source_hash":"2d021b05d9f4d110ba76ef2d5c8bcc73f0c1403fa6aa2e6689865c3e65ed941d","text":"增编（爱国者和退伍军人事务部及其附属机构的组织结构）<第33382号，2023年4月11日>\n\n"},{"id":"B1-zh-00107","doc":"B1","law_id":"kr-002656-281467-ko","scope":"BODY","start":11044,"end":11079,"target_id":"2dae01bb326ed3b6a9223c3fea6c88a1424953acdb67dc7b1e7f79c834156e2c","source_hash":"6a2259c82e1dab4ee85a2e87dd8112e5eed0ed07c64369126e04de4d06f034d8","text":"第一条（生效日期）本法令自2023年6月5日起生效。\n\n"},{"id":"B1-zh-00108","doc":"B1","law_id":"kr-002656-281467-ko","scope":"BODY","start":11079,"end":11096,"target_id":"813b088156efd5dc80c4d8a9e029f40cadde18876d35019648f191155a0c10a2","source_hash":"6ffda08faf109c176be482db4409396ced46b0373db22ad766c9b45cca3b755a","text":"省略第 2 至 4 条\n\n"},{"id":"B1-zh-00109","doc":"B1","law_id":"kr-002656-281467-ko","scope":"BODY","start":11096,"end":11274,"target_id":"1d9b72020bcfea56d126c654696b601a93a11d26187e6fd5dfeda3e62ed4fd25","source_hash":"4faf112b26a355dd65ec8dfe552a9c9ee659b450c0eaa4e52a7e8b26eb3a6e0c","text":"第五条（修改其他法律）①至⑧ 省略\n\n  ⑨ 对国家安全功勋人员的奖励等支付规定部分修改如下。\n\n  第四条第二款中的“爱国者和退伍军人事务部”应改为“爱国者和退伍军人事务部”。\n\n  第十六条第一款和第二款以及第十七条第二款中的“爱国者和退伍军人事务部部长”应改为“爱国者和退伍军人事务部长”。\n\n  ⑩ 至 <73> 已省略\n\n"},{"id":"B1-zh-00110","doc":"B1","law_id":"kr-002656-281467-ko","scope":"BODY","start":11274,"end":11317,"target_id":"9fad85fd90bd3dc4eccc00b1f50519cafaa8cc7ea73cbb2a2f13345ae8441c04","source_hash":"e94cb060215343794849c45723917db1ef36905da0729360d1209f1fd79739ab","text":"增编（计划和预算部及其附属机构的组织结构）<第35948号，2025年12月30日>\n\n"},{"id":"B1-zh-00111","doc":"B1","law_id":"kr-002656-281467-ko","scope":"BODY","start":11317,"end":11447,"target_id":"e7fcdbecce9533c27084745853421c08ac776c39f55b26353ece57b52038f1f9","source_hash":"d91ca08ab13d680b646c74aa4763cd8612c6e937853e3db26fe10f30e26d8871","text":"第一条（生效日期）本法令自2026年1月2日起生效。但是，根据本补充法令第四条修正的总统令中，修正在本法令生效前颁布但生效日期尚未到来的总统令的部分，应自相关总统令的生效日期起生效。\n\n"},{"id":"B1-zh-00112","doc":"B1","law_id":"kr-002656-281467-ko","scope":"BODY","start":11447,"end":11461,"target_id":"ac7bbfaad3e5146520d74870191c4c019bacfe32af0e9d468b0cc872d878c90d","source_hash":"c27a8d90e2fad39db31a7ec7c05311572dbb07d5ec24565e9bc0e8ebd63ca618","text":"省略第 2 条和第 3 条\n\n"},{"id":"B1-zh-00113","doc":"B1","law_id":"kr-002656-281467-ko","scope":"BODY","start":11461,"end":11645,"target_id":"88725506dcd6fc69c1976d1bd8a2ab7547dffea2d480ed657c27a36092363709","source_hash":"e68ede312dc766a6f2577ba5ce3b40d44721e6f53acbe239c19456ffeec10a96","text":"第四条（修改其他法律）①至<30> 已省略\n\n  <31> 对国家安全功勋人员的奖励等支付规定部分修改如下。\n\n  第四条第二款中，“属于战略财政部、国防部、内务安全部、国家情报局和爱国者与退伍军人事务部”应改为“属于国防部、内务安全部、爱国者与退伍军人事务部、计划预算部和国家情报局”。\n\n  <32> 至 <176> 已省略"}]}