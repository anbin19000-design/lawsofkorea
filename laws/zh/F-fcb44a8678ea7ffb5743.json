,"source_hash":"9ae2bdd7beedc2e766c6b76585530e16925115707dc7a06ab5ee4aa2776b2c7b","text":"150"},{"id":"A39611-zh-00067","doc":"A39611","law_id":"kr-014550-256995-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2869471","source_hash":"27badc983df1780b60c2b3fa9d3a19a00e46aac798451f0febdca52920faaddf","text":"200"},{"id":"A39611-zh-00068","doc":"A39611","law_id":"kr-014550-256995-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2869472","source_hash":"983bd614bb5afece5ab3b6023f71147cd7b6bc2314f9d27af7422541c6558389","text":"300"},{"id":"A39611-zh-00069","doc":"A39611","law_id":"kr-014550-256995-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2869473","source_hash":"d667279449a0ef543ab481ed66ca769235937bce0bf3b7f5f9f63da7e76d7daf","text":"· 发生干扰或需要避免时"},{"id":"B3-zh-00001","doc":"B3","law_id":"kr-014572-257919-ko","scope":"BODY","start":0,"end":29,"target_id":"af9d9bea3045516ce07fc9213b38190edcf12b6a41a83b2ae8e65a1bddb0d1da","source_hash":"f5e657cccab50a7a7701e86d1a1b8e337e73e81b5fbb80dc56a39a26563ee19c","text":"关于促进区域农业、林业和渔业发展项目合作的《法》实施细则"},{"id":"B3-zh-00002","doc":"B3","law_id":"kr-014572-257919-ko","scope":"BODY","start":0,"end":91,"target_id":"4f1915dd8add577ce4369e11ae11e9da2b71f716bbcd7596d052c9bec91c30b1","source_hash":"982787200f410b09d9438424148db70897e05c40dbc71baf696947a07e92772b","text":"第一条（目的）本规则的目的是规定《促进区域农业、林业和渔业发展项目合作法》及其执行令所委托的事项，以及为实施该等事项所必需的事项。\n\n"},{"id":"B3-zh-00003","doc":"B3","law_id":"kr-014572-257919-ko","scope":"BODY","start":91,"end":923,"target_id":"dc39b85c38a3a8ac5b5b5501d5e1353d5337605bf440a6f89cce837b29cbbab9","source_hash":"16e4cbe3730b11af6f63ba40a7ecd4ba8e3fd996df3818f0e0edf0696f04dbdc","text":"第二条（提交商业计划书）\n① 根据《促进区域农业、林业和渔业发展项目合作法》（以下简称“本法”）第八条第一款的规定，商业计划书中应包含以下事项：\n1. 企业名称\n2. 项目实施的必要性和目的\n3. 项目目标\n4. 项目详情、周期和实施计划\n5. 项目实施方法和系统（包括项目部分委托时的计划相关事宜）\n6. 项目绩效目标和绩效评估指标、绩效测量方法和时间安排\n7. 项目成本及项目成本详细计算 · 采购计划\n8. 关于以下各项事项，涉及申请指定为私营运营机构的人员\nA. 公司名称、地址和联系方式\nB. 财务、组织和人事状况\n。包含区域农业、林业和渔业发展项目相关的绩效记录以及类似项目的绩效记录。编号为\n9. 地方政府负责人认为必要的其他事项\n② 私营经营机构应当按照本法第八条第六款的规定，编制包含下列各项内容的实施计划，并报送地方政府负责人。必要时，应附上相关文件和图纸。\n1. 根据该法第7条制定的业务促进计划详情\n2. 根据《\n3. 根据该法第8条第5款制定的实施协议的内容\n③ 如果私营经营机构打算根据该法第8条第6款的规定请求延长期限，则必须在申请批准实施计划的截止日期之前，以书面或电子邮件方式向有关地方政府负责人提出请求，说明延期的理由和预定的提交日期。\n④ 如果根据第 2 款提交的实施计划的内容中遗漏了有关实施协议的事项，或者没有具体说明项目执行的细节和方法，地方政府负责人可以按照本法第 8 条第 7 款的规定，要求私营经营机构补充该计划，并设定期限。\n\n"},{"id":"B3-zh-00004","doc":"B3","law_id":"kr-014572-257919-ko","scope":"BODY","start":923,"end":1141,"target_id":"2da760937d30e6dc8fa96e10dda85ce041e00acf9ae4c9c87ecd32a3554c4c4c","source_hash":"a2db3ec27f47e8ae2f3a71b7e68d9759be3b41d4f20b0339b2a5caacb87972e7","text":"第三条（终止和修改实施协议）\n① 地方政府负责人如欲依据本法第九条第一款终止或修改实施协议，须依据本法第五条，经区域农林水产开发项目审议委员会（以下简称“委员会”）审议通过。在此情况下，须事先以书面形式通知私营经营机构。\n② 地方政府负责人应当以书面形式将委员会根据第1款审议和决议的结果通知私营经营机构。\n\n"},{"id":"B3-zh-00005","doc":"B3","law_id":"kr-014572-257919-ko","scope":"BODY","start":1141,"end":1346,"target_id":"88e0f0e7b86fe2e252e1204819c5eb9125bcfd704256c589a3ecdbeffe1edd98","source_hash":"c54340e5c2d21ae1b4bf1d283e4ccc65e89e66ffc3c0820cf13679be7870a72d","text":"第四条（评价机构的资格等）根据本法第十条第一款设立的绩效衡量评价机构（以下简称“评价机构”）是具备下列各款所列全部资格和标准的法人实体。\n1. 资格：必须在过去 3 年内至少有一项与绩效衡量和评估相关的项目或研究成果。\n2. 规模：必须按照附件表格雇用两名或两名以上专职人员执行绩效测量和评估任务\n\n"},{"id":"B3-zh-00006","doc":"B3","law_id":"kr-014572-257919-ko","scope":"BODY","start":1346,"end":1457,"target_id":"84d7ac31d94fa14fedd8ffead69f13d37432d1fc7b45f928d8cdd85168cd49f1","source_hash":"1981718b81f48d24c7294bd698cd6b846043da081de017907aa3f4fa3ed99aca","text":"第五条（重新协商）关于地方政府首脑与私营经营机构依据本法第十一条第二款订立重新协商协议的，适用本法第八条第四款至第七款的规定和本规则第二条第二款至第四款的规定。\n\n"},{"id":"B3-zh-00007","doc":"B3","law_id":"kr-014572-257919-ko","scope":"BODY","start":1457,"end":1599,"target_id":"318ea38c366bef01cb9887a6588ea657822d3b63d24a81bc2056887ee724a91c","source_hash":"9e8eda75e5da070245d78bd62dbb88c5ad4b559bd91789884c587cca350312be","text":"第六条（审查条例）农业食品农村事务大臣或海洋渔业大臣应当自2024年1月1日起（即每三年1月1日之前），每三年审查一次第四条规定的评估机构的资格和等级的有效性，并采取改进等措施。\n\n"},{"id":"B3-zh-00008","doc":"B3","law_id":"kr-014572-257919-ko","scope":"BODY","start":1599,"end":2332,"target_id":"a468072aaf2137d041b06c8312b8f813e0f335523bd45e53c45d3b1c6b712f81","source_hash":"fb3e9427122c0c3b07ec35444278b56d4146605b7f02c3d0295ae154ca18c0e1","text":"补充规定 <第645号，2023年12月29日>\n\n本规则自颁布之日起生效。\n\n评估机构专职人员的要求（与第四条第二款有关）\n■ 促进区域农业、林业和渔业发展项目合作法实施细则 [附表]                \n\n  评估机构专职人员的要求（与第四条第二款有关）                                     \n\n  1. 作为获得博士学位的人员，绩效衡量和评估职责或绩效衡量和评估     \n\n  具有至少2年相关研究经验的人员（包括获得学位之前的经验）       \n\n  2. 已获得硕士学位并从事绩效衡量与评估工作的人员或从事绩效衡量与评估工作的人员     \n\n  具有至少 4 年相关研究经验的人员（包括获得学位之前的经验）       \n\n  3. 已获得副学士学位或学士学位，并从事绩效衡量和评估工作的人员，或   \n\n  具备开展与绩效衡量和评估相关的研究的经验（包括获得学位之前的经验）       \n\n  拥有6年或以上经验的人员                                                               \n\n  4. 高中毕业（根据其他法律被认可为具有同等教育水平）   \n\n  已履行绩效衡量/评估职责或绩效       \n\n  拥有8年或以上与测量和评估相关的研究经验（包括毕业前的经验）      \n\n  person"},{"id":"A26959-zh-00001","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900614","source_hash":"0051b82911b1f12e57c557fb8410f94dcfb3aaee38c3f1b8dfc89f3cadf55f8d","text":"■ 促进区域农业、林业和渔业发展项目合作法实施细则 [附表]"},{"id":"A26959-zh-00002","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900615","source_hash":"d4745afd2e89392e63c4213afcb4351a2832b9961659afb8fa19131d81845f2f","text":"评估机构专职人员的要求（与第四条第二款有关）"},{"id":"A26959-zh-00003","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900616","source_hash":"2324e155c5af44ef2a5117d12dcbaef1e56f28bb6fb08c29aa3594b1f564e5a3","text":"1. 作为一名获得博士学位的人员，绩效衡量和评估职责或绩效衡量和评估"},{"id":"A26959-zh-00004","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900617","source_hash":"8de43e10c19f7bfc9d38c0cc827a5d274a5ad480da3e22fa68c7ccba2b6c85de","text":"具有至少2年相关研究经验的人员（包括获得学位之前的经验）"},{"id":"A26959-zh-00005","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900618","source_hash":"3250f883c007a9af2942d24ad1e02c3acf6cc0ba3e901be3e422e91c407b7a68","text":"2. 已获得硕士学位并从事绩效衡量与评估工作的人员或从事绩效衡量与评估工作的人员"},{"id":"A26959-zh-00006","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900619","source_hash":"7301eea3409a02974bb8afdb5b5f366a61177b3fef4c5b4a98a84ea47044ca99","text":"具有至少 4 年相关研究经验的人员（包括获得学位之前的经验）"},{"id":"A26959-zh-00007","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900620","source_hash":"243eda7db84d88ddc4cf98b132b7eaeccd664882f3f450a45f2cc56e67ad20a1","text":"3. 已获得副学士学位或学士学位并从事绩效衡量和评估工作的人员或"},{"id":"A26959-zh-00008","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900621","source_hash":"824c0f202875515f615edaa8584099e3fd90ecad1cd18b1a5f6f7bda082005c5","text":"具备开展与绩效衡量和评估相关的研究的经验（包括获得学位之前的经验）"},{"id":"A26959-zh-00009","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900622","source_hash":"f3300e7316ce3ea455702372c7c628d816ac71b940a56725cea6cebd1efd7662","text":"拥有6年或以上经验的人员"},{"id":"A26959-zh-00010","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900623","source_hash":"ceedac043629fd1ca6cffea7472faa1a3212cfb1897c7427cad591e9b3cf18cd","text":"4. 高中毕业（根据其他法律被认可为具有同等学历）"},{"id":"A26959-zh-00011","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900624","source_hash":"7f8f0e6d03f0ab9b84599dc8eda4e9abbdaacc0444279c5e2305ab1a1a1468aa","text":"（包括[以下同样适用]的情况）履行绩效衡量/评估职责或绩效[]的人员"},{"id":"A26959-zh-00012","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900625","source_hash":"fa719c9cd9d10b06d986f2182fbe953c1dac4a771c7642150558ad7d7ee55617","text":"具备8年或以上与测量和评估相关的研究经验（包括毕业前的经验）"},{"id":"A26959-zh-00013","doc":"A26959","law_id":"kr-014572-257919-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:1900626","source_hash":"389e7564ae2551b4f94dbea3458906b7afb8851da988aa1a85992fcc1dd3d346","text":"按需"}]}