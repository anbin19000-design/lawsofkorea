ope":"ANNEX","start":null,"end":null,"target_id":"XML:2803943","source_hash":"f8ac7cdaacf0d813ad43ffd075916c0c1d2e141c4fcb462169ded7d7c0e30553","text":"ㆍ非洲基金会的名称"},{"id":"A38333-zh-00035","doc":"A38333","law_id":"kr-013033-281461-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2803945","source_hash":"195720bd5d86be0feb87e97d5057dffdb97832ef0d6f81fab3a6975da9bc92eb","text":"，则使用"},{"id":"A38333-zh-00036","doc":"A38333","law_id":"kr-013033-281461-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2803946","source_hash":"653e463369df72d7f7b9df8ceb302bc7c50c260a07b14ffe1634428501341eb8","text":"a. 违反了该法第22条的规定"},{"id":"A38333-zh-00037","doc":"A38333","law_id":"kr-013033-281461-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2803947","source_hash":"0e96a97169d57c8859ca0cbc2f67e9f0dd8718b6f9ddf10e22718ddfd4363dd6","text":"《法案》第26条第1款"},{"id":"A38333-zh-00038","doc":"A38333","law_id":"kr-013033-281461-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2803948","source_hash":"a25cec7875d19a40c7155fb55be9c08ffdad13401d890014ad8e867ed4b23139","text":"250,000 韩元"},{"id":"A38333-zh-00039","doc":"A38333","law_id":"kr-013033-281461-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2803949","source_hash":"4cbfddbd6429a9b521e92e14aba82ad9080e987e33600cfa3bdf27209dac725d","text":"500,000韩元"},{"id":"A38333-zh-00040","doc":"A38333","law_id":"kr-013033-281461-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2803950","source_hash":"df20c82e2ad98a7c54be604b1db2d5619eee2ddaa53c506b43242c0dd62a0021","text":"1百万韩元"},{"id":"A38333-zh-00041","doc":"A38333","law_id":"kr-013033-281461-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2803951","source_hash":"ae34631b9154759c26d38d19a7d08cc144cda9d97db3cecd68af66bfc04832f2","text":"类似ㆍ与非洲基金会"},{"id":"A38333-zh-00042","doc":"A38333","law_id":"kr-013033-281461-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2803953","source_hash":"3be86eac39cd1d40d5dc618c5d