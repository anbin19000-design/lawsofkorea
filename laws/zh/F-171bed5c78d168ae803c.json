null,"target_id":"XML:2413705","source_hash":"5ef6be731163bbf3cd8de941da65bf0a83b6c7f0d2e1b4c3c670ccb72d3e57c3","text":"根据其他法律支付费用"},{"id":"A33289-zh-00015","doc":"A33289","law_id":"kr-006811-113802-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2413706","source_hash":"f53de0c740a1602cad4344f8d686f1ee104f85f45b37d60bffe8e85a43306f62","text":"4. 驱逐证明"},{"id":"A33289-zh-00016","doc":"A33289","law_id":"kr-006811-113802-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2413707","source_hash":"1263da11a53f6148c03a3174485ab2d88c712d014a21a8d3072f27fbd67a6a99","text":"如果存在关于 START  的规定"},{"id":"A33289-zh-00017","doc":"A33289","law_id":"kr-006811-113802-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2413708","source_hash":"a713eb8b796d8bb44bb2dd6534e0e8402059360b27d7c7d5fce570206afa42fd","text":"5. 完成证书（预期）"},{"id":"A33289-zh-00018","doc":"A33289","law_id":"kr-006811-113802-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2413709","source_hash":"fe8c39b5138db5832c295309d682e1de139c84c1ded5bd04139c59d4832e224f","text":"（不含费用）"},{"id":"A33289-zh-00019","doc":"A33289","law_id":"kr-006811-113802-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2413710","source_hash":"de2b12f17ede279e746891f0829a5973f9bcd87f571583a42ca51fa54fc05d65","text":"6. 毕业证书（预计）"},{"id":"A33289-zh-00020","doc":"A33289","law_id":"kr-006811-113802-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2413711","source_hash":"755fc7a5e073a7c4f4c9764b7209c1b67b17af2e8134e7d76d997dec1a8b546f","text":"."},{"id":"A33289-zh-00021","doc":"A33289","law_id":"kr-006811-113802-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2413712","source_hash":"f0148d5c122f030009adadd0aea049a6204cbbbea1e55df01badc2be06458e6b","text":"7. 转录"},{"id":"A33289-zh-00022","doc":"A33289","law_id":"kr-006811-113802-ko","scope":"ANNEX","start":null,"end":null,"target_id":"XML:2413713","source_hash":"72966eb718860981c74c4f619e558d917339f78358ca670362ce1cc82ca405