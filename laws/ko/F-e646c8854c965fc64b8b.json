                               \n\n\n                                        \n\n\n  210㎜×297㎜(보존용지(1종) 120g/㎡)\n\n\n\n\n"},{"key":"A33298","kind":"서식","law_id":"kr-006844-249403-ko","title":"공적조서","version":null,"source_hash":"2bf901718b39c6e900da1965c0ed2152011831d5e5e39c4e11ddd92c882de9b1","source_ko":"[별제 제2호서식] <개정 2005.9.6>                \n\n\n┏━━━━━━━━━━━━━━━━━━━━━━━┓\n\n\n┃공적조서                                      ┃\n\n\n┠─────┬┬─────┬──────────┨\n\n\n┃주소      ││근무기간  │                    ┃\n\n\n┠─────┼┼─────┼──────────┨\n\n\n┃소속      ││수공기간  │                    ┃\n\n\n┠─────┼┼─────┼──────────┨\n\n\n┃직(계)급  ││추천표창  │                    ┃\n\n\n┠─────┼┼─────┼──────────┨\n\n\n┃직위      ││사정표창  │                    ┃\n\n\n┠─────┼┼─────┼──────────┨\n\n\n┃성명(한글)││성명(한자)│                    ┃\n\n\n┠─────┼┼─────┼──────────┨\n\n\n┃생년월일  ││군번      │                    ┃\n\n\n┠─────┴┴─────┴──────────┨\n\n\n┃공적사항(6하 원칙에 의하여 작성)              ┃\n\n\n┠───────────────────────┨\n\n\n┃「군표창규칙」제     조제     항(호)   해당자 ┃\n\n\n┗━━━━━━━━━━━━━━━━━━━━━━━┛\n\n\n                                                  \n\n\n─────────────────────────\n\n\n┏━━━━━━━━━━━━━━━━━━━┓\n\n\n┃중요경력                              ┃\n\n\n┠───┬──┬─────┬──────┨\n\n\n┃연월일│이력│연월일    │이력        ┃\n\n\n┠───┼──┼─────┼──────┨\n\n\n┃      │    │          │            ┃\n\n\n┠───┼──┼─────┼──────┨\n\n\n┃      │    │          │            ┃\n\n\n┠───┼──┼─────┼──────┨\n\n\n┃      │    │          │            ┃\n\n\n┠───┴──┴─────┴──────┨\n\n\n┃과거포상기록                          ┃\n\n\n┠───┬──┬─────┬──────┨\n\n\n┃연월일│    │연월일    │            ┃\n\n\n┠───┼──┼─────┼──────┨\n\n\n┃      │    │          │            ┃\n\n\n┠───┼──┼─────┼──────┨\n\n\n┃      │    │          │            ┃\n\n\n┠───┼──┼─────┼──────┨\n\n\n┃      │    │          │            ┃\n\n\n┠───┴──┴────┬┴──────┨\n\n\n┃                      │조사담당      ┃\n\n\n┃   위의 사실을 확인함.├────┬──┨\n\n\n┃                      │소속    │    ┃\n\n\n┃                      ├────┼──┨\n\n\n┃                      │직(계)급│    ┃\n\n\n┃                      ├────┼──┨\n\n\n┃                      │성명    │(인)┃\n\n\n┃                      └────┴──┨\n\n\n┃추천관  직위  성명               (인) ┃\n\n\n┗━━━━━━━━━━━━━━━━━━━┛\n\n\n  210㎜×297㎜(일반용지 60g/㎡(재활용품))\n\n\n\n\n"},{"key":"A33299","kind":"서식","law_id":"kr-006844-249403-ko","title":"공적심사의결서","version":null,"source_hash":"eb89f9b3a6950b23d45ab489033ff20410bf266b478f6eeda2b19e2c1c6f212b","source_ko":"[별지 제3호서식] <개정 2005.9.6>                      \n\n\n  공적심사의결서                                        \n\n\n                                                        \n\n\n┏━━┯━━━━┯━━┯━━┯━━┯━━━━┯━━━━┓\n\n\n┃소속│직(계)급│군번│성명│직위│추천표창│판결표창┃\n\n\n┠──┼────┼──┼──┼──┼────┼────┨\n\n\n┃    │        │    │    │    │        │        ┃\n\n\n┃    │        │    │    │    │        │        ┃\n\n\n┠──┴────┴──┴──┴──┴────┴────┨\n\n\n┃                                                    ┃\n\n\n┠───┬───────┬─────┬────────┨\n\n\n┃계급  │성명          │서명      │비고            ┃\n\n\n┠───┼───────┼─────┼────────┨\n\n\n┃      │              │          │                ┃\n\n\n┠───┼───────┼─────┼────────┨\n\n\n┃      │              │          │                ┃\n\n\n┠───┼───────┼─────┼────────┨\n\n\n┃      │              │          │                ┃\n\n\n┠───┼───────┼─────┼────────┨\n\n\n┃      │              │          │                ┃\n\n\n┠───┼───────┼─────┼────────┨\n\n\n┃      │              │          │                ┃\n\n\n┠───┴───────┴─────┴────────┨\n\n\n┃판정내용                                            ┃\n\n\n┠──────────────────────────┨\n\n\n┃                                                    ┃\n\n\n┃                                                    ┃\n\n\n┃                                                    ┃\n\n\n┃                                                    ┃\n\n\n┃                                                    ┃\n\n\n┃                                                    ┃\n\n\n┃                                               