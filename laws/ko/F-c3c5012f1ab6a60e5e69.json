            ┃\n\n\n  ┃              │┃              │                  ┃\n\n\n  ┠───────┼╂───────┼─────────┨\n\n\n  ┃대법관 ○○○ │┃대법관 ○○○ │                  ┃\n\n\n  ┃              │┃              │                  ┃\n\n\n  ┗━━━━━━━┷┻━━━━━━━┷━━━━━━━━━┛\n\n\n\n\n\n\n\n\n\n\n                                                        \n\n\n    ○ 배석자                                           \n\n\n  ┏┯┯┯━━━━━━━━━━━━━━━━━━━━━━┓\n\n\n  ┃│││                                            ┃\n\n\n  ┠┼┼┼──────────────────────┨\n\n\n  ┃│││                                            ┃\n\n\n  ┠┼┼┼──────────────────────┨\n\n\n  ┃│││                                            ┃\n\n\n  ┠┼┼┼──────────────────────┨\n\n\n  ┃│││                                            ┃\n\n\n  ┠┼┼┼──────────────────────┨\n\n\n  ┃│││                                            ┃\n\n\n  ┠┼┼┼──────────────────────┨\n\n\n  ┃│││                                            ┃\n\n\n  ┗┷┷┷━━━━━━━━━━━━━━━━━━━━━━┛\n\n\n                                                        \n\n\n                                                        \n\n\n                                                        \n\n\n  □ 개의(00:00)                                        \n\n\n    대법원장께서 제      회 대법관회의 개의를 선언함.   \n\n\n                                                        \n\n\n                                                        \n\n\n                                                        \n\n\n  □ 의안심의                                           \n\n\n                                                        \n\n\n                                                        \n\n\n                                                        \n\n\n  □ 산회(00:00)                                        \n\n\n     대법원장께서 제      회 대법관회의 산회를 선언함.  \n\n\n                                                        \n\n\n                                                        \n\n\n                                                        \n\n\n                