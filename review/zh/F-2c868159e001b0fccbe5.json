{
  "schema": "LAW_ZH_MINIMAL_REVIEW_V1",
  "job_id": "F-2c868159e001b0fccbe5",
  "worker": "C03",
  "checked_rows": 704,
  "edits": [
    {
      "id": "B2-zh-00038",
      "text": "第27条（会议）\n① 保健委员会主席在下列任何一种情形下，应当召集会议并担任会议主席。<2012年8月13日修订>\n1. 教育监要求召开会议时；\n2. 三分之一以上在任委员提出要求时；\n3. 此外，主席认为有必要审议保护、促进学生及教职员工健康的事项时。\n② 会议须有过半数在任委员出席方可举行，并由出席委员过半数赞成作出决议。\n\n"
    },
    {
      "id": "B2-zh-00101",
      "text": "补充规定 <第33246号，2023年2月14日>\n\n本令自公布之日起施行。\n\n"
    },
    {
      "id": "B3-zh-00045",
      "text": "补充规定 <第366号，2025年9月19日>\n\n本规则自2025年9月19日起施行。\n\n"
    },
    {
      "id": "A17339-zh-00007",
      "text": "器具等"
    },
    {
      "id": "A17339-zh-00011",
      "text": "2. 患者安置用器具"
    },
    {
      "id": "A17339-zh-00021",
      "text": "体温计、镊子及镊子盒、剪刀、医疗托盘、纱布盒、消毒盘、伤口消毒用"
    },
    {
      "id": "A17339-zh-00032",
      "text": "备注：教育监可根据学校实际情况调整第5项规定的标准。"
    },
    {
      "id": "A17340-zh-00006",
      "text": "经常开启通风窗等，或经常运行机械通风设备，使每人"
    },
    {
      "id": "A17340-zh-00007",
      "text": "每小时通风量达到至少21.6立方米。"
    },
    {
      "id": "A17340-zh-00013",
      "text": "应具备符合该通风控制标准的容量。"
    },
    {
      "id": "A17340-zh-00017",
      "text": "应采用不会污染空气的材料制成。"
    },
    {
      "id": "A17340-zh-00020",
      "text": "室外水平照度与室内照度之比平均应达到5%以上，且不得低于2%"
    },
    {
      "id": "A17340-zh-00021",
      "text": "。"
    },
    {
      "id": "A17340-zh-00027",
      "text": "应避免人工照明造成眩光。"
    },
    {
      "id": "A17340-zh-00029",
      "text": "室内温度应为18℃至28℃；其中，供暖温度应为"
    },
    {
      "id": "A17340-zh-00030",
      "text": "18℃至20℃，制冷温度应为26℃至28℃。"
    },
    {
      "id": "A17341-zh-00003",
      "text": "1. 学校设施（如运动场）中使用的人造草坪及弹性铺装材料，"
    },
    {
      "id": "A17341-zh-00004",
      "text": "应使用依据《产业标准化法》第15条第1款取得认证的产品。"
    },
    {
      "id": "A17341-zh-00007",
      "text": "3. 对于学校设施中符合《环境保健法》第2条第8号规定的儿童活动空间，"
    },
    {
      "id": "A17341-zh-00008",
      "text": "应确认其是否按照该法第23条第1款规定的环境安全管理标准进行维护和管理。"
    },
    {
      "id": "A17341-zh-00009",
      "text": "。"
    },
    {
      "id": "A17342-zh-00018",
      "text": "每年4月至9月，厕所内外每周至少消毒3次；10月至次年3月，"
    },
    {
      "id": "A17342-zh-00019",
      "text": "每周至少消毒1次。"
    },
    {
      "id": "A17343-zh-00006",
      "text": "应努力预防废物产生或减少废物产生量。"
    },
    {
      "id": "A17344-zh-00018",
      "text": "b. 二氧化碳"
    },
    {
      "id": "A17344-zh-00023",
      "text": "在主要采用机械通风的情况下，限值为1,500"
    },
    {
      "id": "A17344-zh-00024",
      "text": "ppm以下。"
    },
    {
      "id": "A17344-zh-00025",
      "text": "c. 甲醛"
    },
    {
      "id": "A17344-zh-00036",
      "text": "e. 降落细菌"
    },
    {
      "id": "A17344-zh-00037",
      "text": "10CFU/室"
    },
    {
      "id": "A17344-zh-00039",
      "text": "f. 一氧化碳"
    },
    {
      "id": "A17344-zh-00044",
      "text": "仅限采用直接燃烧方式供暖的教室"
    },
    {
      "id": "A17344-zh-00045",
      "text": "g. 二氧化氮"
    },
    {
      "id": "A17344-zh-00050",
      "text": "仅限采用直接燃烧方式供暖的教室"
    },
    {
      "id": "A17344-zh-00051",
      "text": "h. 氡"
    },
    {
      "id": "A17344-zh-00059",
      "text": "i. 总挥发性有机化合物"
    },
    {
      "id": "A17344-zh-00063",
      "text": "自建成之日起未满3年的"
    },
    {
      "id": "A17344-zh-00064",
      "text": "学校"
    },
    {
      "id": "A17344-zh-00067",
      "text": "j. 石棉"
    },
    {
      "id": "A17344-zh-00068",
      "text": "0.01个/立方厘米"
    },
    {
      "id": "A17344-zh-00069",
      "text": "《石棉安全管理法》"
    },
    {
      "id": "A17344-zh-00070",
      "text": "第22条第1款后段规定的"
    },
    {
      "id": "A17344-zh-00071",
      "text": "石棉建筑物"
    },
    {
      "id": "A17344-zh-00072",
      "text": "所对应的"
    },
    {
      "id": "A17344-zh-00073",
      "text": "学校"
    },
    {
      "id": "A17344-zh-00074",
      "text": "k. 臭氧"
    },
    {
      "id": "A17344-zh-00081",
      "text": "l. 螨虫"
    },
    {
      "id": "A17344-zh-00082",
      "text": "100只/㎡"
    },
    {
      "id": "A17344-zh-00084",
      "text": "m. 苯"
    },
    {
      "id": "A17344-zh-00090",
      "text": "n. 甲苯"
    },
    {
      "id": "A17344-zh-00096",
      "text": "o. 乙苯"
    },
    {
      "id": "A17344-zh-00102",
      "text": "p. 二甲苯"
    },
    {
      "id": "A17344-zh-00108",
      "text": "q. 苯乙烯"
    },
    {
      "id": "A17344-zh-00116",
      "text": "重点管理标准"
    },
    {
      "id": "A17344-zh-00122",
      "text": "学校的桌椅、桌面等用品，应当"
    },
    {
      "id": "A17344-zh-00123",
      "text": "使用依据《产业标准化法》第15条取得韩国工业标准认证的"
    },
    {
      "id": "A17344-zh-00124",
      "text": "产品。"
    },
    {
      "id": "A17344-zh-00125",
      "text": "应采取必要措施，使教室内的甲醛及挥发性有机化合物"
    },
    {
      "id": "A17344-zh-00126",
      "text": "符合维护标准，"
    },
    {
      "id": "A17344-zh-00127",
      "text": "并在使用时确保符合该标准。"
    },
    {
      "id": "A17344-zh-00128",
      "text": "b. 开校后未满3年的学校"
    },
    {
      "id": "A17344-zh-00129",
      "text": "甲醛及挥发性有机化合物等"
    },
    {
      "id": "A17344-zh-00130",
      "text": "应重点管理，使其符合维护标准。"
    },
    {
      "id": "A17344-zh-00131",
      "text": "c. 开校已满10年以上的学校"
    },
    {
      "id": "A17344-zh-00132",
      "text": "应重点管理，使细颗粒物及悬浮细菌符合维护标准。"
    },
    {
      "id": "A17344-zh-00135",
      "text": "2) 翻修或维修现有设施时，"
    },
    {
      "id": "A17344-zh-00136",
      "text": "根据《室内空气质量管理法》第11条第1款，"
    },
    {
      "id": "A17344-zh-00137",
      "text": "不得使用释放污染物的建筑材料。"
    },
    {
      "id": "A17344-zh-00138",
      "text": "学校的桌椅、桌面等用品，应当"
    },
    {
      "id": "A17344-zh-00139",
      "text": "使用依据《产业标准化法》第15条取得韩国工业标准认证的"
    },
    {
      "id": "A17344-zh-00140",
      "text": "产品。"
    },
    {
      "id": "A17344-zh-00141",
      "text": "d. 符合《石棉安全管理法》第22条第1款后段规定的"
    },
    {
      "id": "A17344-zh-00142",
      "text": "石棉建筑物所对应的学校，应重点管理，确保石棉符合维护标准。"
    },
    {
      "id": "A17344-zh-00146",
      "text": "e. 独立供暖（仅限直接燃烧方式）"
    },
    {
      "id": "A17344-zh-00147",
      "text": "应重点管理，确保一氧化碳及二氧化氮符合维护标准。"
    },
    {
      "id": "A17344-zh-00148",
      "text": "适用于采用上述供暖方式的教室以及"
    },
    {
      "id": "A17344-zh-00149",
      "text": "道路旁教室"
    },
    {
      "id": "A17344-zh-00151",
      "text": "f. 供餐设施"
    },
    {
      "id": "A17344-zh-00152",
      "text": "细颗粒物、二氧化碳、甲醛、总悬浮细菌及降落细菌"
    },
    {
      "id": "A17344-zh-00153",
      "text": "应重点管理，使其符合维护标准。"
    },
    {
      "id": "A17344-zh-00155",
      "text": "g. 保健室"
    },
    {
      "id": "A17344-zh-00156",
      "text": "应重点管理，使降落细菌及螨虫符合维护标准。"
    },
    {
      "id": "A17346-zh-00008",
      "text": "定期检查"
    },
    {
      "id": "A17349-zh-00004",
      "text": "学校负责人应于每学年度3月31日前制定该学年度的急救教育计划，列明教育对象、内容、方法"
    },
    {
      "id": "A17349-zh-00005",
      "text": "及其他必要事项，"
    },
    {
      "id": "A17349-zh-00006",
      "text": "并应予以制定。"
    },
    {
      "id": "A17349-zh-00007",
      "text": "b. 学校负责人制定教育计划时，应确保所有教职员工每学年度都能接受教育。"
    },
    {
      "id": "A17349-zh-00008",
      "text": "但在该学年度内，依据其他法律规定接受过包含心肺复苏等急救内容的培训的教职员工，"
    },
    {
      "id": "A17349-zh-00009",
      "text": "可以免于参加急救教育。"
    },
    {
      "id": "A17349-zh-00017",
      "text": "a) 医生（优先考虑急诊医学专科医生）"
    },
    {
      "id": "A17349-zh-00018",
      "text": "2) 急救（包括心肺复苏）"
    },
    {
      "id": "A17349-zh-00019",
      "text": "实施时的注意事项"
    },
    {
      "id": "A17349-zh-00021",
      "text": "b) 护士（限具备心肺复苏等急救相关资格者）"
    },
    {
      "id": "A17349-zh-00023",
      "text": "c) 根据《急救医疗法》第36条取得急救救助士资格，"
    },
    {
      "id": "A17349-zh-00024",
      "text": "并在急救医疗或救助、急救相关领域"
    },
    {
      "id": "A17349-zh-00025",
      "text": "（包括急救教育讲师经历）"
    },
    {
      "id": "A17349-zh-00026",
      "text": "从业5年以上的人员。"
    },
    {
      "id": "A17349-zh-00028",
      "text": "急救（包括心肺复苏）"
    },
    {
      "id": "A17349-zh-00029",
      "text": "2小时"
    },
    {
      "id": "A17349-zh-00030",
      "text": "具备《急救医疗法》第36条规定的急救救助士资格的人员"
    },
    {
      "id": "A17349-zh-00031",
      "text": "，并在急救医疗或救助、急救相关领域"
    },
    {
      "id": "A17349-zh-00032",
      "text": "（包括急救教育讲师经历）"
    },
    {
      "id": "A17349-zh-00033",
      "text": "从业5年以上的人员"
    }
  ],
  "status": "COMPLETE"
}