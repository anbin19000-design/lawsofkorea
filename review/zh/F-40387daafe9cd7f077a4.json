    },
    {
      "id": "A30903-zh-00069",
      "text": "重新包装后，标示了"
    },
    {
      "id": "A30903-zh-00071",
      "text": "认证产品的包装"
    },
    {
      "id": "A30903-zh-00072",
      "text": "并标示本法第23条第1款或第36条第1款规定标志的情形"
    },
    {
      "id": "A30903-zh-00073",
      "text": "e. 违反本法第23条第1款或第36条第1款规定的标示标准"
    },
    {
