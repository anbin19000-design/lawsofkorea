    },
    {
      "id": "A37057-zh-00131",
      "target_id": "XML:2703506",
      "source_hash": "49af937ede1eee8092c42c63c471cd14c9449c2113df3aaa478f351ce7a62f24",
      "text": "癸. 违反本法第二十四条之二第一款（包括依本法第二十六条第八款"
    },
    {
      "id": "A37057-zh-00132",
      "target_id": "XML:2703507",
      "source_hash": "4fa9b289130d6d54752d7283cef10eb1aa4ba80dbc6db71175a69c76611173d4",
      "text": "本法第七十五条"
    },
    {
      "id": "A37057-zh-00136",
      "target_id": "XML:2703511",
      "source_hash": "19b0ace5d6315aabea35e568abc753867e7e959e719e2cefb94486987bf101e6",
