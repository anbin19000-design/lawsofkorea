      "id": "A37057-zh-00145",
      "target_id": "XML:2703520",
      "source_hash": "90c61927717ffbfd3b9d12b9629a6601e7d12ce4f840c54be2d3e2c5016a301f",
      "text": "第二款第八号"
    },
    {
      "id": "A37057-zh-00146",
      "target_id": "XML:2703521",
      "source_hash": "60e25957918eb9b8a954ecb65e592957e925bdc3e4a2ad557f0d278d6d9ea5af",
