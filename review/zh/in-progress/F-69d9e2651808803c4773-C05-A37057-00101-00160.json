    },
    {
      "id": "A37057-zh-00139",
      "target_id": "XML:2703514",
      "source_hash": "627b94687b687a3c8e438effc218d3a2ae4b9daad66b061907e90cdf9ce2c6a9",
      "text": "子. 违反本法第二十四条之二第二款（包括依本法第二十六条第八款"
    },
    {
      "id": "A37057-zh-00140",
      "target_id": "XML:2703515",
      "source_hash": "4fa9b289130d6d54752d7283cef10eb1aa4ba80dbc6db71175a69c76611173d4",
      "text": "本法第七十五条"
    },
    {
      "id": "A37057-zh-00144",
      "target_id": "XML:2703519",
      "source_hash": "43f887f379b82655912dcf25eb2ecd9df5c56e3665f0de025c6755250c57fea8",
