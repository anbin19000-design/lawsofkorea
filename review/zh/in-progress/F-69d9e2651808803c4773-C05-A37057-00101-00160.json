    },
    {
      "id": "A37057-zh-00147",
      "target_id": "XML:2703522",
      "source_hash": "d8d35856ba2a108aca6b94350377f6fceb31e697c5d34e64369e3c5b271e73a0",
      "text": "丑. 违反本法第二十四条之二第三款（包括依本法第二十六条第八款"
    },
    {
      "id": "A37057-zh-00148",
      "target_id": "XML:2703523",
      "source_hash": "4fa9b289130d6d54752d7283cef10eb1aa4ba80dbc6db71175a69c76611173d4",
      "text": "本法第七十五条"
    },
    {
      "id": "A37057-zh-00152",
      "target_id": "XML:2703527",
      "source_hash": "16e0792c83df9797ecb9b0f40e1e3712a5fe6097559c52acf2ae6fc7d21b75cf",
