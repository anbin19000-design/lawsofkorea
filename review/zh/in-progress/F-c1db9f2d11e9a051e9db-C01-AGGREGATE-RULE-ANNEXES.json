    },
    {
      "id": "A38588-zh-00045",
      "text": "而进入土地的情形"
    },
    {
      "id": "A38588-zh-00046",
      "text": "c. 违反本法第21条第5款"
    },
    {
      "id": "A38588-zh-00047",
