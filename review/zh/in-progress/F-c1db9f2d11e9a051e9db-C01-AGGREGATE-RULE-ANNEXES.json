    {
      "id": "A25758-zh-00126",
      "text": "目的的情形"
    },
    {
      "id": "A25758-zh-00127",
      "text": "计划批准的"
    },
    {
      "id": "A25758-zh-00128",
      "text": "（仅限经中央审议会审议的情形）"
    },
    {
      "id": "A25758-zh-00129",
      "text": "及施行令第25条"
    },
    {
      "id": "A25758-zh-00130",
      "text": "撤销"
    },
    {
      "id": "A25758-zh-00131",
      "text": "的情形"
    },
    {
      "id": "A25758-zh-00132",
      "text": "1) 发生天灾地变或其他同等"
    },
    {
      "id": "A25758-zh-00133",
      "text": "灾害的情形"
    },
    {
      "id": "A25758-zh-00134",
      "text": "2) 因破产或其他经营上的理由"
    },
    {
      "id": "A25758-zh-00135",
      "text": "而"
    },
    {
      "id": "A25758-zh-00136",
      "text": "项目实施者申请撤销港口再开发项目实施计划批准"
    },
    {
      "id": "A25758-zh-00137",
      "text": "的情形"
    }
  ],
