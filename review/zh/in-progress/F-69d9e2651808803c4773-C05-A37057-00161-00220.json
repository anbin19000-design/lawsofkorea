    },
    {
      "id": "A37057-zh-00198",
      "source_hash": "2755fe93dedbda4ac7650e16a85668f7aefa88a8300a58e6ba49c12d18dcac3b",
      "target_id": "XML:2703573",
      "text": "未. 违反本法第二十六条第二款，未公开受托业务的"
    },
    {
      "id": "A37057-zh-00199",
      "source_hash": "4fa9b289130d6d54752d7283cef10eb1aa4ba80dbc6db71175a69c76611173d4",
      "target_id": "XML:2703574",
      "text": "本法第七十五条"
    },
    {
      "id": "A37057-zh-00203",
      "source_hash": "0767e1049372245c67e4b2004d7e4f6dde89c05cf5ba22a4fbb9c475363044c1",
