    },
    {
      "id": "A37057-zh-00205",
      "source_hash": "4a1fd115651ddcd1d63c7b3c9300f440487a72c37ebb77fe05dde57487dd693e",
      "target_id": "XML:2703580",
      "text": "申. 违反本法第二十六条第三款，未向信息主体"
    },
    {
      "id": "A37057-zh-00206",
      "source_hash": "4fa9b289130d6d54752d7283cef10eb1aa4ba80dbc6db71175a69c76611173d4",
      "target_id": "XML:2703581",
      "text": "本法第七十五条"
    },
    {
      "id": "A37057-zh-00210",
      "source_hash": "e657575a17abb31162537dc48ea071608c0288c164fe1508a6da8535d8ac143e",
      "target_id": "XML:2703585",
      "text": "告知应告知事项的情形"
    },
    {
      "id": "A37057-zh-00211",
      "source_hash": "7e27a23bdcafea09631412461a3ce535cf19a742f53d13854ab70a8882d2366d",
      "target_id": "XML:2703586",
      "text": "第二款第十二号"
    },
    {
      "id": "A37057-zh-00212",
      "source_hash": "600710906e25798bfc87c2f95065feeeafe4031dd618eb9040fe57f3f6c0a07a",
      "target_id": "XML:2703587",
      "text": "酉. 违反本法第二十六条第六款，未取得委托人同意"
