    {
      "id": "A37057-zh-00213",
      "source_hash": "4fa9b289130d6d54752d7283cef10eb1aa4ba80dbc6db71175a69c76611173d4",
      "target_id": "XML:2703588",
      "text": "本法第七十五条"
    },
    {
      "id": "A37057-zh-00217",
      "source_hash": "29dc0433e877cc3d2f887277acc7164698e4a087093e1eabf974a0c455584f80",
