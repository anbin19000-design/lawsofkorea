    },
    {
      "id": "A37057-zh-00190",
      "source_hash": "6c20890d3ef2f4a59a103f2346713803e97d1e830a2823e5d0648178f77e2fb3",
      "target_id": "XML:2703565",
      "text": "午. 违反本法第二十六条第一款，委托业务时"
    },
    {
      "id": "A37057-zh-00191",
      "source_hash": "4fa9b289130d6d54752d7283cef10eb1aa4ba80dbc6db71175a69c76611173d4",
      "target_id": "XML:2703566",
      "text": "本法第七十五条"
    },
    {
      "id": "A37057-zh-00195",
      "source_hash": "6739c3816c5a363889267fe6f8728f22d8e7f0c639df4d6bffcef920856c2c30",
      "target_id": "XML:2703570",
