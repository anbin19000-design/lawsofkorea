    },
    {
      "id": "B2-zh-00186",
      "source_hash": "5d1ff1b83d9d5ec24f8ee9edc071acfed0a3db05b60357cecff772a857c64b1e",
      "target_id": "a0836667ce974114143292989fe08d04eab5a9360e7482b89f4e291867a7b59a",
      "text": "第三条（其他法令的修改）① 略\n\n  ②《个人信息保护法施行令》部分修改如下。\n\n  将第二十二条第一款第二号修改如下。\n\n    2. 依照《精神健康增进及精神疾病患者福利服务支援相关法律》第三条第五号至第七号规定的精神医疗机构（仅限设有收容设施的机构）、精神疗养设施及精神康复设施\n\n  ③至<24> 略\n\n"
    },
    {
      "id": "B2-zh-00188",
      "source_hash": "ba6741fc6520dcd66bf30eef426c08b23ec3fb868893873efb96d4b2357824a9",
      "target_id": "64497bbf03217f62515b94ce4eeebb525a79dbd85c1107442191556db3226313",
      "text": "附则（《居民登记法施行令》）<第28150号，2017年6月27日>\n\n"
    },
    {
      "id": "B2-zh-00189",
      "source_hash": "5e579d16fa1756875131dad761e800164b78dbf2b62d54557a6072dba7d3b84d",
      "target_id": "e706bb592bf11dc219e5b28c6723929641e5719d1478fd88d94a426e5e2202a3",
      "text": "第一条（施行日期）本施行令自2017年7月1日起施行。但附则第三条的修订规定自公布之日起施行。\n\n"
    },
    {
      "id": "B2-zh-00191",
      "source_hash": "9419d683fd52b2db4abc479359729e7c9adf9539a6c84a13e182a89e6a9240bd",
      "target_id": "b500e4c6301b74c795bc3a38873032eedca83633aa6b263336acc3a3c3907d4c",
      "text": "第三条（其他法令的修改）①《个人信息保护法施行令》部分修改如下。\n\n  将第十九条第一号中的“《居民登记法》第七条第三款”改为“《居民登记法》第七条之二第一款”。\n\n  ②至⑤ 略\n\n"
    },
    {
      "id": "B2-zh-00192",
      "source_hash": "2229ee61688f381fa8791a317dce02e692966c0fc8dfff0224bc44e3cd9315a8",
      "target_id": "22407954b980a474d862ed545871bbd1901c668a390568b313e3b346a319218d",
      "text": "附则（行政安全部及其所属机构编制）<第28211号，2017年7月26日>\n\n"
    },
    {
      "id": "B2-zh-00193",
      "source_hash": "d4d103d3e37771adbbb46411d05494fb1bd3e0332ddee1f3d4d168acbb01195b",
      "target_id": "f7a2987cfd030908cf6ebcb76580a4437c92c4edb1e81a4a00e27d1d98677d48",
      "text": "第一条（施行日期）本施行令自公布之日起施行。但依附则第八条修改的总统令中，对本施行令施行前已公布而施行日期尚未到来的总统令所作的修改部分，分别自相应总统令的施行日期起施行。\n\n第二条至第七条 略\n\n"
    },
    {
      "id": "B2-zh-00194",
      "source_hash": "80fa4ebf0f31799519b07077f93d62b4390c50588c9e963aa90d27fee6c33676",
      "target_id": "0f00b78ea16b329160d0ce550b3e5a3c79eb2a0f7cdfe204d27b54af368a437d",
      "text": "第八条（其他法令的修改）①至<94> 略\n\n  <95>《个人信息保护法施行令》部分修改如下。\n\n  将第十四条、第十六条第二款、第二十一条第三款及该条第五款第二号、第二十一条之二第三款、第二十七条、第三十条第二款及第三款、第三十二条第三款、第三十四条第一款前段及该条第二款和第三款、第三十四条之二第一款及第六款、第三十四条之三第二款、第三十四条之四第二款、第三十四条之五第二款、第三十四条之六第一款第二号各目以外的部分及该号（乙）目、该条第二款、第三十四条之七前段、第三十四条之八第三款、第三十七条第一款各号以外的部分、该条第二款各号以外的部分、该条第三款各号以外部分的正文、该条第四款各号以外部分的前段、该条第五款各号以外部分的正文、该条第六款各号以外部分的正文、该条第七款、第三十八条第二款各号以外的部分及该条第三款、第四十条之二第二款及该条第三款正文、第四十一条第二款前段及后段、第四十八条第二款、第五十八条第二款正文、第五十九条、第六十条第二款、第六十一条第一款各号以外的部分及该条第二款和第三款、第六十二条第二款各号以外的部分及该款第三号、该条第三款各号以外的部分及该条第四款、第六十二条之二第一款各号以外的部分、第六十二条之三第一款及该条第二款各号以外的部分中的“行政自治部长官”分别改为“行政安全部长官”。\n\n"
    },
    {
      "id": "B2-zh-00195",
      "source_hash": "ec5221d27419aa896faf484864cf2e3f5a803e2abf24aeeb106819587805f1eb",
      "target_id": "23e0836943a4122380218fe4cd55d8e808118a4bbd827bd9f3177d42f3e5565f",
      "text": "  将第十五条各号以外的部分、第三十四条第一款前段、第三十七条第二款各号以外的部分、该款第四号、该条第六款各号以外部分的正文、第四十一条第一款各号以外的部分、该条第四款、第四十二条第二款、第四十三条第一款及第三款、第四十四条第一款及第二款、第四十五条第二款中的“行政自治部令”分别改为“行政安全部令”。\n\n"
    },
    {
      "id": "B2-zh-00196",
      "source_hash": "e5db78a516d9e6051935bbadc57c0a7eb9b86b067977e69efc766682e4f9c132",
      "target_id": "4c1cb5bd6201e019ec6a38231ce38e0c6ced06ba1a1db4637bedcfff398f9777",
      "text": "  将第四十八条之二中的“行政自治部”改为“行政安全部”。\n\n"
    },
    {
      "id": "B2-zh-00197",
      "source_hash": "51456eb866c3492be8f8b66b1fbca5e2aa1cf8854f77005e8a9974f4e9874f45",
      "target_id": "29a67a4f2c1e345fc5c1e5b513402ff5aabf2bea2264dd2627df416edd7120e5",
      "text": "  将附表1第六号、附表2第一号（乙）目第1）至第4）项以外部分的正文及同号（丙）目第1）至第3）项以外部分的正文中的“行政自治部长官”分别改为“行政安全部长官”。\n\n  <96>至<388> 略\n\n"
    },
    {
      "id": "B2-zh-00198",
      "source_hash": "ff21fc4b9a72f9dc2fbaa91b074c912d7431dc670cbd7c89345dc6c727565a41",
      "target_id": "287bb46aff8e1d06e721497d103dd67c57d86f2741aaf6fc010cce17e13c597d",
      "text": "附则 <第28355号，2017年10月17日>\n\n"
    },
    {
      "id": "B2-zh-00199",
      "source_hash": "4a92cb72682933db317fa232985cf77a39c85fda46fd753a1e8daa9501dec1ce",
      "target_id": "c989a9f1623fa8613b11c1659a5302f72538ba70cea2debf62788277543b8151",
      "text": "第一条（施行日期）本施行令自2017年10月19日起施行。\n\n"
    },
    {
      "id": "B2-zh-00200",
      "source_hash": "a9a9e03475bcbbf1f03f73723f8e33a850ca83090e44690468b9b176fd157a1d",
      "target_id": "38d328d3825c4d018a947f6273bd2af325ca7a131c3ad6d35eaf38e76dc004cf",
      "text": "第二条（关于个人信息泄露申报等的适用规定）第三十九条第一款及第四十条第三款的修订规定，适用于本施行令施行后发生个人信息泄露的情形。\n\n"
    },
    {
      "id": "B2-zh-00201",
      "source_hash": "86426a08b385d02a92bb72f8b3f5acdc81969d489b09446a9eab12271985ec4a",
      "target_id": "0ef9c0a35e10d7076ec24ee46da3ee46ba8fcfb657ad988583a2a325810a0752",
      "text": "第三条（关于请求查阅个人信息等的过渡措施）对本施行令施行前已请求查阅、更正或删除个人信息，或者已请求停止处理个人信息的人，尽管第四十一条第一款、第四十三条第一款及第四十四条第一款已有修订，仍适用原有规定。\n\n"
    },
    {
      "id": "B2-zh-00202",
      "source_hash": "3565619b0b2aced4b6a85041594cefb77528e94c713b2a6634730d9553912307",
      "target_id": "eb21cb4b7574ccff4bc72868968ac6f4952891b6f61a6cd1d733505b333e4149",
      "text": "附则（关于为设定规制重新审查期限等而部分修改57项法令的总统令）<第29421号，2018年12月24日>\n\n本施行令自2019年1月1日起施行。\n\n"
    },
    {
      "id": "B2-zh-00203",
      "source_hash": "c1d0ed5a6c1d678458265c7a4677479d9cb89fdcb96e3588870e7cb7e8edfd3e",
      "target_id": "85604a3fd5b8be167a7a682f30782bfb8aa26d06a1713ad1f3b1652b90d9a181",
      "text": "附则（关于为解除规制重新审查期限等而部分修改144项总统令的总统令）<第30509号，2020年3月3日>\n\n本施行令自公布之日起施行。\n\n"
    },
    {
      "id": "B2-zh-00204",
      "source_hash": "9015fc56bf8ed2a3fac0b39132a67630ae1e47d6015c312d062b30ef2d999825",
      "target_id": "04cb597e99e6b2b3d43008c86ce69786cb6ce001bf8fb5cf65ba96e20808ca85",
      "text": "附则（关于因设立高级公职人员犯罪调查处而部分修改15项总统令的总统令）<第30833号，2020年7月14日>\n\n本施行令自2020年7月15日起施行。\n\n"
    },
    {
      "id": "B2-zh-00205",
      "source_hash": "08a3c9418285ed50e8baba2fb7d86ac451fbd6e0191254b090e127f592a9fec8",
      "target_id": "9bb9e69046e8d73b276ffca90555154c380ac9a4bb1b8918f1037ad1da464271",
      "text": "附则 <第30892号，2020年8月4日>\n\n"
    },
    {
      "id": "B2-zh-00206",
      "source_hash": "56425fcf2b700b2d4eede717979629172c2f91522e70b2795ea685cbb244cc2b",
      "target_id": "d09cf5716118ade2b935a21b3f84517a1506e729c3838f0eb02f6feae95b7170",
      "text": "第一条（施行日期）本施行令自2020年8月5日起施行。但第五条之三的修订规定自公布之日起满六个月之日施行。\n\n"
    },
    {
      "id": "B2-zh-00207",
      "source_hash": "de7a0853927924089a06812a00c9d788a26a732ab9ce3fc794ede48351753118",
      "target_id": "02c6ceb22be755cd355b9a378ffe5b4820c0216b1ea2a85989569e7ed9174687",
      "text": "第二条（一般过渡措施）本施行令施行前，信息通信服务提供者等依照《信息通信网络利用促进及信息保护等相关法律施行令》实施的指定、措施、通知、申报及其他行为，视为依照本施行令相应规定实施的行为。\n\n"
    },
    {
      "id": "B2-zh-00208",
      "source_hash": "f9dd5cfeb788547f7ddc1c7b4370fa9a479368e4abed8d6868ca500590c5da3d",
      "target_id": "c4e9c9c53002fac2813c1cab98b1612bdd50b94eade2a5cc62eb212b53b527b9",
      "text": "第三条（关于处理敏感信息的过渡措施）本施行令施行前依照本施行令或其他法令合法处理的个人信息中，属于第十八条第三号及第四号修订规定的信息，视为依照本施行令或其他法令处理的信息。\n\n"
    },
    {
      "id": "B2-zh-00209",
      "source_hash": "ed4c16d09f322cb7f84e3af7ac7a133d1b752e3ffa4c0fdb71f2334e86ee9b79",
      "target_id": "54939adf30e4c20b1293ce1bdb608c47356c3ea2be044e2b01ba8b1b70ecb02a",
      "text": "第四条（关于罚款附加金计算标准的过渡措施）对本施行令施行前的违法行为依照《信息通信网络利用促进及信息保护等相关法律》作出的行政处分，应计入附表1之5修订规定所规定的违法行为次数。\n\n"
    },
    {
      "id": "B2-zh-00210",
      "source_hash": "c3648acdd920ddaa3b7eb42e5a2e663b90945d3b9b92b156edb986910cf22af7",
      "target_id": "672a06c600fe7dcfd9695a5d42631d65bba874b55d79c57499818253280a35ed",
      "text": "第五条（关于行政罚款征收标准的过渡措施）对本施行令施行前的违法行为依照《信息通信网络利用促进及信息保护等相关法律》或原有规定作出的行政罚款处分，应计入附表2修订规定所规定的违法行为次数。\n\n"
    },
    {
      "id": "B2-zh-00211",
      "source_hash": "91199f407311070afb1ae76bc31a660cf0739da39ee87cc14e291d68c5df734b",
      "target_id": "72b7ae85e336f27f3824577ae3f8eee44f84008b7b893b755ef9d068e16ee799",
      "text": "第六条（其他法令的修改）①《法人税法施行令》部分修改如下。\n\n  删除第二十三条第一款第一号（庚）目。\n\n  ②《自动驾驶汽车商业化促进及支援相关法律施行令》部分修改如下。\n\n"
    },
    {
      "id": "B2-zh-00212",
      "source_hash": "c2a2ef1301f700593e01821ff79b77879634e23af9356f36eb1adbfd4bdb180a",
      "target_id": "fc4319f022eaa74c37914d246a889f923cf37e90a0030427267296f0a44b09b1",
      "text": "  将第十六条中的“《信息通信网络利用促进及信息保护等相关法律》第二条第一款第六号”改为“《个人信息保护法》第二条第一号”。\n\n  ③《电子商务等消费者保护相关法律施行令》部分修改如下。\n\n  删除第五条之二第一号，并将该条第二号中的“第三十六条第二款及第三十七条第四款”改为“第三十六条第二款、第三十七条第四款及第三十九条之七第三款”。\n\n  ④《租税特例限制法施行令》部分修改如下。\n\n  将第一百条之十四第二款第十八号中的“《信息通信网络利用促进及信息保护等相关法律》”改为“《个人信息保护法》”。\n\n  ⑤《居民登记法施行令》部分修改如下。\n\n  将第十二条之三第二款第一号中的“《个人信息保护法》第三十四条第一款及该法施行令第四十条”改为“《个人信息保护法》第三十四条第一款、第三十九条之四第一款及该法施行令第四十条、第四十八条之四”，并删除该款第三号。\n\n"
    },
    {
      "id": "B2-zh-00213",
      "source_hash": "f4f181dfc12c355714b1c804050b1e91cce81b5766afb1fda95732b47ec18b1e",
      "target_id": "36f86fe81ce14d19b42b35e603537d0535a6a6c9053a53b47c809753a3713a30",
      "text": "第七条（与其他法令的关系）本施行令施行时，其他法令就个人信息保护引用《信息通信网络利用促进及信息保护等相关法律施行令》或其规定的，如本施行令中存在相应规定，则视为引用本施行令或本施行令的相应规定，以代替原有规定。\n\n"
    },
    {
      "id": "B2-zh-00214",
      "source_hash": "1f4fd7f6169513ea81d9b7f808a047fd6b0c82b4c05b1c669e087809f1fd1e3f",
      "target_id": "35a8905065b17f5842b912b799f1d11bd15230a284d227393170978a4120541f",
      "text": "附则（《小商工人基本法施行令》）<第31429号，2021年2月2日>\n\n"
    },
    {
      "id": "B2-zh-00215",
      "source_hash": "30813f9cabfe3652a1d2960f46633c4730d2cdbdd34483a921b54338b7ce2881",
      "target_id": "c71ab60fc1b7b6c2f0b7bf1461dd323776885308d1f3b92e715f14d7afd5a139",
      "text": "第一条（施行日期）本施行令自2021年2月5日起施行。\n\n"
    },
    {
      "id": "B2-zh-00216",
      "source_hash": "5f887e51003a65baf221f06d0e97c82095d93e754a1eed05a6ddf8aa755c0f15",
      "target_id": "327a65e80d57d9d1026ccecff204808d09f1db9f842b0ffb68dfe1d3f8cc0f33",
      "text": "第二条（其他法令的修改）①《个人信息保护法施行令》部分修改如下。\n\n  将第二十九条之五第一款第三号但书中的“《小商工人保护及支援相关法律》第二条规定的小商工人”改为“《小商工人基本法》第二条规定的小商工人”。\n\n  将第三十二条第三款正文中的“《小商工人保护及支援相关法律》第二条规定的小商工人”改为“《小商工人基本法》第二条规定的小商工人”。\n\n  ②至⑭ 略\n\n"
    },
    {
      "id": "B2-zh-00218",
      "source_hash": "7c37f78d1ac028e38d6e325535a9e3a5350178f4def208788cdb1e5c8f7fd70b",
      "target_id": "0398036cd5f721be8e519e50a498e0df1dfee22d76db1c47860ec0f6e9c4a8fb",
      "text": "附则（关于解除规制重新审查期限设定等而部分修改91项法令的总统令）<第32528号，2022年3月8日>\n\n本施行令自公布之日起施行。\n\n"
    },
    {
      "id": "B2-zh-00219",
      "source_hash": "870d0d4686aa28e42eeb9d334bf740f66eae1ddbe4b86dfde1e3fd6182ebe408",
      "target_id": "5c978355aa514d026a92fa88fb96725bfe530aae2bec905e8e2776362cc32af5",
      "text": "附则 <第32813号，2022年7月19日>\n\n"
    },
    {
      "id": "B2-zh-00220",
      "source_hash": "5dcdbfb12357db9dfca11fbb6dcfa3f9aa0622e69f909f877bee7735ced74eb7",
      "target_id": "73636db56955d138dc8df6c0514fc0e593112af95dbe16f72c5b65f6a517d500",
      "text": "第一条（施行日期）本施行令自公布之日起满三个月之日施行。但第十六条第一款及第六十二条的修订规定自公布之日起施行。\n\n"
    },
    {
      "id": "B2-zh-00221",
      "source_hash": "0d78f9e56c2157654cd382eb9556739e0083f0e67dd9ad4521c7abdca0fc8e70",
      "target_id": "64c8052316f381dacd135ee44f047413d9fb1f88269aeea201ba1cac16e2248e",
      "text": "第二条（关于罚款附加金计算标准的适用规定）附表1、附表1之3及附表1之5的修订规定，也适用于本施行令施行前的违法行为。\n\n"
    },
    {
      "id": "B2-zh-00222",
      "source_hash": "10bbdb631c1b86a42655a24f5e74657c423065c0d1898a61584e6d457892221c",
      "target_id": "c33a820f6c788dcfad4014f85b51d8b8c716636a8e9aa935b79a993343e7d9fc",
      "text": "附则 <第33723号，2023年9月12日>\n\n"
    },
    {
      "id": "B2-zh-00223",
      "source_hash": "102c021ef9e5052f6a0aaded703de6e5c7b1664f9cd424b53b8b3ce2a88b10bc",
      "target_id": "0b31e8c3144a5ce33357073adfec4dd1cea6ebc8e963222529d0f9d5d01df380",
      "text": "第一条（施行日期）本施行令自2023年9月15日起施行。但下列各号的修订规定，自相应各号规定的日期起施行。\n\n  1. 第十七条第一款及第三十条之二的修订规定：2024年9月15日\n\n  2. 第十五条之二第一款后段的修订规定：2024年1月1日\n\n  3. 附表2第二号가目、고目、보目、소目及초目的修订规定：2024年3月15日\n\n"
    },
    {
      "id": "B2-zh-00224",
      "source_hash": "a33938f7a2130bda37eecd1be45a71abccc0d58aae6bc6e23b6aba136a0d02b8",
      "target_id": "536ff69357e4ee580e014172cd64c5979cbc70542fb484b7362e0113954b0a36",
      "text": "第二条（关于征收行政罚款的过渡措施）对本施行令施行前已终止的、属于原附表2第二号가目、나目、아目及초目规定的违法行为，尽管附表2已有修订，仍依照原有规定征收行政罚款。\n\n"
    },
    {
      "id": "B2-zh-00225",
      "source_hash": "c2bf22614ea50788b31b1287e35f407f972ca6cd380177ea82d491175ff25aab",
      "target_id": "107d4878bc3110ee7a2d4bc9df11e9d4e0d59f8411f3fb1840768d25cb21cf87",
      "text": "第三条（其他法令的修改）①《传染病预防及管理相关法律施行令》部分修改如下。\n\n  将第三十二条之二第三号中的“影像信息处理设备”改为“固定式影像信息处理设备”。\n\n  ②《国民体育振兴法施行令》部分修改如下。\n\n  将第十八条之六的标题中的“影像信息处理设备”改为“固定式影像信息处理设备”，并将该条各号以外的部分中的“影像信息处理设备”改为“固定式影像信息处理设备”。\n\n  ③《农渔业人生活质量提高及农渔村地区开发促进相关特别法施行令》部分修改如下。\n\n  将附表第三号사目目标值栏中的“第三条第一号”改为“第三条第一款第一号”。\n\n  ④《儿童福利法施行令》部分修改如下。\n\n  将第三十条标题中的“影像信息处理设备”改为“固定式影像信息处理设备”，并将该条第一款至第三款中的“影像信息处理设备”分别改为“固定式影像信息处理设备”。\n\n  将第三十一条标题中的“影像信息处理设备”改为“固定式影像信息处理设备”，并将该条标题以外部分中的“影像信息处理设备”改为“固定式影像信息处理设备”。\n\n  ⑤《电子商务等消费者保护相关法律施行令》部分修改如下。\n\n  将第五条之二第二号中的“第三十七条第四款”改为“第三十七条第五款”。\n\n  ⑥《电子签名法施行令》部分修改如下。\n\n"
    }
  ],
