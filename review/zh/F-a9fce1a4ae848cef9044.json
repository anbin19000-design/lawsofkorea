      "text": "首次违法"
    },
    {
      "id": "A30797-zh-00026",
      "text": "第二次违法"
    },
    {
      "id": "A30797-zh-00027",
      "text": "第三次及以上"
    },
    {
      "id": "A30797-zh-00028",
      "text": "违法"
    },
    {
      "id": "A30797-zh-00029",
      "text": "除韩国产业人力公团以外的人，违反本法"
    },
    {
      "id": "A30797-zh-00030",
      "text": "本法第28条第1款"
    },
    {
