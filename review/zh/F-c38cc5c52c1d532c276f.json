{
  "schema": "LAW_ZH_MINIMAL_REVIEW_V1",
  "job_id": "F-c38cc5c52c1d532c276f",
  "worker": "C02",
  "checked_rows": 494,
  "edits": [
    {
      "id": "A38067-zh-00001",
      "text": "■ 《茶产业发展及茶文化振兴法施行令》［附表1］<2025年12月23日修订>"
    },
    {
      "id": "A38067-zh-00002",
      "text": "教育培训机构指定标准（与第5条第1款有关）"
    },
    {
      "id": "A38067-zh-00003",
      "text": "1. 教育设施及设备：应具备下列各项设施及设备。此时，"
    },
    {
      "id": "A38067-zh-00004",
      "text": "通过租赁合同或共同使用合同取得下列各项设施或设备的使用权，"
    },
    {
      "id": "A38067-zh-00005",
      "text": "且使用权得到保障的，在合同期限内视为符合相关标准。"
    },
    {
      "id": "A38067-zh-00006",
      "text": "（一）教室：至少设置一间面积为30平方米以上的教室。"
    },
    {
      "id": "A38067-zh-00007",
      "text": "面积是指实测内墙之间的地面面积。以下同。"
    },
    {
      "id": "A38067-zh-00008",
      "text": "农业、食品和农村事务部长可考虑事业规模及受训人数等，"
    },
    {
      "id": "A38067-zh-00009",
      "text": "在不妨碍第2项教育课程运营的范围内放宽教室面积标准。"
    },
    {
      "id": "A38067-zh-00010",
      "text": "（二）实习室：至少设置一间面积为60平方米以上的实习室。"
    },
    {
      "id": "A38067-zh-00011",
      "text": "部长可考虑事业规模及受训人数等，在不妨碍教育课程运营的范围内"
    },
    {
      "id": "A38067-zh-00012",
      "text": "放宽实习室面积标准。"
    },
    {
      "id": "A38067-zh-00013",
      "text": "（三）卫生间：男女分设，规模应符合教育课程需要。"
    },
    {
      "id": "A38067-zh-00014",
      "text": "（四）供水设施：使用自来水以外的水源时，水质应符合"
    },
    {
      "id": "A38067-zh-00015",
      "text": "《饮用水管理法》第5条第3款规定的水质标准。"
    },
    {
      "id": "A38067-zh-00016",
      "text": "（五）照明设施：夜间授课时，课桌面及黑板面的照度应达到150勒克斯以上。"
    },
    {
      "id": "A38067-zh-00017",
      "text": "（六）消防设施：应符合《消防设施安装及管理法》第12条第1款规定的"
    },
    {
      "id": "A38067-zh-00018",
      "text": "消防安全标准。"
    },
    {
      "id": "A38067-zh-00019",
      "text": "（七）教育设备：应具备电脑等教育所需设备。"
    },
    {
      "id": "A38067-zh-00020",
      "text": "2. 教育课程：至少运营下列一项教育课程。"
    },
    {
      "id": "A38067-zh-00021",
      "text": "（一）茶叶种植相关教育课程"
    },
    {
      "id": "A38067-zh-00022",
      "text": "（二）茶叶生产相关教育课程"
    },
    {
      "id": "A38067-zh-00023",
      "text": "（三）茶叶加工相关教育课程"
    },
    {
      "id": "A38067-zh-00024",
      "text": "（四）茶礼或茶文化相关教育课程"
    },
    {
      "id": "A38067-zh-00025",
      "text": "（五）其他茶相关技术普及、传授所需教育课程"
    },
    {
      "id": "A38067-zh-00026",
      "text": "3. 教育时间：教育时间（包括实习）应安排为至少2小时。"
    },
    {
      "id": "A38067-zh-00027",
      "text": "4. 讲师：至少应有一人符合下列任一条件。"
    },
    {
      "id": "A38067-zh-00028",
      "text": "机构或团体代表符合下列任一条件并实际履行讲师职责时，"
    },
    {
      "id": "A38067-zh-00029",
      "text": "可将该代表计入讲师人数。"
    },
    {
      "id": "A38067-zh-00030",
      "text": "（一）取得与第2项教育课程相关学科的学士以上学位后，"
    },
    {
      "id": "A38067-zh-00031",
      "text": "在登记为法人的机构或团体等从事教育相关工作或授课一年以上，"
    },
    {
      "id": "A38067-zh-00032",
      "text": "具有相关经验者。"
    },
    {
      "id": "A38067-zh-00033",
      "text": "（二）从事与第2项教育课程相关工作两年以上者。"
    },
    {
      "id": "A38068-zh-00001",
      "text": "■ 《茶产业发展及茶文化振兴法施行令》［附表2］"
    },
    {
      "id": "A38068-zh-00002",
      "text": "教育培训机构指定撤销及业务停止标准（与第5条第5款有关）"
    },
    {
      "id": "A38068-zh-00003",
      "text": "1. 一般标准"
    },
    {
      "id": "A38068-zh-00004",
      "text": "（一）对最近一年内因相同违规行为受到行政处分的，适用按违规次数加重的标准。"
    },
    {
      "id": "A38068-zh-00005",
      "text": "违规次数以作出处分之日及处分后再次查获相同违规行为之日为基准计算。"
    },
    {
      "id": "A38068-zh-00006",
      "text": "（二）存在两项以上违规行为且各自处分标准不同时，适用较重标准。"
    },
    {
      "id": "A38068-zh-00007",
      "text": "但各处分均为停业处分时，可在较重处分标准的二分之一范围内加重，"
    },
    {
      "id": "A38068-zh-00008",
      "text": "且停业期限不得超过各处分期限合计。"
    },
    {
      "id": "A38068-zh-00009",
      "text": "（三）存在下列加重或减轻事由时，处分机关可在第2项标准规定的"
    },
    {
      "id": "A38068-zh-00010",
      "text": "停业期限二分之一范围内加重或减轻。"
    },
    {
      "id": "A38068-zh-00011",
      "text": "1）加重事由"
    },
    {
      "id": "A38068-zh-00012",
      "text": "（一）违规行为系故意或重大过失所致。"
    },
    {
      "id": "A38068-zh-00013",
      "text": "（二）违规行为性质或程度严重，且对受训人员造成重大损害。"
    },
    {
      "id": "A38068-zh-00014",
      "text": "2）减轻事由"
    },
    {
      "id": "A38068-zh-00015",
      "text": "（一）违规行为系轻微过失或错误所致。"
    },
    {
      "id": "A38068-zh-00016",
      "text": "（二）客观上认定教育培训机构连续三年以上模范运营。"
    },
    {
      "id": "A38068-zh-00017",
      "text": "2. 具体标准"
    },
    {
      "id": "A38068-zh-00018",
      "text": "违规行为"
    },
    {
      "id": "A38068-zh-00019",
      "text": "法律依据"
    },
    {
      "id": "A38068-zh-00020",
      "text": "按违规次数确定的行政处分标准"
    },
    {
      "id": "A38068-zh-00021",
      "text": "第一次违规"
    },
    {
      "id": "A38068-zh-00022",
      "text": "第二次违规"
    },
    {
      "id": "A38068-zh-00023",
      "text": "第三次以上违规"
    },
    {
      "id": "A38068-zh-00024",
      "text": "（一）以虚假或其他不正当手段取得指定的情形"
    },
    {
      "id": "A38068-zh-00025",
      "text": "本法第8条第4款第1项"
    },
    {
      "id": "A38068-zh-00026",
      "text": "撤销指定"
    },
    {
      "id": "A38068-zh-00027",
      "text": "（二）不符合指定标准的情形"
    },
    {
      "id": "A38068-zh-00028",
      "text": "本法第8条第4款第2项"
    },
    {
      "id": "A38068-zh-00029",
      "text": "警告"
    },
    {
      "id": "A38068-zh-00030",
      "text": "停业三个月"
    },
    {
      "id": "A38068-zh-00031",
      "text": "撤销指定"
    },
    {
      "id": "A38068-zh-00032",
      "text": "（三）教育培训课程或内容存在重大缺陷的情形"
    },
    {
      "id": "A38068-zh-00033",
      "text": "本法第8条第4款第3项"
    },
    {
      "id": "A38068-zh-00034",
      "text": "警告"
    },
    {
      "id": "A38068-zh-00035",
      "text": "停业三个月"
    },
    {
      "id": "A38068-zh-00036",
      "text": "撤销指定"
    },
    {
      "id": "A38068-zh-00037",
      "text": "（四）无正当理由连续一年以上未实施教育培训的情形"
    },
    {
      "id": "A38068-zh-00038",
      "text": "本法第8条第4款第4项"
    },
    {
      "id": "A38068-zh-00039",
      "text": "警告"
    },
    {
      "id": "A38068-zh-00040",
      "text": "撤销指定"
    },
    {
      "id": "A38069-zh-00001",
      "text": "■ 《茶产业发展及茶文化振兴法施行令》［附表3］<2024年11月12日修订>"
    },
    {
      "id": "A38069-zh-00002",
      "text": "专业人才培养机构指定标准（与第6条第1款有关）"
    },
    {
      "id": "A38069-zh-00003",
      "text": "1. 教育设施及设备：应具备下列各项设施及设备。"
    },
    {
      "id": "A38069-zh-00004",
      "text": "通过租赁合同或共同使用合同取得设施或设备使用权，"
    },
    {
      "id": "A38069-zh-00005",
      "text": "且使用权得到保障的，在合同期限内视为符合相关标准。"
    },
    {
      "id": "A38069-zh-00006",
      "text": "（一）教室：至少设置一间面积为30平方米以上的教室。"
    },
    {
      "id": "A38069-zh-00007",
      "text": "面积是指实测内墙之间的地面面积。"
    },
    {
      "id": "A38069-zh-00008",
      "text": "（二）实习室：至少设置一间面积为60平方米以上的实习室。"
    },
    {
      "id": "A38069-zh-00009",
      "text": "（三）卫生间：男女分设，规模应符合教育课程需要。"
    },
    {
      "id": "A38069-zh-00010",
      "text": "（四）供水设施：使用自来水以外的水源时，水质应符合"
    },
    {
      "id": "A38069-zh-00011",
      "text": "《饮用水管理法》第5条第3款规定的水质标准。"
    },
    {
      "id": "A38069-zh-00012",
      "text": "（五）照明设施：夜间授课时，课桌面及黑板面的照度应达到150勒克斯以上。"
    },
    {
      "id": "A38069-zh-00013",
      "text": "（六）消防设施：应符合《消防设施安装及管理法》第12条第1款规定的"
    },
    {
      "id": "A38069-zh-00014",
      "text": "消防安全标准。"
    },
    {
      "id": "A38069-zh-00015",
      "text": "（七）教育设备：应具备电脑等教育所需设备。"
    },
    {
      "id": "A38069-zh-00016",
      "text": "2. 教育课程：至少运营下列一项教育课程。"
    },
    {
      "id": "A38069-zh-00017",
      "text": "（一）茶产业创业意向者教育课程"
    },
    {
      "id": "A38069-zh-00018",
      "text": "（二）茶产业企业就业意向者教育课程"
    },
    {
      "id": "A38069-zh-00019",
      "text": "（三）茶产业从业人员继续教育课程"
    },
    {
      "id": "A38069-zh-00020",
      "text": "（四）茶产业经营教育课程"
    },
    {
      "id": "A38069-zh-00021",
      "text": "（五）茶营销教育课程"
    },
    {
      "id": "A38069-zh-00022",
      "text": "（六）茶产业相关法规教育课程"
    },
    {
      "id": "A38069-zh-00023",
      "text": "（七）茶叶品质改良、开发及卫生相关教育课程"
    },
    {
      "id": "A38069-zh-00024",
      "text": "（八）茶叶生产、加工、制造、流通及茶解说讲师培养课程"
    },
    {
      "id": "A38069-zh-00025",
      "text": "（九）茶侍酒师（茶品鉴师）培养课程"
    },
    {
      "id": "A38069-zh-00026",
      "text": "（十）茶文化教育讲师培养课程"
    },
    {
      "id": "A38069-zh-00027",
      "text": "（十一）其他茶产业全球化所需教育课程"
    },
    {
      "id": "A38069-zh-00028",
      "text": "3. 教育时间：教育时间（包括实习）应安排为每年96小时以上。"
    },
    {
      "id": "A38069-zh-00029",
      "text": "4. 讲师：至少应有一人符合下列任一条件。"
    },
    {
      "id": "A38069-zh-00030",
      "text": "（一）取得与第2项教育课程相关领域的硕士以上学位后，"
    },
    {
      "id": "A38069-zh-00031",
      "text": "在《高等教育法》第2条第4项规定的专科大学以上教育机构"
    },
    {
      "id": "A38069-zh-00032",
      "text": "具有至少一个学期的授课经验者。"
    },
    {
      "id": "A38069-zh-00033",
      "text": "（二）从事与第2项教育课程相关工作两年以上者。"
    },
    {
      "id": "A38070-zh-00001",
      "text": "■ 《茶产业发展及茶文化振兴法施行令》［附表4］"
    },
    {
      "id": "A38070-zh-00002",
      "text": "专业人才培养机构指定撤销及业务停止标准（与第6条第4款有关）"
    },
    {
      "id": "A38070-zh-00003",
      "text": "1. 一般标准"
    },
    {
      "id": "A38070-zh-00004",
      "text": "（一）对最近一年内因相同违规行为受到行政处分的，适用按违规次数加重的标准。"
    },
    {
      "id": "A38070-zh-00005",
      "text": "违规次数以作出处分之日及处分后再次查获相同违规行为之日为基准计算。"
    },
    {
      "id": "A38070-zh-00006",
      "text": "（二）存在两项以上违规行为且各自处分标准不同时，适用较重标准。"
    },
    {
      "id": "A38070-zh-00007",
      "text": "但各处分均为停业处分时，可在较重处分标准的二分之一范围内加重，"
    },
    {
      "id": "A38070-zh-00008",
      "text": "且停业期限不得超过各处分期限合计。"
    },
    {
      "id": "A38070-zh-00009",
      "text": "（三）存在下列加重或减轻事由时，处分机关可在第2项标准规定的"
    },
    {
      "id": "A38070-zh-00010",
      "text": "停业期限二分之一范围内加重或减轻。"
    },
    {
      "id": "A38070-zh-00011",
      "text": "1）加重事由"
    },
    {
      "id": "A38070-zh-00012",
      "text": "（一）违规行为系故意或重大过失所致。"
    },
    {
      "id": "A38070-zh-00013",
      "text": "（二）违规行为性质或程度严重，且对受训人员造成重大损害。"
    },
    {
      "id": "A38070-zh-00014",
      "text": "2）减轻事由"
    },
    {
      "id": "A38070-zh-00015",
      "text": "（一）违规行为系轻微过失或错误所致。"
    },
    {
      "id": "A38070-zh-00016",
      "text": "（二）客观上认定专业人才培养机构连续三年以上模范运营。"
    },
    {
      "id": "A38070-zh-00017",
      "text": "2. 具体标准"
    },
    {
      "id": "A38070-zh-00018",
      "text": "违规行为"
    },
    {
      "id": "A38070-zh-00019",
      "text": "法律依据"
    },
    {
      "id": "A38070-zh-00020",
      "text": "按违规次数确定的行政处分标准"
    },
    {
      "id": "A38070-zh-00021",
      "text": "第一次违规"
    },
    {
      "id": "A38070-zh-00022",
      "text": "第二次违规"
    },
    {
      "id": "A38070-zh-00023",
      "text": "第三次以上违规"
    },
    {
      "id": "A38070-zh-00024",
      "text": "（一）以虚假或其他不正当手段取得指定的情形"
    },
    {
      "id": "A38070-zh-00025",
      "text": "本法第9条第4款第1项"
    },
    {
      "id": "A38070-zh-00026",
      "text": "撤销指定"
    },
    {
      "id": "A38070-zh-00027",
      "text": "（二）不符合指定标准的情形"
    },
    {
      "id": "A38070-zh-00028",
      "text": "本法第9条第4款第2项"
    },
    {
      "id": "A38070-zh-00029",
      "text": "警告"
    },
    {
      "id": "A38070-zh-00030",
      "text": "停业三个月"
    },
    {
      "id": "A38070-zh-00031",
      "text": "撤销指定"
    },
    {
      "id": "A38070-zh-00032",
      "text": "（三）专业人才培养教育课程或内容存在重大缺陷的情形"
    },
    {
      "id": "A38070-zh-00033",
      "text": "本法第9条第4款第3项"
    },
    {
      "id": "A38070-zh-00034",
      "text": "警告"
    },
    {
      "id": "A38070-zh-00035",
      "text": "停业三个月"
    },
    {
      "id": "A38070-zh-00036",
      "text": "撤销指定"
    },
    {
      "id": "A38070-zh-00037",
      "text": "（四）无正当理由连续一年以上未实施专业人才培养的情形"
    },
    {
      "id": "A38070-zh-00038",
      "text": "本法第9条第4款第4项"
    },
    {
      "id": "A38070-zh-00039",
      "text": "警告"
    },
    {
      "id": "A38070-zh-00040",
      "text": "撤销指定"
    },
    {
      "id": "A38071-zh-00001",
      "text": "■ 《茶产业发展及茶文化振兴法施行令》［附表5］"
    },
    {
      "id": "A38071-zh-00002",
      "text": "罚款征收标准（与第12条有关）"
    },
    {
      "id": "A38071-zh-00003",
      "text": "1. 一般标准"
    },
    {
      "id": "A38071-zh-00004",
      "text": "（一）对最近一年内因相同违规行为受到行政处分的，适用按违规次数加重的标准。"
    },
    {
      "id": "A38071-zh-00005",
      "text": "违规次数以作出处分之日及处分后再次查获相同违规行为之日为基准计算。"
    },
    {
      "id": "A38071-zh-00006",
      "text": "（二）存在下列情形时，罚款征收机关可在第2项标准规定金额的二分之一范围内加重。"
    },
    {
      "id": "A38071-zh-00007",
      "text": "但加重后的金额不得超过本法第23条第1款及第2款规定的罚款上限。"
    },
    {
      "id": "A38071-zh-00008",
      "text": "1）违规行为性质或程度严重，且造成重大损害。"
    },
    {
      "id": "A38071-zh-00009",
      "text": "2）违规行为持续六个月以上。"
    },
    {
      "id": "A38071-zh-00010",
      "text": "3）其他考虑违规程度、动机及结果等，认定有必要加重罚款的情形。"
    },
    {
      "id": "A38071-zh-00011",
      "text": "（三）存在下列情形时，罚款征收机关可在第2项标准规定金额的二分之一范围内减轻。"
    },
    {
      "id": "A38071-zh-00012",
      "text": "但拖欠罚款的违法行为人不适用减轻规定。"
    },
    {
      "id": "A38071-zh-00013",
      "text": "1）违法行为人符合《违反秩序行为规制法施行令》第2条之2第1款各项规定的情形。"
    },
    {
      "id": "A38071-zh-00014",
      "text": "2）违规行为系轻微过失或错误所致。"
    },
    {
      "id": "A38071-zh-00015",
      "text": "3）考虑违规程度、动机及结果等，认定有必要减轻罚款的其他情形。"
    },
    {
      "id": "A38071-zh-00016",
      "text": "2. 具体标准"
    },
    {
      "id": "A38071-zh-00017",
      "text": "违规行为"
    },
    {
      "id": "A38071-zh-00018",
      "text": "法律依据"
    },
    {
      "id": "A38071-zh-00019",
      "text": "罚款金额（单位：万韩元）"
    },
    {
      "id": "A38071-zh-00020",
      "text": "第一次违规"
    },
    {
      "id": "A38071-zh-00021",
      "text": "第二次违规"
    },
    {
      "id": "A38071-zh-00022",
      "text": "第三次以上违规"
    },
    {
      "id": "A38071-zh-00023",
      "text": "（一）违反本法第11条第1款，未履行标示变更等命令的情形"
    },
    {
      "id": "A38071-zh-00024",
      "text": "本法第23条第1款"
    },
    {
      "id": "A38071-zh-00025",
      "text": "300"
    },
    {
      "id": "A38071-zh-00026",
      "text": "500"
    },
    {
      "id": "A38071-zh-00027",
      "text": "1,000"
    },
    {
      "id": "A38071-zh-00028",
      "text": "（二）违反本法第11条第2款，无正当理由拒绝、妨碍或回避调查或检验委托的情形"
    },
    {
      "id": "A38071-zh-00029",
      "text": "本法第23条第2款"
    },
    {
      "id": "A38071-zh-00030",
      "text": "100"
    },
    {
      "id": "A38071-zh-00031",
      "text": "300"
    },
    {
      "id": "A38071-zh-00032",
      "text": "500"
    },
    {
      "id": "A23825-zh-00001",
      "text": "■ 《茶产业发展及茶文化振兴法施行规则》［附表1］<2021年12月31日修订>"
    },
    {
      "id": "A23825-zh-00002",
      "text": "茶叶品质等标示标准（与第5条有关）"
    },
    {
      "id": "A23825-zh-00003",
      "text": "1. 适用范围：仅适用于施行令第2条第1号规定的绿茶。"
    },
    {
      "id": "A23825-zh-00004",
      "text": "2. 按茶树叶采摘时期划分的种类及标准"
    },
    {
      "id": "A23825-zh-00005",
      "text": "（一）标示种类：标示为雨前茶（우전）、谷雨茶（곡우）、细雀（세작）、中雀（중작）、大雀（대작）。"
    },
    {
      "id": "A23825-zh-00006",
      "text": "（二）各标示种类的标准"
    },
    {
      "id": "A23825-zh-00007",
      "text": "1）雨前茶：根据当年气象条件，通常在正常年份节气谷雨之前采摘的茶树叶，"
    },
    {
      "id": "A23825-zh-00008",
      "text": "使用一芽二叶（1心2叶）制成。"
    },
    {
      "id": "A23825-zh-00009",
      "text": "2）谷雨茶：在节气谷雨当日或谷雨后7日以内采摘的茶树叶，"
    },
    {
      "id": "A23825-zh-00010",
      "text": "使用一芽二叶（1心2叶）制成。"
    },
    {
      "id": "A23825-zh-00011",
      "text": "3）细雀：在节气谷雨后第8日至第10日之间采摘的茶树叶，"
    },
    {
      "id": "A23825-zh-00012",
      "text": "使用一芽三叶（1心3叶）制成。"
    },
    {
      "id": "A23825-zh-00013",
      "text": "4）中雀：使用5月采摘的一芽三叶茶树叶制成。"
    },
    {
      "id": "A23825-zh-00014",
      "text": "5）大雀：使用6月以后采摘的茶树叶制成。"
    },
    {
      "id": "A23825-zh-00015",
      "text": "（三）尽管有（二）各标示种类标准的规定，仍可适用下列标示标准。"
    },
    {
      "id": "A23825-zh-00016",
      "text": "1）使用节气谷雨当日或谷雨后7日以内首次采摘的一芽二叶茶树叶"
    },
    {
      "id": "A23825-zh-00017",
      "text": "加工、制造的产品，可以标示为“谷雨茶（头采茶或一番茶）”。"
    },
    {
      "id": "A23825-zh-00018",
      "text": "2）使用谷雨后第8日至第10日之间首次采摘的一芽二叶茶树叶"
    },
    {
      "id": "A23825-zh-00019",
      "text": "加工、制造的产品，可以标示为“细雀（头采茶或一番茶）”。"
    },
    {
      "id": "A23825-zh-00020",
      "text": "3）使用谷雨后第8日至第10日之间第二次采摘的一芽三叶茶树叶"
    },
    {
      "id": "A23825-zh-00021",
      "text": "加工、制造的产品，可以标示为“细雀（二采茶或二番茶）”；使用5月第二次采摘的一芽三叶茶树叶"
    },
    {
      "id": "A23825-zh-00022",
      "text": "加工、制造的产品，可以标示为“中雀（二采茶或二番茶）”。"
    },
    {
      "id": "A23825-zh-00023",
      "text": "3. 其他标示事项及标示方法"
    },
    {
      "id": "A23825-zh-00024",
      "text": "（一）茶树叶采摘时期：标示该产品茶树叶采摘时期，格式为“年、月（上旬、中旬、下旬）”。"
    },
    {
      "id": "A23825-zh-00025",
      "text": "混合不同采摘时期茶树叶制成的产品，应标示最后采摘的茶树叶采摘时期。"
    },
    {
      "id": "A23825-zh-00026",
      "text": "（二）茶树叶采摘地区：依《农水产品原产地标示法》规定的标准，"
    },
    {
      "id": "A23825-zh-00027",
      "text": "标示采摘茶树叶的市、郡、区名称；在多个市、郡、区采摘的茶树叶混合加工时，"
    },
    {
      "id": "A23825-zh-00028",
      "text": "可以标示道、特别自治道名称或“国产”。"
    },
    {
      "id": "A23825-zh-00029",
      "text": "4. 第1项至第3项未规定的标示事项，依《食品卫生法》办理。"
    },
    {
      "id": "A23826-zh-00001",
      "text": "■ 《茶产业发展及茶文化振兴法施行规则》［附表2］"
    },
    {
      "id": "A23826-zh-00002",
      "text": "关于命令变更茶叶品质等标示的详细标准（与第6条有关）"
    },
    {
      "id": "A23826-zh-00003",
      "text": "1. 一般标准"
    },
    {
      "id": "A23826-zh-00004",
      "text": "（一）一个产品生产过程中存在两项以上违规行为，且各自适用的命令标准不同时，"
    },
    {
      "id": "A23826-zh-00005",
      "text": "适用其中较重的命令标准。"
    },
    {
      "id": "A23826-zh-00006",
      "text": "（二）标示变更命令应规定在两周以内完成标示变更。"
    },
    {
      "id": "A23826-zh-00007",
      "text": "但认定存在特殊事由时，可在原定完成期限二分之一范围内延长。"
    },
    {
      "id": "A23826-zh-00008",
      "text": "（三）按违规次数适用标示变更等命令标准的，以最近一年内因相同违规行为受到警告的情况为限。"
    },
    {
      "id": "A23826-zh-00009",
      "text": "违规次数分别以收到警告之日及警告后再次实施同类违规行为并生产产品之日为基准计算。"
    },
    {
      "id": "A23826-zh-00010",
      "text": "2. 具体标准"
    },
    {
      "id": "A23826-zh-00011",
      "text": "违规行为"
    },
    {
      "id": "A23826-zh-00012",
      "text": "法律依据"
    },
    {
      "id": "A23826-zh-00013",
      "text": "按违规次数等确定的标示变更命令标准"
    },
    {
      "id": "A23826-zh-00014",
      "text": "第一次违规"
    },
    {
      "id": "A23826-zh-00015",
      "text": "第二次以上违规"
    },
    {
      "id": "A23826-zh-00016",
      "text": "（一）依据本法第19条第1款进行调查或委托检验后，"
    },
    {
      "id": "A23826-zh-00017",
      "text": "发现违反附表1茶叶品质等标示标准任一项目的情形"
    },
    {
      "id": "A23826-zh-00018",
      "text": "本法第19条第1款"
    },
    {
      "id": "A23826-zh-00019",
      "text": "警告"
    },
    {
      "id": "A23826-zh-00020",
      "text": "标示变更"
    },
    {
      "id": "A23826-zh-00021",
      "text": "（二）依据本法第19条第1款进行调查或委托检验后，"
    },
    {
      "id": "A23826-zh-00022",
      "text": "发现严重违反附表1茶叶品质等标示标准任一项目的情形"
    },
    {
      "id": "A23826-zh-00023",
      "text": "本法第19条第1款"
    },
    {
      "id": "A23826-zh-00024",
      "text": "标示变更"
    },
    {
      "id": "A23826-zh-00025",
      "text": "3. 严重违规的标准"
    },
    {
      "id": "A23826-zh-00026",
      "text": "（一）在按茶树叶种类划分的标示标准中，将“细雀”标示为“雨前茶”，"
    },
    {
      "id": "A23826-zh-00027",
      "text": "或将“大雀”标示为“细雀”等，上调两个以上等级标示的情形。"
    },
    {
      "id": "A23826-zh-00028",
      "text": "（二）将5月采摘的茶树叶标示为4月采摘等，"
    },
    {
      "id": "A23826-zh-00029",
      "text": "将采摘时期提前一个月以上标示的情形。"
    },
    {
      "id": "A23827-zh-00001",
      "text": "■ 《茶产业发展及茶文化振兴法施行规则》［附件第1号格式］"
