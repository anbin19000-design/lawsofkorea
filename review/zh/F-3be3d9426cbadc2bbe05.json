{
  "schema": "LAW_ZH_MINIMAL_REVIEW_V1",
  "job_id": "F-3be3d9426cbadc2bbe05",
  "worker": "C02",
  "checked_rows": 492,
  "edits": [
    {
      "id": "B1-zh-00001",
      "text": "《互联网多媒体广播业务法》"
    },
    {
      "id": "B2-zh-00001",
      "text": "《互联网多媒体广播业务法施行令》"
    },
    {
      "id": "A36381-zh-00001",
      "text": "■ 《互联网多媒体广播业务法施行令》［附表1］"
    },
    {
      "id": "A36381-zh-00002",
      "text": "许可审查事项评分（与第2条第4款有关）"
    },
    {
      "id": "A36381-zh-00003",
      "text": "审查事项"
    },
    {
      "id": "A36381-zh-00004",
      "text": "分配分数"
    },
    {
      "id": "A36381-zh-00005",
      "text": "1. 实现广播公共责任、公平性及公益性的可能性"
    },
    {
      "id": "A36381-zh-00007",
      "text": "2. 内容供应计划的适当性及对广播、影像产业发展的贡献"
    },
    {
      "id": "A36381-zh-00012",
      "text": "4. 包括组织及人力资源管理在内的经营计划适当性"
    },
    {
      "id": "A36381-zh-00016",
      "text": "6. 设施计划的技术能力及适当性"
    },
    {
      "id": "A36381-zh-00018",
      "text": "合计"
    },
    {
      "id": "A36382-zh-00001",
      "text": "■ 《互联网多媒体广播业务法》施行令［附表2］<2025年10月1日修订>"
    },
    {
      "id": "A36382-zh-00002",
      "text": "按违规行为种类确定的罚款征收上限及计算标准（与第13条第2款有关）"
    },
    {
      "id": "A36382-zh-00003",
      "text": "1. 按违规行为种类确定的罚款征收上限"
    },
    {
      "id": "A36382-zh-00004",
      "text": "（一）属于本法第17条第1款第1项、第2项及第4项规定的行为：销售额的"
    },
    {
      "id": "A36382-zh-00005",
      "text": "千分之十以下。"
    },
    {
      "id": "A36382-zh-00006",
      "text": "（二）属于本法第17条第1款第3项规定的行为：销售额的千分之十五以下。"
    },
    {
      "id": "A36382-zh-00007",
      "text": "（三）属于本法第17条第1款第5项至第7项规定的行为：销售额的"
    },
    {
      "id": "A36382-zh-00008",
      "text": "千分之二十以下。"
    },
    {
      "id": "A36382-zh-00009",
      "text": "（四）没有销售额或难以计算销售额时：五亿韩元以下。"
    },
    {
      "id": "A36382-zh-00010",
      "text": "2. 罚款计算程序及标准"
    },
    {
      "id": "A36382-zh-00011",
      "text": "（一）罚款计算阶段"
    },
    {
      "id": "A36382-zh-00012",
      "text": "依据本法第17条第2款及相关规定，计算罚款时，应考虑"
    },
    {
      "id": "A36382-zh-00013",
      "text": "处罚原因、妨碍市场竞争的行为是否具有故意性及其对相关市场的影响等，"
    },
    {
      "id": "A36382-zh-00014",
      "text": "并对基准金额适用必要的加重及减轻权重。"
    },
    {
      "id": "A36382-zh-00016",
      "text": "（二）各罚款计算阶段的计算方法及考虑事项"
    },
    {
      "id": "A36382-zh-00017",
      "text": "1）基准金额的计算"
    },
    {
      "id": "A36382-zh-00018",
      "text": "（一）基准金额是指互联网多媒体广播服务提供者在违规期间，"
    },
    {
      "id": "A36382-zh-00019",
      "text": "因该违规行为直接或间接影响的服务所取得的收入（以下简称“相关销售额”）"
    },
    {
      "id": "A36382-zh-00020",
      "text": "乘以（二）规定的基准征收率所得金额。"
    },
    {
      "id": "A36382-zh-00021",
      "text": "但不得超过相关销售额的百分之二。"
    },
    {
      "id": "A36382-zh-00023",
      "text": "（二）基准征收率按（五）规定的违规行为严重程度分类如下："
    },
    {
      "id": "A36382-zh-00025",
      "text": "严重程度"
    },
    {
      "id": "A36382-zh-00026",
      "text": "基准征收率"
    },
    {
      "id": "A36382-zh-00028",
      "text": "百分之一以上、百分之二以下"
    },
    {
      "id": "A36382-zh-00029",
      "text": "严重违规行为"
    },
    {
      "id": "A36382-zh-00030",
      "text": "百分之零点五以上、百分之一以下"
    },
    {
      "id": "A36382-zh-00031",
      "text": "轻微违规行为"
    },
    {
      "id": "A36382-zh-00032",
      "text": "百分之零点五以下"
    },
    {
      "id": "A36382-zh-00034",
      "text": "（三）相关销售额按违规期间计算。违规期间"
    },
    {
      "id": "A36382-zh-00035",
      "text": "原则上从违规行为开始之日起至终了之日止；并应考虑违规行为"
    },
    {
      "id": "A36382-zh-00036",
      "text": "造成的收益或损失是否持续、违规状态是否持续等因素，"
    },
    {
      "id": "A36382-zh-00037",
      "text": "依据经营实绩等会计资料计算。"
    },
    {
      "id": "A36382-zh-00039",
      "text": "（四）没有相关销售额或难以计算相关销售额时，"
    },
    {
      "id": "A36382-zh-00040",
      "text": "基准金额按下表根据（五）规定的严重程度分类计算。基准金额"
    },
    {
      "id": "A36382-zh-00041",
      "text": "应综合考虑相关互联网多媒体广播服务提供者的"
    },
    {
      "id": "A36382-zh-00042",
      "text": "财务报表、用户数、使用费等会计资料，"
    },
    {
      "id": "A36382-zh-00043",
      "text": "以及以往经营实绩、事业计划、市场状况等因素。"
    },
    {
      "id": "A36382-zh-00045",
      "text": "严重程度"
    },
    {
      "id": "A36382-zh-00046",
      "text": "基准金额"
    },
    {
      "id": "A36382-zh-00048",
      "text": "超过三亿韩元、四亿韩元以下"
    },
    {
      "id": "A36382-zh-00049",
      "text": "严重违规行为"
    },
    {
      "id": "A36382-zh-00050",
      "text": "超过二亿韩元、三亿韩元以下"
    },
    {
      "id": "A36382-zh-00051",
      "text": "轻微违规行为"
    },
    {
      "id": "A36382-zh-00052",
      "text": "二亿韩元以下"
    },
    {
      "id": "A36382-zh-00054",
      "text": "（五）确定（二）及（四）的违规行为严重程度时，"
    },
    {
      "id": "A36382-zh-00055",
      "text": "应综合考虑下列事项："
    },
    {
      "id": "A36382-zh-00056",
      "text": "1. 对市场的影响，例如是否扭曲市场基本秩序；"
    },
    {
      "id": "A36382-zh-00057",
      "text": "2. 用户受到损害的程度；"
    },
    {
      "id": "A36382-zh-00058",
      "text": "3. 违规经营者向用户赔偿损失的"
    },
    {
      "id": "A36382-zh-00059",
      "text": "努力程度。"
    },
    {
      "id": "A36382-zh-00061",
      "text": "2）基本加重权重"
    },
    {
      "id": "A36382-zh-00062",
      "text": "（一）考虑违规行为的持续期间及次数，在基准金额的百分之五十"
    },
    {
      "id": "A36382-zh-00063",
      "text": "范围内加算基本加重金额；并将该金额与违规行为所得利益"
    },
    {
      "id": "A36382-zh-00064",
      "text": "进行比较，以两者中较大者作为基本加重金额。"
    },
    {
      "id": "A36382-zh-00066",
      "text": "（二）违规行为的持续期间分为短期、中期及长期，"
    },
    {
      "id": "A36382-zh-00067",
      "text": "违规行为严重且同一违规行为再次发生时，应按违规次数递增加重。"
    },
    {
      "id": "A36382-zh-00069",
      "text": "3）追加加重或减轻"
    },
    {
      "id": "A36382-zh-00070",
      "text": "应考虑违规行为是否经过事先策划、是否出于故意或过失，"
    },
    {
      "id": "A36382-zh-00071",
      "text": "以及调查期间违规行为是否持续或扩大，"
    },
    {
      "id": "A36382-zh-00072",
      "text": "例如参与者人数的变化及违规行为对相关市场的影响等，"
    },
    {
      "id": "A36382-zh-00073",
      "text": "在基本加重金额的百分之五十范围内"
    },
    {
      "id": "A36382-zh-00074",
      "text": "追加加重或减轻。"
    },
    {
      "id": "A36382-zh-00076",
      "text": "3. 详细标准"
    },
    {
      "id": "A36382-zh-00077",
      "text": "关于各阶段基准金额、基本加重金额及追加加重或减轻的具体考虑事项、"
    },
    {
      "id": "A36382-zh-00078",
      "text": "处罚理由、加重或减轻事由的比率，以及罚款征收所需的其他详细标准，"
    },
    {
      "id": "A36382-zh-00079",
      "text": "由广播通信委员会制定并公告。"
    },
    {
      "id": "A36383-zh-00001",
      "text": "■ 《互联网多媒体广播业务法施行令》［附表3］"
    },
    {
      "id": "A36383-zh-00002",
      "text": "禁止行为的类型及标准（与第15条第1款有关）"
    },
    {
      "id": "A36383-zh-00004",
      "text": "本法第17条第1款第1项所称禁止行为，包括下列情形："
    },
    {
      "id": "A36383-zh-00006",
      "text": "（一）在互联网多媒体广播服务提供者的相关业务区域内，"
    },
    {
      "id": "A36383-zh-00007",
      "text": "特定用户请求使用互联网多媒体广播服务提供者的设施，"
    },
    {
      "id": "A36383-zh-00008",
      "text": "无正当理由（如设施容量不足等）拒绝该请求的行为。"
    },
    {
      "id": "A36383-zh-00009",
      "text": "（二）无正当理由拒绝向特定用户提供特定服务，"
    },
    {
      "id": "A36383-zh-00010",
      "text": "或拒绝提供服务的行为。"
    },
    {
      "id": "A36383-zh-00011",
      "text": "（三）用户未缴纳使用费等服务使用条款所规定的费用，"
    },
    {
      "id": "A36383-zh-00012",
      "text": "且符合正当理由时，暂停或终止服务合同；但不符合该等理由时，"
    },
    {
      "id": "A36383-zh-00013",
      "text": "单方面暂停或终止互联网多媒体广播服务的行为。"
    },
    {
      "id": "A36383-zh-00014",
      "text": "（四）在与其他电信服务捆绑销售互联网多媒体广播服务时，"
    },
    {
      "id": "A36383-zh-00015",
      "text": "无正当理由拒绝单独提供互联网多媒体广播服务的行为。"
    },
    {
      "id": "A36383-zh-00017",
      "text": "2. 违反服务使用条款提供服务或收取使用费"
    },
    {
      "id": "A36383-zh-00018",
      "text": "本法第17条第1款第2项所称禁止行为，包括下列情形："
    },
    {
      "id": "A36383-zh-00020",
      "text": "（一）提供与服务使用条款不同的内容，"
    },
    {
      "id": "A36383-zh-00021",
      "text": "从而不公平地提供服务并严重侵害用户利益的行为。"
    },
    {
      "id": "A36383-zh-00022",
      "text": "（二）按照与服务使用条款不同的内容不公平地收取费用，"
    },
    {
      "id": "A36383-zh-00023",
      "text": "从而严重侵害用户利益的行为。"
    },
    {
      "id": "A36383-zh-00024",
      "text": "（三）未确认用户使用服务的意愿即提供服务，"
    },
    {
      "id": "A36383-zh-00025",
      "text": "从而严重侵害用户利益的行为。"
    },
    {
      "id": "A36383-zh-00026",
      "text": "3. 不当使用用户信息"
    },
    {
      "id": "A36383-zh-00027",
      "text": "本法第17条第1款第3项所称禁止行为，包括下列情形："
    },
    {
      "id": "A36383-zh-00029",
      "text": "（一）不当泄露或向第三方提供在提供互联网多媒体广播服务过程中取得的用户信息。"
    },
    {
      "id": "A36383-zh-00030",
      "text": "（二）将提供互联网多媒体广播服务过程中取得的用户信息，"
    },
    {
      "id": "A36383-zh-00031",
      "text": "不当用于自身营业活动。"
    },
    {
      "id": "A36383-zh-00033",
      "text": "4. 对用户的不公平差别待遇"
    },
    {
      "id": "A36383-zh-00034",
      "text": "本法第17条第1款第4项所称禁止行为，包括下列情形："
    },
    {
      "id": "A36383-zh-00036",
      "text": "（一）对互联网多媒体广播服务用户的使用费、使用条件或设备要求，"
    },
    {
      "id": "A36383-zh-00037",
      "text": "与其他用户相比给予明显有利或不利的待遇，"
    },
    {
      "id": "A36383-zh-00038",
      "text": "或者故意对特定用户作出明显差别待遇的行为。"
    },
    {
      "id": "A36383-zh-00039",
      "text": "（二）在销售服务或订立服务合同时，"
    },
    {
      "id": "A36383-zh-00040",
      "text": "对使用费或条件给予明显不利待遇，"
    },
    {
      "id": "A36383-zh-00041",
      "text": "或者在提供互联网多媒体广播服务时给予差别待遇的行为。"
    },
    {
      "id": "A36383-zh-00042",
      "text": "（三）在与其他电信服务捆绑销售时，"
    },
    {
      "id": "A36383-zh-00043",
      "text": "以差别待遇提供互联网多媒体广播服务的行为。"
    },
    {
      "id": "A36383-zh-00045",
      "text": "5. 滥用市场支配地位侵害互联网多媒体广播内容提供者的经营活动"
    },
    {
      "id": "A36383-zh-00046",
      "text": "本法第17条第1款第5项所称禁止行为，包括下列情形："
    },
    {
      "id": "A36383-zh-00048",
      "text": "（一）利用支配地位不公平地限制互联网多媒体广播内容提供者，"
    },
    {
      "id": "A36383-zh-00049",
      "text": "或迫使其订立对内容提供者明显不利的合同，"
    },
    {
      "id": "A36383-zh-00050",
      "text": "包括限制内容提供者终止合同或请求损害赔偿的权利。"
    },
    {
      "id": "A36383-zh-00051",
      "text": "（二）不公平地利用其在互联网多媒体广播领域的优势地位，"
    },
    {
      "id": "A36383-zh-00052",
      "text": "妨碍内容提供者与其他互联网多媒体广播服务提供者进行交易，"
    },
    {
      "id": "A36383-zh-00053",
      "text": "或者拒绝订立内容供应合同、给予差别待遇或强迫订立合同。"
    },
    {
      "id": "A36383-zh-00054",
      "text": "（三）利用优势地位，强迫内容提供者接受明显不利于其的收益分配，"
    },
    {
      "id": "A36383-zh-00055",
      "text": "或与正常交易惯例相比明显不合理的经济利益提供条件，"
    },
    {
      "id": "A36383-zh-00056",
      "text": "从而造成重大经济损失的行为。"
    },
    {
      "id": "A36383-zh-00058",
      "text": "6. 妨碍其他广播事业者的业务"
    },
    {
      "id": "A36383-zh-00059",
      "text": "本法第17条第1款第6项所称禁止行为，包括下列情形："
    },
    {
      "id": "A36383-zh-00061",
      "text": "（一）损坏其他互联网多媒体广播服务提供者的设备或器材，"
    },
    {
      "id": "A36383-zh-00062",
      "text": "妨碍其使用服务或提供服务的行为。"
    },
    {
      "id": "A36383-zh-00063",
      "text": "（二）以用户转换延迟、不公平诱导或提供过度利益等不正当手段，"
    },
    {
      "id": "A36383-zh-00064",
      "text": "妨碍订立服务提供合同的行为。"
    },
    {
      "id": "A36383-zh-00065",
      "text": "（三）提供有关其他互联网多媒体广播服务或自身服务的"
    },
    {
      "id": "A36383-zh-00066",
      "text": "使用费、使用条件及服务质量的虚假信息，"
    },
    {
      "id": "A36383-zh-00067",
      "text": "不公平地妨碍服务提供合同订立的行为。"
    },
    {
      "id": "A36383-zh-00068",
      "text": "（四）不公平地利用独家内容，"
    },
    {
      "id": "A36383-zh-00069",
      "text": "妨碍其他互联网多媒体广播服务提供者订立内容使用合同的行为。"
    },
    {
      "id": "A36383-zh-00071",
      "text": "7. 拒绝、中断或限制使用或接入必要电信设施的行为"
    },
    {
      "id": "A36383-zh-00072",
      "text": "本法第17条第1款第7项所称禁止行为，包括下列情形："
    },
    {
      "id": "A36383-zh-00074",
      "text": "（一）其他互联网多媒体广播服务提供者请求使用或接入必要电信设施时，"
    },
    {
      "id": "A36383-zh-00075",
      "text": "无正当理由拒绝协商、拒绝订立合同或拒绝履行已订立合同的行为。"
    },
    {
      "id": "A36383-zh-00076",
      "text": "（二）无正当理由妨碍其他互联网多媒体广播服务提供者"
    },
    {
      "id": "A36383-zh-00077",
      "text": "合法使用电信设施，或中断、限制其使用的行为。"
    },
    {
      "id": "A36383-zh-00078",
      "text": "（三）以歧视性价格或使用条件，限制其他互联网多媒体广播服务提供者"
    },
    {
      "id": "A36383-zh-00079",
      "text": "使用或接入电信设施的行为。"
    },
    {
      "id": "A36384-zh-00001",
      "text": "■ 《互联网多媒体广播业务法施行令》［附表4］<2025年10月1日修订>"
    },
    {
      "id": "A36384-zh-00002",
      "text": "撤销许可等行政处分标准（与第22条第1款有关）"
    },
    {
      "id": "A36384-zh-00003",
      "text": "1. 一般标准"
    },
    {
      "id": "A36384-zh-00004",
      "text": "（一）存在两项以上违规行为且各自适用的处分标准不同时，"
    },
    {
      "id": "A36384-zh-00005",
      "text": "适用其中较重的处分标准。两项以上处分均为停业处分时，"
    },
    {
      "id": "A36384-zh-00006",
      "text": "可将各停业期限相加，但停业总期限不得超过一年。"
    },
    {
      "id": "A36384-zh-00008",
      "text": "（二）广播通信委员会作出停业处分时，可考虑违规行为的"
    },
    {
      "id": "A36384-zh-00009",
      "text": "严重程度及次数，在停业期限二分之一范围内加重或减轻。"
    },
    {
      "id": "A36384-zh-00010",
      "text": "但加重后的停业总期限不得超过一年。"
    },
    {
      "id": "A36384-zh-00012",
      "text": "2. 具体标准"
    },
    {
      "id": "A36384-zh-00013",
      "text": "违规行为"
    },
    {
      "id": "A36384-zh-00014",
      "text": "相关法律条文"
    },
    {
      "id": "A36384-zh-00015",
      "text": "处分标准"
    },
    {
      "id": "A36384-zh-00017",
      "text": "1. 以虚假或其他不正当手段"
    },
    {
      "id": "A36384-zh-00018",
      "text": "本法第24条第1款第1项"
    },
    {
      "id": "A36384-zh-00019",
      "text": "撤销许可"
    },
    {
      "id": "A36384-zh-00020",
      "text": "取得许可的情形"
    },
    {
      "id": "A36384-zh-00022",
      "text": "2. 自取得许可之日起一年内"
    },
    {
      "id": "A36384-zh-00023",
      "text": "本法第24条第1款第2项"
    },
    {
      "id": "A36384-zh-00024",
      "text": "撤销许可；但因自然灾害等不可避免事由，"
    },
    {
      "id": "A36384-zh-00025",
      "text": "导致营业中断不满一年或超过一年时，"
    },
    {
      "id": "A36384-zh-00026",
      "text": "可适用停业六个月的处分。"
    },
    {
      "id": "A36384-zh-00028",
      "text": "3. 未遵守依据本法第10条第2款"
    },
    {
      "id": "A36384-zh-00029",
      "text": "本法第24条第1款第3项"
    },
    {
      "id": "A36384-zh-00030",
      "text": "停业六个月"
    },
    {
      "id": "A36384-zh-00031",
      "text": "作出的命令的情形"
    },
    {
      "id": "A36384-zh-00033",
      "text": "4. 未遵守依据本法第13条第2款"
    },
    {
      "id": "A36384-zh-00034",
      "text": "本法第24条第1款第3项"
    },
    {
      "id": "A36384-zh-00035",
      "text": "停业三个月"
    },
    {
      "id": "A36384-zh-00036",
      "text": "作出的命令的情形"
    },
    {
      "id": "A36385-zh-00001",
      "text": "■ 《互联网多媒体广播业务法施行令》［附表5］"
    },
    {
      "id": "A36385-zh-00002",
      "text": "按违规行为种类确定的罚款金额（与第23条第3款有关）"
    },
    {
      "id": "A36385-zh-00003",
      "text": "违规行为"
    },
    {
      "id": "A36385-zh-00004",
      "text": "相关法律条文"
    },
    {
      "id": "A36385-zh-00005",
      "text": "罚款金额"
    },
    {
      "id": "A36385-zh-00006",
      "text": "1. 自取得许可之日起一年内未开始营业，或"
    },
    {
      "id": "A36385-zh-00007",
      "text": "本法第25条第1款"
    },
    {
      "id": "A36385-zh-00008",
      "text": "销售额的百分之二"
    },
    {
      "id": "A36385-zh-00009",
      "text": "营业连续中断超过一年时"
    },
    {
      "id": "A36385-zh-00011",
      "text": "2. 未遵守依据本法第10条第2款作出的命令时"
    },
    {
      "id": "A36385-zh-00012",
      "text": "本法第25条第1款"
    },
    {
      "id": "A36385-zh-00013",
      "text": "销售额的百分之一点五"
    },
    {
      "id": "A36385-zh-00015",
      "text": "3. 未遵守依据本法第13条第2款作出的命令时"
    },
    {
      "id": "A36385-zh-00016",
      "text": "本法第25条第1款"
    },
    {
      "id": "A36385-zh-00017",
      "text": "销售额的百分之一"
    },
    {
      "id": "A36386-zh-00001",
      "text": "■ 《互联网多媒体广播业务法施行令》［附表6］<2024年7月16日修订>"
    },
    {
      "id": "A36386-zh-00002",
      "text": "按违规行为种类确定的罚款征收标准（与第24条有关）"
    },
    {
      "id": "A36386-zh-00003",
      "text": "违规行为"
    },
    {
      "id": "A36386-zh-00004",
      "text": "相关法律条文"
    },
    {
      "id": "A36386-zh-00005",
      "text": "罚款金额"
    },
    {
      "id": "A36386-zh-00006",
      "text": "1. 违反本法第11条第1款第1项但书，未提交报告的情形"
    },
    {
      "id": "A36386-zh-00007",
      "text": "本法第28条第1款第1项"
    },
    {
      "id": "A36386-zh-00010",
      "text": "1之2. 未依据本法第12条第4款提交资料的情形"
    },
    {
      "id": "A36386-zh-00011",
      "text": "本法第28条第1款第1项及第2项"
    },
    {
      "id": "A36386-zh-00012",
      "text": "1,000万韩元"
    },
    {
      "id": "A36386-zh-00014",
      "text": "2. 违反本法第15条第1款或第3款，未报告服务使用条款或其变更，"
    },
    {
      "id": "A36386-zh-00015",
      "text": "本法第28条第1款第2项"
    },
    {
      "id": "A36386-zh-00016",
      "text": "或者未取得服务使用条款或其变更批准即开展互联网多媒体广播服务的情形"
    },
    {
      "id": "A36386-zh-00018",
      "text": "1）违反本法第15条第1款，未报告服务使用条款或其变更的情形"
    },
    {
      "id": "A36386-zh-00019",
      "text": "500万韩元"
    },
    {
      "id": "A36386-zh-00021",
      "text": "2）违反本法第15条第3款，未取得服务使用条款或其变更批准的情形"
    },
    {
      "id": "A36386-zh-00022",
      "text": "1,000万韩元"
    },
    {
      "id": "A36386-zh-00024",
      "text": "3. 违反本法第15条第4款，未提交资料的情形"
    },
    {
      "id": "A36386-zh-00025",
      "text": "本法第28条第1款第3项"
    },
    {
      "id": "A36386-zh-00026",
      "text": "500万韩元"
    },
    {
      "id": "A36386-zh-00028",
      "text": "4. 违反本法第16条第2款，未采取保护用户信息措施的情形"
    },
    {
      "id": "A36386-zh-00029",
      "text": "本法第28条第1款第4项"
    },
    {
      "id": "A36386-zh-00030",
      "text": "1,000万韩元"
    },
    {
      "id": "A36386-zh-00032",
      "text": "4之2. 无正当理由不提交本法第16条第2款第2项规定的必要资料的情形"
    },
    {
      "id": "A36386-zh-00033",
      "text": "本法第28条第1款第4之2项"
    },
    {
      "id": "A36386-zh-00034",
      "text": "300万韩元"
    },
    {
      "id": "A36386-zh-00036",
      "text": "5. 未依本法第22条提交报告的情形"
    },
    {
      "id": "A36386-zh-00037",
      "text": "本法第28条第1款第5项"
    },
    {
      "id": "A36386-zh-00038",
      "text": "500万韩元"
    },
    {
      "id": "A36386-zh-00040",
      "text": "6. 未执行依据本法第26条作出的纠正命令等的情形"
    },
    {
      "id": "A36386-zh-00041",
      "text": "本法第28条第1款第6项"
    },
    {
      "id": "A36386-zh-00042",
      "text": "1,000万韩元"
    }
  ],
  "status": "COMPLETE"
}
