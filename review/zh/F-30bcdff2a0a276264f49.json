    {
      "id": "A35236-zh-00001",
      "text": "■《特殊任务执行人员补偿法实施令》[附表格式第5号] <2022年12月20日修订>"
    },
    {
      "id": "A35236-zh-00002",
      "text": "遗属代表选定书"
    },
    {
      "id": "A35236-zh-00003",
      "text": "※ 请阅读下方遗属代表选定方法后填写。"
    },
    {
      "id": "A35236-zh-00004",
      "text": "遗属"
    },
    {
      "id": "A35236-zh-00005",
      "text": "姓名（汉字）"
    },
    {
      "id": "A35236-zh-00007",
      "text": "代表"
    },
    {
      "id": "A35236-zh-00010",
      "text": "与特殊任务执行人员的关系"
    },
    {
      "id": "A35236-zh-00011",
      "text": "我们根据《特殊任务执行人员补偿法实施令》第十六条第二款，"
    },
    {
      "id": "A35236-zh-00012",
      "text": "将有关申请及领取我们补偿金等的一切权限委托给上述代表。"
    },
    {
      "id": "A35236-zh-00013",
      "text": "年"
    },
