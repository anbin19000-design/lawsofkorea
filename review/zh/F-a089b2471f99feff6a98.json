      "id": "A39601-zh-00037",
      "text": "以5亿韩元为限。"
    },
    {
      "id": "A39601-zh-00038",
      "text": "乙. 违反依本法第5条第3款准用的"
    },
    {
      "id": "A39601-zh-00039",
      "text": "本法第34条第1款"
    },
    {
      "id": "A39601-zh-00040",
      "text": "依据已获批准或变更批准"
    },
    {
      "id": "A39601-zh-00041",
