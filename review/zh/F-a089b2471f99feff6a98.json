    },
    {
      "id": "A26942-zh-00010",
      "text": "2. 违反依本法第5条第3款准用的"
    },
    {
      "id": "A26942-zh-00011",
      "text": "本法第34条第1款第2项"
    },
    {
      "id": "A26942-zh-00012",
      "text": "《机场设施法》第7条第3款，"
    },
    {
      "id": "A26942-zh-00013",
      "text": "未经批准制定实施计划"
    },
    {
      "id": "A26942-zh-00014",
      "text": "或变更已批准的事项"
    },
    {
      "id": "A26942-zh-00015",
      "text": "的情形"
    },
    {
      "id": "A26942-zh-00016",
      "text": "甲. 未经批准制定实施计划"
    },
    {
      "id": "A26942-zh-00017",
      "text": "撤销许可并责令恢复原状"
    },
    {
      "id": "A26942-zh-00018",
      "text": "的情形"
    },
    {
      "id": "A26942-zh-00019",
      "text": "乙. 未经批准变更实施计划"
    },
    {
      "id": "A26942-zh-00020",
      "text": "的情形"
    },
    {
      "id": "A26942-zh-00021",
      "text": "1）未经批准变更实施计划"
    },
    {
      "id": "A26942-zh-00022",
      "text": "暂停实施计划批准效力1个月"
    },
    {
      "id": "A26942-zh-00023",
      "text": "的情形"
    },
    {
      "id": "A26942-zh-00024",
      "text": "2）在1）暂停效力期间，"
    },
    {
      "id": "A26942-zh-00025",
      "text": "撤销批准或责令恢复原状"
    },
    {
      "id": "A26942-zh-00026",
      "text": "未取得实施计划变更批准"
    },
    {
      "id": "A26942-zh-00027",
      "text": "的情形"
    },
    {
      "id": "A26942-zh-00028",
      "text": "3）在1）暂停效力期间，"
    },
    {
      "id": "A26942-zh-00029",
      "text": "对人工构筑物或物品中"
    },
    {
      "id": "A26942-zh-00030",
      "text": "存在未取得实施计划变更批准的"
    },
    {
      "id": "A26942-zh-00031",
      "text": "未取得实施计划变更批准的"
    },
    {
      "id": "A26942-zh-00032",
      "text": "部分，责令改建、变更、迁移、"
    },
    {
      "id": "A26942-zh-00033",
      "text": "拆除或恢复原状"
    },
    {
      "id": "A26942-zh-00034",
      "text": "的情形"
    },
    {
      "id": "A26942-zh-00035",
      "text": "3. 违反依本法第5条第3款准用的"
    },
    {
      "id": "A26942-zh-00036",
      "text": "本法第34条第1款第3项"
    },
    {
      "id": "A26942-zh-00037",
      "text": "《机场设施法》第7条第3款"
    },
    {
      "id": "A26942-zh-00038",
      "text": "已批准或变更批准的"
    },
    {
      "id": "A26942-zh-00039",
      "text": "实施计划的情形"
    },
    {
      "id": "A26942-zh-00040",
      "text": "甲. 违反已批准或变更批准的"
    },
    {
      "id": "A26942-zh-00041",
      "text": "停工1个月"
    },
    {
      "id": "A26942-zh-00042",
      "text": "实施计划的情形"
    },
    {
      "id": "A26942-zh-00043",
      "text": "乙. 在甲目停工期间，"
    },
    {
      "id": "A26942-zh-00044",
      "text": "对人工构筑物或物品"
    },
    {
      "id": "A26942-zh-00045",
      "text": "未取得实施计划变更批准"
    },
    {
      "id": "A26942-zh-00046",
      "text": "责令改建、变更、迁移、"
    },
    {
      "id": "A26942-zh-00047",
      "text": "的情形"
    },
    {
      "id": "A26942-zh-00048",
      "text": "拆除或恢复原状"
    },
    {
      "id": "A26942-zh-00049",
      "text": "丙. 在甲目停工期间，"
    },
    {
      "id": "A26942-zh-00050",
      "text": "人工构筑物或物品中"
    },
    {
      "id": "A26942-zh-00051",
      "text": "存在未取得实施计划变更批准的"
    },
    {
      "id": "A26942-zh-00052",
      "text": "未获批准部分"
    },
    {
      "id": "A26942-zh-00053",
      "text": "的情形"
    },
    {
      "id": "A26942-zh-00054",
      "text": "责令改建、变更、迁移、拆除"
    },
    {
      "id": "A26942-zh-00055",
      "text": "或恢复原状"
    },
    {
      "id": "A26942-zh-00056",
      "text": "4. 因情势变更无法继续"
    },
    {
      "id": "A26942-zh-00057",
      "text": "本法第34条第1款第4项"
    },
    {
      "id": "A26942-zh-00058",
      "text": "撤销许可"
    },
    {
      "id": "A26942-zh-00059",
      "text": "实施统合新机场建设"
    },
    {
      "id": "A26942-zh-00060",
      "text": "项目的情形"
    },
    {
      "id": "A26942-zh-00061",
      "text": "5. 收到本法第33条的命令"
    },
    {
      "id": "A26942-zh-00062",
      "text": "本法第34条第1款第5项"
    },
    {
      "id": "A26942-zh-00063",
      "text": "但未在国土交通部长规定的"
    },
    {
      "id": "A26942-zh-00064",
      "text": "合理期限内采取适当措施"
    },
    {
      "id": "A26942-zh-00065",
      "text": "的情形"
    },
    {
      "id": "A26942-zh-00066",
      "text": "甲. 无正当理由在实施计划"
    },
    {
      "id": "A26942-zh-00067",
      "text": "撤销许可"
    },
    {
      "id": "A26942-zh-00068",
      "text": "许可申请书所列预计开工日起"
    },
    {
      "id": "A26942-zh-00069",
      "text": "一年内未开工，或无正当理由"
    },
    {
      "id": "A26942-zh-00070",
      "text": "未在预计完工日以前"
    },
    {
      "id": "A26942-zh-00071",
      "text": "竣工的情形"
    },
    {
      "id": "A26942-zh-00072",
      "text": "乙. 依本法第5条第3款准用的"
    },
    {
      "id": "A26942-zh-00073",
      "text": "撤销许可"
    },
    {
      "id": "A26942-zh-00074",
      "text": "《机场设施法》第20条第1款"
    },
    {
      "id": "A26942-zh-00075",
      "text": "竣工确认结果，已完成的"
    },
