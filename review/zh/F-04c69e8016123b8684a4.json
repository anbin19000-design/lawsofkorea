    },
    {
      "id": "A16597-zh-00006",
      "text": "办理期限"
    },
    {
      "id": "A16598-zh-00001",
      "text": "■《人体组织安全及管理法》施行规则[附表9]"
    },
    {
      "id": "A16598-zh-00002",
      "text": "组织捐献者登记机构"
    },
    {
      "id": "A16598-zh-00003",
      "text": "停业"
    },
    {
      "id": "A16598-zh-00005",
      "text": "组织捐献支援机构"
    },
    {
      "id": "A16598-zh-00006",
      "text": "终止业务"
    },
    {
      "id": "A16598-zh-00011",
      "text": "停业日期或"
    },
    {
      "id": "A16598-zh-00012",
      "text": "终止日期"
    },
    {
      "id": "A16598-zh-00014",
      "text": "依据《人体组织安全及管理法》第26条第2款及同法施行规则第14条，特此申报。"
    },
    {
      "id": "A16598-zh-00020",
      "text": "保健福祉部长官"
    },
    {
      "id": "B3-zh-00035",
      "text": "补充规定（保健福祉部关于依据《行政规制基本法》部分修订31部法律以调整日落条款等事项的法令）<第606号，2018年12月28日>\n\n本规定自2019年1月1日起施行。\n\n"
    }
  ],
  "status": "COMPLETE"
}