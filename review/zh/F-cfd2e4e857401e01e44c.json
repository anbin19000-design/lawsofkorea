    },
    {
      "id": "A26608-zh-00014",
      "text": "文化体育观光部长"
    },
    {
      "id": "A26608-zh-00015",
      "text": "官印"
    },
    {
      "id": "A26609-zh-00001",
      "text": "■ 《艺术家地位与权利保障法施行规则》［附件第3号格式］"
    },
    {
      "id": "A26609-zh-00002",
      "text": "性骚扰、性暴力预防及受害救济支援机构指定申请书"
    },
    {
      "id": "A26609-zh-00003",
      "text": "受理编号"
    },
    {
      "id": "A26609-zh-00004",
      "text": "受理日期和时间"
    },
    {
      "id": "A26609-zh-00005",
      "text": "处理期限"
    },
    {
      "id": "A26609-zh-00006",
      "text": "60天"
    },
    {
      "id": "A26609-zh-00008",
      "text": "机构或团体名称"
    },
    {
      "id": "A26609-zh-00009",
      "text": "联系方式"
    },
    {
      "id": "A26609-zh-00010",
      "text": "代表人"
    },
    {
      "id": "A26609-zh-00014",
