    {
      "id": "A26607-zh-00048",
      "text": "办理机构"
    },
    {
      "id": "A26608-zh-00001",
      "text": "■ 《艺术家地位与权利保障法施行规则》［附件第2号格式］"
    },
    {
      "id": "A26608-zh-00002",
      "text": "第　　　号"
    },
    {
      "id": "A26608-zh-00003",
      "text": "艺术家工会申报确认书"
    },
    {
      "id": "A26608-zh-00004",
      "text": "艺术家工会名称："
    },
    {
      "id": "A26608-zh-00005",
      "text": "代表人："
    },
    {
      "id": "A26608-zh-00006",
      "text": "艺术活动名称："
    },
    {
      "id": "A26608-zh-00007",
      "text": "合同相对方："
    },
    {
      "id": "A26608-zh-00008",
      "text": "依据《艺术家地位与权利保障法》第14条第1款后段及"
    },
    {
      "id": "A26608-zh-00009",
      "text": "其施行规则第2条第2款，确认已申报"
    },
    {
      "id": "A26608-zh-00010",
