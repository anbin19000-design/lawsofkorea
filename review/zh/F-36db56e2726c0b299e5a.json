    },
    {
      "id": "A39924-zh-00006",
      "text": "办理期限"
    },
    {
      "id": "A39924-zh-00009",
      "text": "主事务所"
    },
    {
      "id": "A39924-zh-00021",
      "text": "依据《庆尚北道、庆尚南道及蔚山市特大森林火灾损害救济及支援等特别法》第5条第1款，"
    },
    {
      "id": "A39924-zh-00023",
      "text": "委员会审议、决议的议题名称"
    },
    {
      "id": "A39924-zh-00024",
      "text": "征求意见事项"
    },
    {
      "id": "A39924-zh-00025",
      "text": "意见内容及理由"
    },
    {
      "id": "A39924-zh-00026",
      "text": "依据《庆尚北道、庆尚南道及蔚山市特大森林火灾损害救济及支援等特别法》第11条第2款及同法施行令，"
    },
    {
      "id": "A39924-zh-00027",
      "text": "第14条第1款，特此提交上述意见。"
    },
    {
