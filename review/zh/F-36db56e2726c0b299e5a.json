    },
    {
      "id": "A39926-zh-00061",
      "text": "市、道知事 ↔ 地方森林厅国有林管理所所长"
    },
    {
      "id": "A39926-zh-00065",
      "text": "国有林管理所所长（林业厅管辖国有林时）"
    },
    {
      "id": "A39926-zh-00069",
      "text": "其他国有林的情形："
    },
    {
      "id": "A39926-zh-00070",
      "text": "与主管部门协商"
    },
    {
      "id": "A39927-zh-00002",
      "text": "危险木清除事业完成通报书"
    },
    {
      "id": "A39927-zh-00003",
      "text": "森林火灾受害现况"
    },
    {
      "id": "A39927-zh-00012",
      "text": "危险木清除数量及材积"
    },
    {
      "id": "A39927-zh-00013",
