:0,"total_rows":94},{"key":"A3252","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":61},{"key":"A3253","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":30},{"key":"A3254","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":31},{"key":"A3255","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":62},{"key":"A3256","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":60},{"key":"A3257","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":74},{"key":"A3258","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":14},{"key":"A3259","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":58},{"key":"A3260","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":64},{"key":"A3261","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":35},{"key":"A3262","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":54},{"key":"A3263","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":42},{"key":"A3264","law_id":"kr-006865-286973-ko","checked_rows":0,"total_rows":48}],
