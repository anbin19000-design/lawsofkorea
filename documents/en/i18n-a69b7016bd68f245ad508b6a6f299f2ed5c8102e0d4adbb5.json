or_inputs\\389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c.ascii.json","sha256":"389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c"},"protocol":"WORKC_P04_1526_EXPLICIT_SOURCE_REVIEWED_AUTHOR_INPUT_V1","reviewed_source_units":[{"source_component_text_sha256":"2fb7bd6f40dafc97c3fe591fd13656f131f2d10c77acbae7b6b54b31cab2dfd8","unit_key":"form-001200F"},{"source_component_text_sha256":"9486d42e7f358af6c08656eb99055e7f13534dfab5962c212fce58b39d0b4648","unit_key":"form-001300F"},{"source_component_text_sha256":"0c06f3f3baf90424eaa2e60628d4453c5b40878a07833b921c7c2796a82bb091","unit_key":"form-001400F"},{"source_component_text_sha256":"e40dfc5e45e4154389a0b54aeaf861b765aa5db1abe74375e28006d402411c0d","unit_key":"form-001500F"}],"source_component_text_sha256":"0c06f3f3baf90424eaa2e60628d4453c5b40878a07833b921c7c2796a82bb091","source_law_id":"kr-006574-270243-ko","source_review_complete":true,"source_xml_sha256":"99129fa87198dde7d65113cb7db1fbce6f402e0eebdd4849d79cfbe3f5e1d12e","target_body_sha256":"62cea1cc93592c7ae27f30e59588034bf74eb4325d83b2523455fb3f2daf1cbd","unit_key":"form-001400F"},"kind":"FORM","matrix_counted":true,"operative_db_projection_sha256":"7d8e715e6d2ac5a700e3b1503c89734c5e2705173284643a2bd51196981a7d2d","operative_db_projection_text":"교통·에너지·환경세면세용도물품[증명신청서·증명서]\n[별지 제14호서식] <개정 2007.4.5>                                         (앞  쪽)  \n\n\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━━┓\n\n\n┃                                  ┌ □증명신청서 ┐                  │처리기간  ┃\n\n\n┃ 교통ㆍ에너지ㆍ환경세면세용도물품 │              │                  ├─────┨\n\n\n┃                                  └ □증  명  서 ┘                  │5일       ┃\n\n\n┠──┬───────────┬─────┬──────────┬───┴─────┨\n\n\n┃신  │① 성  명(대 표 자)   │          │② 주민(법인)등록번호│                  ┃\n\n\n┃청  ├───────────┼─────┼──────────┼─────────┨\n\n\n┃인  │③ 상  호(법 인 명)   │          │④ 전  화   번   호 │                  ┃\n\n\n┃    ├───────────┼─────┴──────────┴─────────┨\n\n\n┃    │⑤ 주  소(본점소재지) │                                                    ┃\n\n\n┠──┴───────────┴──────────────────────────┨\n\n\n┃신      청     내      용                                                         ┃\n\n\n┠────────────┬──────┬──────┬──────┬───────┨\n\n\n┃⑥ 면 세 물 품 명       │⑦ 수     량│⑧ 규     격│⑨ 용     도│⑩ 적     요  ┃\n\n\n┠────────────┼──────┼──────┼──────┼───────┨\n\n\n┃                        │            │            │            │              ┃\n\n\n┠────────────┼──────┴──────┴──────┴───────┨\n\n\n┃⑪ 면   세   근   거    │법 제     조 제    항 제    호                          ┃\n\n\n┠─┬──────────┼────────┬────────────┬──────┨\n\n\n┃실│⑫ 성명(대 표 자)   │                │⑬ 주민(법인)등록번호   │            ┃\n\n\n┃수├──────────┼────────┴────────────┴──────┨\n\n\n┃요│⑭ 상호(법 인 명)   │                                                        ┃\n\n\n┃자├──────────┼────────────────────────────┨\n\n\n┃  │⑮ 주소(본점소재지) │                                                        ┃\n\n\n┃  ├──────────┼────────┬────────────┬──────┨\n\n\n┃  │ 반  입  장  소     │                │ 사업자등록번호         │            ┃\n\n\n┠─┴──────────┼────────┴────────────┴──────┨\n\n\n┃ 참   고   사   항      │                                                        ┃\n\n\n┠────────────┴────────────────────────────┨\n\n\n┃   위의 물품이 「교통ㆍ에너지ㆍ환경세법」 [□제15조제1항제(  )호 □제16조제(  )호]에 해당┃\n\n\n┃함을 동법 시행령 제22조제2항에 따라 증명하여 주시기 바랍니다.                     ┃\n\n\n┃                                                                                  ┃\n\n\n┃      년       월       일                                                        ┃\n\n\n┃                                                      신청인         (서명 또는 인)┃\n\n\n┃       장  관                                                                     ┃\n\n\n┃                귀하                                                              ┃\n\n\n┃       기관장                                                                     ┃\n\n\n┠─────────────────────────────────────────┨\n\n\n┃   제      호                                                                     ┃\n\n\n┃      위 사실을 증명합니다.                                                       ┃\n\n\n┃                                                                                  ┃\n\n\n┃      년       월       일                                                        ┃\n\n\n┃                                                                 장  관           ┃\n\n\n┃                                                                              ??┃\n\n\n┃                                                                 기관장           ┃\n\n\n┃               귀하                                                               ┃\n\n\n┠────────────────────────────────────┬────┨\n\n\n┃   구비서류 : 없 음                                                     │수 수 료┃\n\n\n┃  ※ 이 신청서는 무료로 배부합니다.                                     ├────┨\n\n\n┃                                                                        │없    음┃\n\n\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┷━━━━┛\n\n\n  일반용지 60g/㎡(재활용품) 또는 신문용지 54g/㎡(재활용품)                            \n\n\n                                                                                      \n\n\n\n\n\n\n                                              \n\n\n  (뒤쪽)                                      \n\n\n┏━━━━━━━━━━━━━━━━━━━━━┓\n\n\n┃이 신청서는 아래와 같이 처리됩니다.       ┃\n\n\n┠──────────┬──────────┨\n\n\n┃신청인              │처리기관            ┃\n\n\n┃                    ├──────────┨\n\n\n┃                    │사업장 관할 세무서장┃\n\n\n┠──────────┼──────────┨\n\n\n┃                    │                    ┃\n\n\n┃┌────────┐│    ┌──────┐┃\n\n\n┃│신청서작성      ││  ▶│접수        │┃\n\n\n┃│                ├┼─  │(민원봉사실)│┃\n\n\n┃│                ││    │            │┃\n\n\n┃└────────┘│    └┬─────┘┃\n\n\n┃  ▲                │      │            ┃\n\n\n┃                    │                    ┃\n\n\n┃  │증명서 교부     │      ▼            ┃\n\n\n┃  │                │    ┌──────┐┃\n\n\n┃  │                │    │조사ㆍ확인  │┃\n\n\n┃  │                │    │(소관 기관) │┃\n\n\n┃  │                │    └┬─────┘┃\n\n\n┃  │                │      │            ┃\n\n\n┃  │                │                    ┃\n\n\n┃  │                │      ▼            ┃\n\n\n┃  │                │    ┌──────┐┃\n\n\n┃  │                │    │결재        │┃\n\n\n┃  │                │    └┬─────┘┃\n\n\n┃  │                │      │            ┃\n\n\n┃  │                │                    ┃\n\n\n┃  │                │      ▼            ┃\n\n\n┃  │                │    ┌──────┐┃\n\n\n┃  └────────┼──┤증명서 작성 │┃\n\n\n┃                    │    │            │┃\n\n\n┃                    │    └──────┘┃\n\n\n┃                    │                    ┃\n\n\n┗━━━━━━━━━━┷━━━━━━━━━━┛","registered_author_completion":{"author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c.ascii.json","sha256":"389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c"},"handoff":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_completions\\389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c.json","sha256":"c7ae6b500f8cd8a98a8b58cf24f72ccbece8ba3c58142be0a559682da67e9a42"},"registration":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\direct_ingest_v1\\registered_author_handoffs\\389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c.json","sha256":"76d7ca435043db40a4ef4d2a3c5dde9f907b2a5b4b78a63e1cc13b1fed878d08"}},"source_component_text_sha256":"0c06f3f3baf90424eaa2e60628d4453c5b40878a07833b921c7c2796a82bb091","source_graphic_observation_sha256":null,"source_graphic_reconciliation_sha256":null,"source_graphics":[{"asset_byte_length":37358,"asset_file":"D:\\lawsofkorea\\pro