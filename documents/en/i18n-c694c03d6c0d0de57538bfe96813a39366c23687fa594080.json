f56f8b1f9257268fc967c"},"protocol":"WORKC_P04_1526_EXPLICIT_SOURCE_REVIEWED_AUTHOR_INPUT_V1","reviewed_source_units":[{"source_component_text_sha256":"a8a55228e81f669861fc86c2cdce06bc9342282484eaec675c714dea54b1724e","unit_key":"form-001600F"},{"source_component_text_sha256":"3c6185744fa2952f4afacd7cf751cf95dd934e6e064c20fe25b9ada599084be6","unit_key":"form-001700F"}],"source_component_text_sha256":"3c6185744fa2952f4afacd7cf751cf95dd934e6e064c20fe25b9ada599084be6","source_law_id":"kr-006574-270243-ko","source_review_complete":true,"source_xml_sha256":"99129fa87198dde7d65113cb7db1fbce6f402e0eebdd4849d79cfbe3f5e1d12e","target_body_sha256":"841ab75cbadd39ccd9ec94cc9eb40bb5043591c2867cb173c67efe7265deb6b4","unit_key":"form-001700F"},"kind":"FORM","matrix_counted":true,"operative_db_projection_sha256":"735a3e9caa48ec656e3beb00c60babae635cd07b07d83f1fc327e64b4d8e8dca","operative_db_projection_text":"교통·에너지·환경세면세물품폐기[승인신청서·승인서]\n[별지 제17호서식] <개정 2007.4.5>                                        (앞  쪽)   \n\n\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━━┓\n\n\n┃                                       ┌ □승인신청서 ┐             │처리기간  ┃\n\n\n┃      교통ㆍ에너지ㆍ환경세면세물품폐기 │              │             ├─────┨\n\n\n┃                                       └ □승  인  서 ┘             │5일       ┃\n\n\n┠───┬───────────┬──┬───────────┬────┴─────┨\n\n\n┃신 ? │① 성  명(대 표 자)   │    │② 주민(법인)등록번호 │                    ┃\n\n\n┃   반 ├───────────┼──┼───────────┼──────────┨\n\n\n┃청 입 │③ 상  호(법 인 명)   │    │④ 전  화   번   호   │                    ┃\n\n\n┃   자 ├───────────┼──┴───────────┴──────────┨\n\n\n┃인 ? │⑤ 주  소(본점소재지) │                                                  ┃\n\n\n┃      ├───────────┼──┬───────────┬──────────┨\n\n\n┃      │⑥ 반입 또는 설치장소 │    │⑦ 사업자등록번호     │                    ┃\n\n\n┠───┴───────────┴──┴───────────┴──────────┨\n\n\n┃신      청     내      용                                                         ┃\n\n\n┠─────┬─────┬─────┬─────┬─────┬────┬──────┨\n\n\n┃⑧ 품   명│⑨ 수   량│⑩ 규   격│⑪ 단   가│⑫ 가   격│⑬ 세 율│⑭ 세  액   ┃\n\n\n┠─────┼─────┼─────┼─────┼─────┼────┼──────┨\n\n\n┃          │          │          │          │          │        │            ┃\n\n\n┠─────┼─────┼─────┼─────┼─────┼────┼──────┨\n\n\n┃          │          │          │          │          │        │            ┃\n\n\n┠───┬─┴─────┴────┬┴─────┴─────┴────┴──────┨\n\n\n┃반    │⑮ 성명 또는 상호(법인명)│                                                ┃\n\n\n┃출    ├────────────┼────────────────────────┨\n\n\n┃자    │ 주소 또는 제조장소재지 │                                                ┃\n\n\n┠───┴────────────┼────────────────────────┨\n\n\n┃ 반      입      사     유      │                                                ┃\n\n\n┠────────────────┼────────────────────────┨\n\n\n┃ 반   입  연   월   일          │   년        월        일                       ┃\n\n\n┠────────────────┼────────────────────────┨\n\n\n┃ 폐     기     사     유        │                                                ┃\n\n\n┠────────────────┼────────────────────────┨\n\n\n┃ 참     고      사      항      │                                                ┃\n\n\n┠────────────────┴────────────────────────┨\n\n\n┃    위의 물품을 소정용도에 사용할 수 없으므로 「교통ㆍ에너지ㆍ환경세법 시행령」 제23┃\n\n\n┃조제3항에 따라 폐기하기 위하여 그 승인을 신청합니다.                              ┃\n\n\n┃      년       월       일                                                        ┃\n\n\n┃                                                                                  ┃\n\n\n┃                                                   신청인             (서명 또는 인)┃\n\n\n┃              세무서장  귀하                                                      ┃\n\n\n┠─────────────────────────────────────────┨\n\n\n┃  제     호                                                                       ┃\n\n\n┃     위와 같이 면세물품의 폐기를 승인합니다.                                      ┃\n\n\n┃      년       월       일                                                        ┃\n\n\n┃                                                             세무서장   [인]      ┃\n\n\n┃               귀하                                                               ┃\n\n\n┠────────────────────────────────────┬────┨\n\n\n┃   구비서류 : 없  음                                                    │수 수 료┃\n\n\n┃  ※ 이 신청서는 무료로 배부합니다.                                     ├────┨\n\n\n┃                                                                        │없    음┃\n\n\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┷━━━━┛\n\n\n  일반용지 60g/㎡(재활용품) 또는 신문용지 54g/㎡(재활용품)                            \n\n\n                                                                                      \n\n\n\n\n\n\n                                        \n\n\n  (뒤쪽)                                \n\n\n┏━━━━━━━━━━━━━━━━━━┓\n\n\n┃   이 신청서는 아래와 같이 처리됩니다.┃\n\n\n┠───────┬──────────┨\n\n\n┃신청인        │처리기관            ┃\n\n\n┃              ├──────────┨\n\n\n┃              │사업장 관할 세무서장┃\n\n\n┠───────┼──────────┨\n\n\n┃              │                    ┃\n\n\n┃┌─────┐│    ┌──────┐┃\n\n\n┃│신청서작성││  ▶│접수        │┃\n\n\n┃│          ├┼─  │(민원봉사실)│┃\n\n\n┃│          ││    │            │┃\n\n\n┃└─────┘│    └┬─────┘┃\n\n\n┃▲            │      │            ┃\n\n\n┃              │      │            ┃\n\n\n┃  │승        │                    ┃\n\n\n┃  │인        │      ▼            ┃\n\n\n┃  │서        │    ┌──────┐┃\n\n\n┃  │          │    │조사ㆍ확인  │┃\n\n\n┃  │교        │    │(담당과)    │┃\n\n\n┃  │부        │    └┬─────┘┃\n\n\n┃  │          │      │            ┃\n\n\n┃  │          │                    ┃\n\n\n┃  │          │      ▼            ┃\n\n\n┃  │          │    ┌──────┐┃\n\n\n┃  │          │    │결재        │┃\n\n\n┃  │          │    │(과장 전결) │┃\n\n\n┃  │          │    └┬─────┘┃\n\n\n┃  │          │      │            ┃\n\n\n┃  │          │                    ┃\n\n\n┃  │          │      ▼            ┃\n\n\n┃  │          │    ┌──────┐┃\n\n\n┃  │          │    │승인서 작성 │┃\n\n\n┃  └─────┼──┤(담당과)    │┃\n\n\n┃              │    │            │┃\n\n\n┃              │    └──────┘┃\n\n\n┃              │                    ┃\n\n\n┗━━━━━━━┷━━━━━━━━━━┛","registered_author_completion":{"author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\16c6d617c56f2dc77f0bfab36622a97219e953ce5e6f56f8b1f9257268fc967c.ascii.json","sha256":"16c6d617c56f2dc77f0bfab36622a97219e953ce5e6f56f8b1f9257268fc967c"},"handoff":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_completions\\16c6d617c56f2dc77f0bfab36622a97219e953ce5e6f56f8b1f9257268fc967c.json","sha256":"ee1a7f068c972d5e9710beef7dba4be1ce393d0320a4a85bd4c9e6eac357d352"},"registration":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\direct_ingest_v1\\registered_author_handoffs\\16c6d617c56f2dc77f0bfab36622a97219e953ce5e6f56f8b1f9257268fc967c.json","sha256":"0220065a62fb100f57376c5b057869ea9611609824430595bdc49cb441905bbb"}},"source_component_text_sha256":"3c6185744fa2952f4afacd7cf751cf95dd934e6e064c20fe25b9ada599084be6","source_graphic_observation_sha256":null,"source_graphic_reconciliation_sha256":null,"source_graphics":[{"asset_byte_length":38416,"asset_file":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\source_assets_v1\\assets\\RULE\\150201603.gif","asset_key":"RULE_150201603","asset_sha256":"bd73dd3c827cfc2b97a5d70277bed1027f243d6e7f70e45b438cd762dc045477","component":"RULE","final_url":"https://www.law.go.kr/LSW/flDownload.do?flSeq=150201603","graphic_path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\source_assets_v1\\assets\\RULE\\150201603.gif","graphic_sha256":"bd73dd3c827cfc2b97a5d70277bed1027f243d6e7f70e45b438cd762dc045477","http_status_code":200,"image"