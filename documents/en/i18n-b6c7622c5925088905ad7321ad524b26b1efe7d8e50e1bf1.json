b4dc4602b73cbf549c1577cc989d04ac2a7aaf4c52c1bc15","unit_count":0}],"changes":[{"new_text":"(A","old_text":"O","operation":"replace","original_end":48339,"original_start":48338,"reason":"Restore all four omitted tax-name/statute-name replacements in paragraph4; existing paragraphs1-3 exact reuse.","target_end":850,"target_start":848},{"new_text":"endmen","old_text":"i","operation":"replace","original_end":48341,"original_start":48340,"reason":"Restore all four omitted tax-name/statute-name replacements in paragraph4; existing paragraphs1-3 exact reuse.","target_end":857,"target_start":851},{"new_text":" of another statu","old_text":"","operation":"insert","original_end":48342,"original_start":48342,"reason":"Restore all four omitted tax-name/statute-name replacements in paragraph4; existing paragraphs1-3 exact reuse.","target_end":875,"target_start":858},{"new_text":") The Enforcement Decree of the Inter-Korean Exchange an","old_text":"","operation":"insert","original_end":48344,"original_start":48344,"reason":"Restore all four omitted tax-name/statute-name replacements in paragraph4; existing paragraphs1-3 exact reuse.","target_end":933,"target_start":877},{"new_text":" Cooperation Act is amended as follows:\nIn Article 51 (2), \"special consumption tax and liquor tax\" is replaced by \"special consumption tax, liquor tax and traffic tax\", and \"the Special Consumption Tax Act or the Liquor Tax Act\" is replaced by \"the Special Consumption Tax Act, the Liquor Tax Act or the Traffic Tax Act\"; in paragraph (3) of that Article, \"the Special Consumption Tax Act and the Liquor Tax Act\" is replaced by \"the Special Consumption Tax Act, the Liquor Tax Act and the Traffic Tax Act\"","old_text":"","operation":"insert","original_end":48345,"original_start":48345,"reason":"Restore all four omitted tax-name/statute-name replacements in paragraph4; existing paragraphs1-3 exact reuse.","target_end":1440,"target_start":934},{"new_text":"\nIn Article 52 (1), \"special consumption tax and liquor tax\" is replaced by \"special consumption tax, liquor tax and traffic tax\".","old_text":"","operation":"insert","original_end":48346,"original_start":48346,"reason":"Restore all four omitted tax-name/statute-name replacements in paragraph4; existing paragraphs1-3 exact reuse.","target_end":1571,"target_start":1441}],"evidence_file":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\english_reuse_analysis_v1\\preserved_db_texts\\kr-002619-288439-en.txt","evidence_file_sha256":"a9b0bfc70a27552562e7968a943b25456511d98d46a8f21ab5ec28a20ca464f2","reused_spans":[{"end":48338,"start":47490,"target_end":848,"target_start":0,"text_sha256":"2027c853a3afdd72fe5a1e84ee00d798ff790216a07011cc41570edd45334c13"}],"scope_plan_file":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\english_reuse_analysis_v1\\DECREE_exact_reuse_scope_plan_v1.json","scope_plan_sha256":"f4c4869ba5fc8def4162bfeb76a6cc64715aeb9a1b12dab01f6f453627a9ab4a","source_body_sha256":"a9b0bfc70a27552562e7968a943b25456511d98d46a8f21ab5ec28a20ca464f2","source_language":"en","source_law_id":"kr-002619-288439-en","source_text_role":"OFFICIAL_TRANSLATION","source_unit_span":{"boundary_note":"Actual complete English unit span; adjacent standalone date/number metadata excluded.","end":48346,"start":47490,"text":"ADDENDA <Presidential Decree No. 14078, Dec. 31, 1993>\n(1) (Enforcement date) This Decree shall enter into force on January 1, 1994.\n(2) (General applicability) This Decree shall apply beginning with the first taxable articles shipped from the manufacturing place, or for which an import declaration is filed, as of January 1, 1994.\n(3) (Transitional measures concerning application for deduction of amount of tax) A person who intends to obtain a deduction from or refund on a special consumption tax already paid pursuant to the former Special Consumption Tax Act, from the amount of traffic tax pursuant to the proviso to Article 5 of the Addenda of the Act, shall submit an application under Article 24 to the head of the competent tax office or customs office, along with the documents specified in the former Special Consumption Tax Act.\n(4) Omitted.","text_sha256":"b32533a1d7b6d2f1820f870735e79b605083f3c17c910f8a9b447da0a448c466"},"version_scope_claim":"Same held edition288439, but only the individually compared complete source units are reusable; no full English-edition completeness is claimed."},"source_component_text_sha256":"cf19e77b37845b4e392b289b786f431e8e8381a09b50cde4fbe248198a95e6de","source_graphic_observation_sha256":null,"source_graphic_reconciliation_sha256":null,"source_graphics":[],"source_kind":"OTHER","source_unit_evidence_hash_basis":{"source_component_text_sha256":"cf19e77b37845b4e392b289b786f431e8e8381a09b50cde4fbe248198a95e6de","source_graphic_observation_sha256":null,"source_graphic_reconciliation_sha256":null,"source_graphics":[],"source_law_id":"kr-002619-288439-ko","source_xml_sha256":"6fddccc8dd40d065ba4af293d38ee89d2ecaf5b6b4ebb45961fc19ab8c83311e","unit_key":"addenda-14078-19931231"},"source_unit_evidence_sha256":"e6405f5d0ab81918ae25a385f4429308d28ba8b611727b54cf37a4aefc8c8ff3","source_unit_ordinal":31,"source_xml_attributes":{"부칙키":"1993123114078"},"source_xml_tag":"부칙단위","target_body_sha256":"89a5340ffb8c791bfd85d228ed6d6d2f1dcd4875ffcaab78e613f95e1be6f023","target_ordinal":0,"unit_key":"addenda-14078-19931231"}],"structural_heading_count":0,"task_id":"WORKC_1129_2094","translation_complete":true,"unresolved_source_graphics":[],"untranslated_fragments":[],"version_match_status":"NOT_CHECKED","visual_reconciliation_overlay":[],"whole_bundle_complete":false,"worker_id":"WORKC_G01_P04","worker_instance_id":"WORKC_G01_P04_R2_20261019_1412","worker_self_check_record":{"path":"\\\\100.90.87.105\\YOLLA-D\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\