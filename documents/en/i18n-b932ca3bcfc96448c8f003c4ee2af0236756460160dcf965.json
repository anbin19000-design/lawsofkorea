6cea2576e"},"source_temporal_metadata":{"effective":"2025-03-21","promulgated":"2025-03-21"},"source_unit_count":1,"source_unit_map":[{"api_kind":"FORM","author_source_review_evidence":{"exact_author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\6d559247d8075002f80d1333f56599e3e0e006825ca6a44c55cebfa2837e27a6.ascii.json","sha256":"6d559247d8075002f80d1333f56599e3e0e006825ca6a44c55cebfa2837e27a6"},"protocol":"WORKC_P04_1526_EXPLICIT_SOURCE_REVIEWED_AUTHOR_INPUT_V1","reviewed_source_units":[{"source_component_text_sha256":"3f5f43155bef600eca0ba92d4d5c3d1900dce1e946c245f8cce550a3b8f1d29c","unit_key":"form-000900F"},{"source_component_text_sha256":"557fc57d38074852565002dedbddfbd84e5f5f29619fd1b618a43ddad60fad68","unit_key":"form-000902F"}],"source_component_text_sha256":"3f5f43155bef600eca0ba92d4d5c3d1900dce1e946c245f8cce550a3b8f1d29c","source_law_id":"kr-006574-270243-ko","source_review_complete":true,"source_xml_sha256":"99129fa87198dde7d65113cb7db1fbce6f402e0eebdd4849d79cfbe3f5e1d12e","target_body_sha256":"b49c502fd68babb16734bd2caf5d31d2c3626425ac38395bc83567df2d884c88","unit_key":"form-000900F"},"kind":"FORM","matrix_counted":true,"operative_db_projection_sha256":"35f35bbac99c2982d1a9ac60b86a3eda32f80e4d8947a2dde67039f059eec506","operative_db_projection_text":"교통·에너지·환경세[□미납세□면세]물품[□반입신고서□반입증명신청서□반입증명서]\n[별지 제9호서식] <개정 2007.4.5>                                        (앞  쪽)                  \n\n\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━━━━━━┓\n\n\n┃                      ┌ □미납세 ┐    ┌ □반 입 신 고 서 ┐              │처리기간          ┃\n\n\n┃ 교통ㆍ에너지ㆍ환경세 │          │물품│ □반입증명신청서 │              ├─────────┨\n\n\n┃                      └ □면  세 ┘    └ □반 입 증 명 서 ┘              │5일               ┃\n\n\n┠───┬─────────┬───────────┬───────────┬┴─────────┨\n\n\n┃신    │① 성  명(대 표 자)│                      │② 주민(법인)등록번호 │                    ┃\n\n\n┃청 반 ├─────────┼───────────┼───────────┼──────────┨\n\n\n┃인 입 │③ 상  호(법 인 명)│                      │④ 전  화   번   호   │                    ┃\n\n\n┃   자 ├─────────┼───────────┴───────────┴──────────┨\n\n\n┃및    │⑤ 주  소(본점소재지)│                                                                    ┃\n\n\n┃      ├─────────┼───────────┬───────────┬──────────┨\n\n\n┃      │⑥ 반   입   장   소│                      │⑦ 사업자등록번호     │                    ┃\n\n\n┃      ├─────────┼───────────┼───────────┼──────────┨\n\n\n┃      │⑧ 반 입 연 월 일 │        년    월    일│⑨ 반입증명서제출기한 │      년    월    일┃\n\n\n┠───┼─────────┼───────────┴───────────┴──────────┨\n\n\n┃반    │⑩ 성  명(대 표 자)│                                                                    ┃\n\n\n┃출    ├─────────┼──────────────────────────────────┨\n\n\n┃자    │⑪ 상  호(법 인 명)│                                                                    ┃\n\n\n┃      ├─────────┼──────────────────────────────────┨\n\n\n┃      │⑫ 주  소(본점소재지)│                                                                    ┃\n\n\n┃      ├─────────┼───────────┬───────────┬──────────┨\n\n\n┃      │⑬ 반   출   장   소│                      │⑭ 사업자등록번호     │                    ┃\n\n\n┃      ├─────────┼───────────┼───────────┼──────────┨\n\n\n┃      │⑮ 반출승인번호   │제         호         │ 반출승인연월일       │     년    월    일 ┃\n\n\n┠───┴─────────┴───────────┴───────────┴──────────┨\n\n\n┃신      청     내      용                                                                       ┃\n\n\n┠────┬───┬─────┬────┬──────┬────┬───────┬────────┨\n\n\n┃ 품  명 │ 수 량│ 규  격   │ 단   가│ 가   격    │ 세  율 │ 세  액       │ 적  요         ┃\n\n\n┠────┼───┼─────┼────┼──────┼────┼───────┼────────┨\n\n\n┃        │      │          │        │            │        │              │                ┃\n\n\n┠────┼───┼─────┼────┼──────┼────┼───────┼────────┨\n\n\n┃        │      │          │        │            │        │              │                ┃\n\n\n┠────┴───┴───┬─┴────┴──────┴────┴───────┴────────┨\n\n\n┃ 반    입     사    유  │「교통ㆍ에너지ㆍ환경세법」  제   조제   항제   호                     ┃\n\n\n┠────────────┼───────────────────────────────────┨\n\n\n┃ 참     고     사     항│                                                                      ┃\n\n\n┠────────────┴───────────────────────────────────┨\n\n\n┃                                                ┌□ 제12조제2항 ┐                             ┃\n\n\n┃  위와 같이 반입하였음을 「교통ㆍ에너지ㆍ환경세법」 │□ 제12조제5항 │에 따라 신고하           ┃\n\n\n┃며,                                                                                             ┃\n\n\n┃                                                └□ 제15조제3항 ┘                             ┃\n\n\n┃ 이를 증명하여 주시기 바랍니다.                                                                 ┃\n\n\n┃      년       월       일                                                                      ┃\n\n\n┃                                                     신청인          (서명 또는 인)             ┃\n\n\n┃                                                                                                ┃\n\n\n┃      세무서장ㆍ세관장   귀하                                                                   ┃\n\n\n┃                                                                                                ┃\n\n\n┠────────────────────────────────────────────────┨\n\n\n┃  제     호                                                                                     ┃\n\n\n┃     위 반입사실에 관하여 틀림이 없음을 증명합니다.                                             ┃\n\n\n┃      년       월       일                                                                      ┃\n\n\n┃                                                 세무서장                                       ┃\n\n\n┃                                                                  ??                          ┃\n\n\n┃                                                 세 관 장                                       ┃\n\n\n┃               귀하                                                                             ┃\n\n\n┠────────────────────────────────────────┬───────┨\n\n\n┃   구비서류 : 없 음                                                             │수 수 료      ┃\n\n\n┃  ※ 이 신고서ㆍ신청서는 무료로 배부합니다.                                     ├───────┨\n\n\n┃                                                                                │없    음      ┃\n\n\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┷━━━━━━━┛\n\n\n  일반용지 60g/㎡(재활용품) 또는 신문용지 54g/㎡(재활용품)                                          \n\n\n                                                                                                    \n\n\n\n\n\n\n                                                                \n\n\n  (뒤쪽)                                                        \n\n\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n\n\n┃이  [   신고서      ]   는 아래와 같이 처리됩니다.          ┃\n\n\n┃        신청서                                              ┃\n\n\n┠────────────────────┬─────────┨\n\n\n┃신청인                                  │처리기관          ┃\n\n\n┃                                        ├─────────┨\n\n\n┃                                        │사업장 관할 세무서장ㆍ세관장┃\n\n\n┠────────────────────┼─────────┨\n\n\n┃                                        │                  ┃\n\n\n┃  ┌─────────────────┐│    ┌─────┐┃\n\n\n┃  │        [   신고서        ]   작성││  ▶│접수      │┃\n\n\n┃  │            신청서                ││    │(민원봉사실)│┃\n\n\n┃  │                                  ├┼─  │          │┃\n\n\n┃  │                                  ││    │          │┃\n\n\n┃  │                                  ││    │          │┃\n\n\n┃  └─────────────────┘│    └──┬──┘┃\n\n\n┃                   ▲                   │          │      ┃\n\n\n┃                                        │          │      ┃\n\n\n┃                        │증            │                  ┃\n\n\n┃                        │명            │          ▼      ┃\n\n\n┃                        │서            │    ┌─────┐┃\n\n\n┃                        │              │    │조사ㆍ확인│┃\n\n\n┃                        │교            │    │(담당과)  │┃\n\n\n┃                        │부            │    │          │┃\n\n\n┃                        │              │    └──┬──┘┃\n\n\n┃                        │              │          │      ┃\n\n\n┃                        │              │          │      ┃\n\n\n┃                        │              │                  ┃\n\n\n┃                        │              │          ▼      ┃\n\n\n┃                        │              │    ┌─────┐┃\n\n\n┃                        │              │    │결재      │┃\n\n\n┃                        │              │    │(과장전결)│┃\n\n\n┃                        │              │    │          │┃\n\n\n┃                        │              │    └──┬──┘┃\n\n\n┃                        │              │          │      ┃\n\n\n┃                        │              │          │      ┃\n\n\n┃                        │              │                  ┃\n\n\n┃                        │              │          ▼      ┃\n\n\n┃                        │              │    ┌─────┐┃\n\n\n┃                        │              │    │증명서작성│┃\n\n\n┃                        │              │    │(담당과)  │┃\n\n\n┃                        └───────┼──┤          │┃\n\n\n┃                                        │    │          │┃\n\n\n┃                                        │    └─────┘┃\n\n\n┃                                        │                  ┃\n\n\n┗━━━━━━━━━━━━━━━━━━━━┷━━━━━━━━━┛","registered_author_completion":{"author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\6d559247d8075002f80d1333f56599e3e0e006825ca6a44c55cebfa2837e27a6.ascii.json","sha256":"6d559247d8075002f80d1333f56599e3e0e006825ca6a44c55cebfa2837e27a6"},"handoff":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_completions\\6d559247d8075002f80d1333f56599e3e0e0