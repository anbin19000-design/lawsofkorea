\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\inputs\\WORKC_G01_P04\\1526_KR000623\\input.json","sha256":"1ee35405fe8c3d62bb816f49521ea183deb41c3dd14127620f32deea77a0f0bc"}},"source_body_sha256":"7bd623af6060bfd50edb71abc63b86d4ec5a576eea43c2bc1a81f333937619f8","source_component_text_sha256":"a004ad3a1d00a7af8ad5eeac336ce56b09488041a67b8112131c0ee16bd531b0","source_fragment_reuse_evidence":[],"source_preflight_record":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\direct_ingest_v1\\source_preflight.json","sha256":"2409d936caebd3d3fc85c6834dc423bfebd463ce3c7fd173c293a126cea2576e"},"source_temporal_metadata":{"effective":"2025-03-21","promulgated":"2025-03-21"},"source_unit_count":1,"source_unit_map":[{"api_kind":"FORM","author_source_review_evidence":{"exact_author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\6359b73f81653f476890a6d46701142e73db5ca35ef65591706a8332ea1df4cb.ascii.json","sha256":"6359b73f81653f476890a6d46701142e73db5ca35ef65591706a8332ea1df4cb"},"protocol":"WORKC_P04_1526_EXPLICIT_SOURCE_REVIEWED_AUTHOR_INPUT_V1","reviewed_source_units":[{"source_component_text_sha256":"a004ad3a1d00a7af8ad5eeac336ce56b09488041a67b8112131c0ee16bd531b0","unit_key":"form-002300F"}],"source_component_text_sha256":"a004ad3a1d00a7af8ad5eeac336ce56b09488041a67b8112131c0ee16bd531b0","source_law_id":"kr-006574-270243-ko","source_review_complete":true,"source_xml_sha256":"99129fa87198dde7d65113cb7db1fbce6f402e0eebdd4849d79cfbe3f5e1d12e","target_body_sha256":"7ab2161fd558d203ef7982aef6414bc693a2d4a2727a355bcbc411b14b40654c","unit_key":"form-002300F"},"kind":"FORM","matrix_counted":true,"operative_db_projection_sha256":"20dafce6db92c3f854c7911659cffed020523e5b33cb2164dcab56fc03504212","operative_db_projection_text":"제조장 단위 과세 전환신고서\n■ 교통ㆍ 에너지ㆍ 환경세법 시행규칙 [별지 제23호서식] <신설 2014.3.14>                       \n\n\n                                                                                                \n\n\n  제조장 단위 과세 전환신고서                                                                   \n\n\n                                                                                                \n\n\n                                                                                                \n\n\n─────────────┬──────────┬───────────────────────\n\n\n  접수번호                │접수일              │처리기간                         즉시         \n\n\n─────────────┴──────────┴───────────────────────\n\n\n                                                                                                \n\n\n──────┬────────────────┬────────────────────────\n\n\n  신고인    │상호(법인명)                    │사업자등록번호                                  \n\n\n  인적사항  ├────────────────┼────────────────────────\n\n\n            │성명(대표자)                    │전화번호                                        \n\n\n            ├────────────────┴────────────────────────\n\n\n            │제조장(주된 제조장) 소재지                                                        \n\n\n            ├────────────────┬────────────────────────\n\n\n            │업태                            │종목                                            \n\n\n──────┴───────────┬────┼───────────────┬────────\n\n\n   사업자 단위 과세 적용 제조장 개수│        │사업자 단위 과세              │   .    .부터   \n\n\n                                    │        │포기 과세기간                 │                \n\n\n──────────────────┴────┴───────────────┴────────\n\n\n                                                                                                \n\n\n────────────────────────────────────────────────\n\n\n  신고내용                                                                                      \n\n\n──────┬────┬──────────┬───────────────┬─────────\n\n\n  구분      │일련번호│사업의 종류         │제조장 소재지                 │상호              \n\n\n            │        ├───────┬──┤                              │(법인명)          \n\n\n            │        │업태          │종목│                              │                  \n\n\n──────┼────┼───────┼──┼───────────────┼─────────\n\n\n  본점 또는 │0000    │              │    │                              │                  \n\n\n  주사무소  │        │              │    │                              │                  \n\n\n──────┼────┼───────┼──┼───────────────┼─────────\n\n\n  종된      │0001    │              │    │                              │                  \n\n\n  제조장    ├────┼───────┼──┼───────────────┼─────────\n\n\n            │0002    │              │    │                              │                  \n\n\n            ├────┼───────┼──┼───────────────┼─────────\n\n\n            │0003    │              │    │                              │                  \n\n\n            ├────┼───────┼──┼───────────────┼─────────\n\n\n            │0004    │              │    │                              │                  \n\n\n            ├────┼───────┼──┼───────────────┼─────────\n\n\n            │0005    │              │    │                              │                  \n\n\n──────┼────┴───────┴──┴───────────────┴─────────\n\n\n  전환사유  │                                                                                  \n\n\n──────┴─────────────────────────────────────────\n\n\n                                                                                                \n\n\n                                                                                                \n\n\n  「교통ㆍ에너지ㆍ환경세법 시행령」 제25조 제5항에 따라 각 제조장별 신고ㆍ납부의 방법을 적용받기 위  \n\n\n  하여 사업장 단위 과세 전환을 신고합니다.                                                      \n\n\n                                                                                                \n\n\n                                                                                     년     월     일  \n\n\n                                                                                                \n\n\n  신고인                                     (서명 또는 인)                                     \n\n\n                                                                                                \n\n\n  세무서장                귀하                                                                  \n\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n\n                                                                                                \n\n\n                                                                                                \n\n\n                                                                                                \n\n\n───────┬─────────────────────────────────┬──────\n\n\n  첨부서류    │ 없음                                                             │수수료      \n\n\n              │                                                                  │없 음       \n\n\n───────┴─────────────────────────────────┴──────\n\n\n                                                                                                \n\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n\n  작 성 방 법                                                                                   \n\n\n────────────────────────────────────────────────\n\n\n   ※ 종된 제조장이 5개를 초과하는 경우에도 5개까지만 작성합니다.                               \n\n\n────────────────────────────────────────────────\n\n\n  210mm×297mm[백상지 80g/㎡ 또는 중질지 80g/㎡]","preserved_ai_translation_evidence":{"changes":[],"preserved_body_sha256":"7ab2161fd558d203ef7982aef6414bc693a2d4a2727a355bcbc411b14b40654c","preserved_text_file":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_errata\\incoming_en_rule_tail_readonly_review_v1\\preserved_observed_bytes_v2\\body\\form-002300F.txt","preserved_text_file_sha256":"7ab2161fd558d203ef7982aef6414bc693a2d4a