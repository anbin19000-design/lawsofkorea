_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8.ascii.json","sha256":"a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8"},"protocol":"WORKC_P04_1526_EXPLICIT_SOURCE_REVIEWED_AUTHOR_INPUT_V1","reviewed_source_units":[{"source_component_text_sha256":"864f46fc9e3ef54987f62687924080f898cfa33f05b6c7ca797cc723577766ee","unit_key":"form-001000F"},{"source_component_text_sha256":"7e57073c7af5751fc175897ecc215ea7b44af817c0024e3150d9a05cf4031892","unit_key":"form-001100F"}],"source_component_text_sha256":"864f46fc9e3ef54987f62687924080f898cfa33f05b6c7ca797cc723577766ee","source_law_id":"kr-006574-270243-ko","source_review_complete":true,"source_xml_sha256":"99129fa87198dde7d65113cb7db1fbce6f402e0eebdd4849d79cfbe3f5e1d12e","target_body_sha256":"d91f5e0da1e27a81689e4f2148e6909a21eec26dccd43ef72c75e8af14a612d2","unit_key":"form-001000F"},"kind":"FORM","matrix_counted":true,"operative_db_projection_sha256":"96b74490e85e7f66ffd898e0de2aba4fe8e707f3e7c30a63a4d8833910b25abf","operative_db_projection_text":"교통·에너지·환경세[미납세·면세]반출물품멸실[승인신청서·승인서]\n[별지 제10호서식] <개정 2007.4.5>                                         (앞  쪽)            \n\n\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━━━━━┓\n\n\n┃                      ┌ □미납세 ┐            ┌ □승인신청서 ┐        │처리기간        ┃\n\n\n┃ 교통ㆍ에너지ㆍ환경세 │          │반출물품멸실│              │        ├────────┨\n\n\n┃                      └ □면  세 ┘            └ □승  인  서 ┘        │5일             ┃\n\n\n┠─┬──────────┬───────────┬───────────┬┴────────┨\n\n\n┃신│① 성  명(대 표 자) │                      │② 주민(법인)등록번호 │                  ┃\n\n\n┃  ├──────────┼───────────┼───────────┼─────────┨\n\n\n┃청│③ 상  호(법 인 명) │                      │④ 전  화   번   호   │                  ┃\n\n\n┃  ├──────────┼───────────┴───────────┴─────────┨\n\n\n┃인│⑤ 주  소(본점소재지)│                                                                  ┃\n\n\n┃  ├──────────┼───────────┬───────────┬─────────┨\n\n\n┃  │⑥ 제 조 장 소 재 지│                      │⑦ 사업자등록번호     │                  ┃\n\n\n┠─┴──────────┼───────────┼───────────┼─────────┨\n\n\n┃⑧ 승   인    번    호  │ 제        호         │⑨ 승 인 연 월 일     │  년    월    일  ┃\n\n\n┠────────────┴───────────┴───────────┴─────────┨\n\n\n┃신      청     내      용                                                                   ┃\n\n\n┠─────┬────┬─────┬─────┬─────┬──────┬────┬─────┨\n\n\n┃⑩ 품  명 │⑪ 수 량│⑫ 규  격 │⑬ 단   가│⑭ 가   격│⑮ 세  율   │ 세  액 │ 적  요   ┃\n\n\n┠─────┼────┼─────┼─────┼─────┼──────┼────┼─────┨\n\n\n┃          │        │          │          │          │            │        │          ┃\n\n\n┠─────┼────┼─────┼─────┼─────┼──────┼────┼─────┨\n\n\n┃          │        │          │          │          │            │        │          ┃\n\n\n┠─────┴────┴┬────┴─────┴┬────┴─────┬┴────┴─────┨\n\n\n┃ 멸  실  연  월  일   │년    월    일        │ 반입증명서제출기한 │년    월    일        ┃\n\n\n┠───────────┼───────────┴──────────┴───────────┨\n\n\n┃ 멸   실   장   소    │                                                                    ┃\n\n\n┠───────────┼──────────────────────────────────┨\n\n\n┃ 멸실물품의 처리방법  │                                                                    ┃\n\n\n┠───────────┼──────────────────────────────────┨\n\n\n┃ 참    고    사    항 │                                                                    ┃\n\n\n┠───────────┴──────────────────────────────────┨\n\n\n┃   「교통ㆍ에너지ㆍ환경세법」 제12조제3항에 따라 위와 같이 승인을 신청합니다.               ┃\n\n\n┃                                                                                            ┃\n\n\n┃                                                 년       월       일                       ┃\n\n\n┃                                                                                            ┃\n\n\n┃      세무서장                                                                              ┃\n\n\n┃                     귀하                                                                   ┃\n\n\n┃      세 관 장                                     신청인             (서명 또는 인)        ┃\n\n\n┠──────────────────────────────────────────────┨\n\n\n┃  제     호                                                                                 ┃\n\n\n┃     위 신청사항을 승인합니다.                                                              ┃\n\n\n┃                                                 년       월       일                       ┃\n\n\n┃                                                             세무서장                       ┃\n\n\n┃                                                                             ??           ┃\n\n\n┃                                                             세 관 장                       ┃\n\n\n┃               귀하                                                                         ┃\n\n\n┠─────────────────────────────────────────┬────┨\n\n\n┃   구비서류 : 해당 멸실사실증명서 1부                                             │수 수 료┃\n\n\n┃  ※ 이 신청서는 무료로 배부합니다.                                               ├────┨\n\n\n┃                                                                                  │없    음┃\n\n\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┷━━━━┛\n\n\n  일반용지 60g/㎡(재활용품) 또는 신문용지 54g/㎡(재활용품)                                      \n\n\n                                                                                                \n\n\n\n\n\n\n                                        \n\n\n  (뒤쪽)                                \n\n\n┏━━━━━━━━━━━━━━━━━━┓\n\n\n┃이 신청서는 아래와 같이 처리됩니다. ┃\n\n\n┠────────┬─────────┨\n\n\n┃신청인          │처리기관          ┃\n\n\n┃                ├─────────┨\n\n\n┃                │사업장 관할 세무서장ㆍ세관장┃\n\n\n┠────────┼─────────┨\n\n\n┃                │                  ┃\n\n\n┃┌──────┐│    ┌─────┐┃\n\n\n┃│신청서작성  ││  ▶│접수      │┃\n\n\n┃│            ││    │(민원봉사실)│┃\n\n\n┃│            ├┼─  │          │┃\n\n\n┃│            ││    │          │┃\n\n\n┃│            ││    │          │┃\n\n\n┃└──────┘│    └──┬──┘┃\n\n\n┃      ▲        │          │      ┃\n\n\n┃                │                  ┃\n\n\n┃      │승      │          ▼      ┃\n\n\n┃      │인      │    ┌─────┐┃\n\n\n┃      │서      │    │조사ㆍ확인│┃\n\n\n┃      │        │    │(담당과)  │┃\n\n\n┃      │교      │    │          │┃\n\n\n┃      │부      │    └──┬──┘┃\n\n\n┃      │        │          │      ┃\n\n\n┃      │        │                  ┃\n\n\n┃      │        │          ▼      ┃\n\n\n┃      │        │    ┌─────┐┃\n\n\n┃      │        │    │결재      │┃\n\n\n┃      │        │    │(과장전결)│┃\n\n\n┃      │        │    │          │┃\n\n\n┃      │        │    └──┬──┘┃\n\n\n┃      │        │          │      ┃\n\n\n┃      │        │                  ┃\n\n\n┃      │        │          ▼      ┃\n\n\n┃      │        │    ┌─────┐┃\n\n\n┃      │        │    │승인서작성│┃\n\n\n┃      │        │    │(담당과)  │┃\n\n\n┃      └────┼──┤          │┃\n\n\n┃                │    │          │┃\n\n\n┃                │    └─────┘┃\n\n\n┃                │                  ┃\n\n\n┗━━━━━━━━┷━━━━━━━━━┛","registered_author_completion":{"author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8.ascii.json","sha256":"a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8"},"handoff":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_completions\\a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8.json","sha256":"f383b25c559f8636456cd27c6bbe53433a8effc08406718daf349d3ee24c363c"},"registration":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\direct_ingest_v1\\registered_author_handoffs\\a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8.json","sha256":"4fe14632256a11a5bafc9c8144dba93