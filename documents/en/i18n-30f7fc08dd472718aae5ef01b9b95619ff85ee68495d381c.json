a8a55228e81f669861fc86c2cdce06bc9342282484eaec675c714dea54b1724e","source_law_id":"kr-006574-270243-ko","source_review_complete":true,"source_xml_sha256":"99129fa87198dde7d65113cb7db1fbce6f402e0eebdd4849d79cfbe3f5e1d12e","target_body_sha256":"35df7fd5cc0981a59e74cacbc5cc388aa0b82a797b82d16202d11d981de2c210","unit_key":"form-001600F"},"kind":"FORM","matrix_counted":true,"operative_db_projection_sha256":"645fd3e9b9bb076bcb0844a3ef5f8e2a56c90fe25d9dc4363eb18a839ba324b3","operative_db_projection_text":"유류면세용도사용[확인신청서·확인서]\n[별지 제16호서식] <개정 2007.4.5>                                         (앞  쪽)    \n\n\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━━━━━┓\n\n\n┃                 ┌ □확인신청서 ┐                               │처리기간        ┃\n\n\n┃유류면세용도사용 │              │                               ├────────┨\n\n\n┃                 └ □확  인  서 ┘                               │5일             ┃\n\n\n┠─┬───────────┬─────┬───────────┬─┴────────┨\n\n\n┃신│① 성  명(대 표 자)   │          │② 주민(법인)등록번호 │                    ┃\n\n\n┃청├───────────┼─────┼───────────┼──────────┨\n\n\n┃인│③ 상  호(법 인 명)   │          │④ 전  화   번   호   │                    ┃\n\n\n┃  ├───────────┼─────┴───────────┴──────────┨\n\n\n┃  │⑤ 주  소(본점소재지) │                                                        ┃\n\n\n┠─┴───────────┴────────────────────────────┨\n\n\n┃사      용     내      용                                                           ┃\n\n\n┠──────────┬──────┬──────┬───────┬─────────┨\n\n\n┃⑥ 유   류   명     │⑦ 수     량│⑧ 단     가│⑨ 금     액  │⑩ 적     요      ┃\n\n\n┠──────────┼──────┼──────┼───────┼─────────┨\n\n\n┃                    │            │            │              │                  ┃\n\n\n┠──────────┼──────┼──────┼───────┼─────────┨\n\n\n┃                    │            │            │              │                  ┃\n\n\n┠──────────┼──────┴┬─────┴─────┬─┴─────────┨\n\n\n┃⑪ 사   용   장   소│              │⑫ 사업자등록번호     │                      ┃\n\n\n┠──────────┼───────┼───────────┼───────────┨\n\n\n┃⑬ 사   용   일   자│년   월   일  │⑭ 반   입    일   자 │년   월   일          ┃\n\n\n┠──────────┼───────┴───────────┴───────────┨\n\n\n┃⑮ 사   용   용   도│                                                              ┃\n\n\n┠──────────┴───────────────────────────────┨\n\n\n┃                                                                                              ─┒┃\n\n\n┃    위와 같이 당해 용도에 사용하였음을 「교통ㆍ에너지ㆍ환경세법 시행    □ 제23조제1항제2호     ┃┃\n\n\n┃  령」                                                              ┌─                    ─┐┃┃\n\n\n┃                                                                    │                        │┃┃\n\n\n┃                                                                    │                        │┃┃\n\n\n┃                                                                    │  □ 제24조제2항제4호   │┃┃\n\n\n┃                                                                    └─                    ─┘┃┃\n\n\n┃                                                                                                ┃┃\n\n\n┃                                                                                                  ┃\n\n\n┃                                                                                    ┃\n\n\n┃에 따라 확인하여 주시기 바랍니다.                                                   ┃\n\n\n┃                                                                                    ┃\n\n\n┃      년       월       일                                                          ┃\n\n\n┃                                                                                    ┃\n\n\n┃                                                      신청인          (서명 또는 인)┃\n\n\n┃                                                                                    ┃\n\n\n┃                장관  귀하                                                          ┃\n\n\n┠──────────────────────────────────────────┨\n\n\n┃  제      호                                                                        ┃\n\n\n┃       위 사실을 확인합니다.                                                        ┃\n\n\n┃      년       월       일                                                          ┃\n\n\n┃장관  ??                                                                          ┃\n\n\n┃             귀하                                                                   ┃\n\n\n┠──────────────────────────────────┬───────┨\n\n\n┃   구비서류 : 없 음                                                 │수 수 료      ┃\n\n\n┃  ※ 이 신청서는 무료로 배부합니다.                                 ├───────┨\n\n\n┃                                                                    │없    음      ┃\n\n\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┷━━━━━━━┛\n\n\n  일반용지 60g/㎡(재활용품) 또는 신문용지 54g/㎡(재활용품)                              \n\n\n                                                                                        \n\n\n\n\n\n\n                                              \n\n\n  (뒤쪽)                                      \n\n\n┏━━━━━━━━━━━━━━━━━━━━━┓\n\n\n┃이 신청서는 아래와 같이 처리됩니다.       ┃\n\n\n┠──────────┬──────────┨\n\n\n┃신청인              │처리기관            ┃\n\n\n┃                    ├──────────┨\n\n\n┃                    │관할기관의 장       ┃\n\n\n┠──────────┼──────────┨\n\n\n┃                    │                    ┃\n\n\n┃┌────────┐│    ┌──────┐┃\n\n\n┃│신청서작성      ││  ▶│접수        │┃\n\n\n┃│                ├┼─  │(민원봉사실)│┃\n\n\n┃│                ││    │            │┃\n\n\n┃└────────┘│    └┬─────┘┃\n\n\n┃  ▲                │      │            ┃\n\n\n┃                    │                    ┃\n\n\n┃  │확인서 교부     │      ▼            ┃\n\n\n┃  │                │    ┌──────┐┃\n\n\n┃  │                │    │조사ㆍ확인  │┃\n\n\n┃  │                │    └┬─────┘┃\n\n\n┃  │                │      │            ┃\n\n\n┃  │                │                    ┃\n\n\n┃  │                │      ▼            ┃\n\n\n┃  │                │    ┌──────┐┃\n\n\n┃  │                │    │결재        │┃\n\n\n┃  │                │    └┬─────┘┃\n\n\n┃  │                │      │            ┃\n\n\n┃  │                │                    ┃\n\n\n┃  │                │      ▼            ┃\n\n\n┃  │                │    ┌──────┐┃\n\n\n┃  └────────┼──┤확인서 작성 │┃\n\n\n┃                    │    │            │┃\n\n\n┃                    │    └──────┘┃\n\n\n┃                    │                    ┃\n\n\n┗━━━━━━━━━━┷━━━━━━━━━━┛","registered_author_completion":{"author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\16c6d617c56f2dc77f0bfab36622a97219e953ce5e6f56f8b1f9257268fc967c.ascii.json","sha256":"16c6d617c56f2dc77f0bfab36622a97219e953ce5e6f56f8b1f9257268fc967c"},"handoff":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_completions\\16c6d617c56f2dc77f0bfab36622a97219e953ce5e6f56f8b1f9257268fc967c.json","sha256":"ee1a7f068c972d5e9710beef7dba4be1ce393d0320a4a85bd4c9e6eac357d352"},"registration":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\direct_ingest_v1\\registered_author_handoffs\\16c6d617c56f2dc77f0bfab36622a97219e953ce5e6f56f8b1f9257268fc967c.json","sha256":"0220065a62fb100f57376c5b057869ea9611609824430595bdc49cb441905bbb"}},"source_component_text_sha256":"a8a55228e81f669861fc86c2cdce06bc9342282484eaec675c714dea54b1724e","source_graphic_observation_sha256":null,"source_graphic_reconciliation_sha256":null,"source_graphics":[{"asset_byte_length":33346,"asset_file":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\source_assets_v1\\assets\\RULE\\150201595.gif","asset_key":"RULE_150201595","asset_sha256":"da217ffd9f735761d5e82ea7b48ec78a6d3977496983fbecd15ca6af10086d5f","component":"RULE","final_url":"https://www.law.go.kr/LSW/flDownload.do?flSeq=150201595