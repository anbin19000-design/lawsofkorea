6":"2b1fe3ca04652a21fc3d5576000a5e167355b5b9411442b67603642b060341e7"},{"end":89890,"start":89868,"target_end":1824,"target_start":1802,"text_sha256":"ac0fbe237a76e581749f0214dacc8e2ceafbdcafac2f190905ba8dffa186892b"}],"scope_plan_file":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\english_reuse_analysis_v1\\DECREE_exact_reuse_scope_plan_v1.json","scope_plan_sha256":"f4c4869ba5fc8def4162bfeb76a6cc64715aeb9a1b12dab01f6f453627a9ab4a","source_body_sha256":"a9b0bfc70a27552562e7968a943b25456511d98d46a8f21ab5ec28a20ca464f2","source_language":"en","source_law_id":"kr-002619-288439-en","source_text_role":"OFFICIAL_TRANSLATION","source_unit_span":{"boundary_note":"Actual complete English unit span; adjacent standalone date/number metadata excluded.","end":89890,"start":88072,"text":"ADDENDA <Presidential Decree No. 36235, Apr. 1, 2026>\nArticle 1 (Enforcement date)\nThis Decree shall enter into force on the date of its promulgation.\nArticle 2 (Applicability following temporary adjustment of flexible tax rates for gasoline and diesel)\n(1) The amended proviso of subparagraph 1 of Article 3-2 and the amended proviso of subparagraph 2 of that Article shall apply to articles shipped out from a manufacturing place or for which an import declaration is filed during the period from March 27, 2026 to May 31, 2026.\n(2) Where a taxpayer referred to in Article 3 of the Act files a report by April 30, 2026, with the head of the competent tax office or customs office, regarding articles for which the tax rate has been reduced under the amended proviso of Article 3-2, subparagraph 1 and the amended proviso of subparagraph 2 of that Article, and which were shipped out or for which an import declaration was filed during the period from March 27, 2026 to the day immediately preceding the enforcement date of this Decree, along with evidentiary documents prescribed by the Commissioner of the National Tax Service or the Commissioner of the Korea Customs Service, such as tax invoices, verifying such fact, the tax amount corresponding to the reduction in the tax rate under the amended proviso of subparagraph 1 of Article 3-2 and the amended proviso of subparagraph 2 of that Article shall be refunded or deducted from the tax amount payable.\n(3) Notwithstanding the amended proviso of subparagraph 1 of Article 3-2 and the amended proviso of subparagraph 2 of that Article, the previous provisions thereof shall apply to the traffic, energy, and environment tax rates on the articles which are shipped out from a manufacturing place or for which an import declaration is filed before March 26, 2026.","text_sha256":"b0135e7e7a8c3e484475df00d7b08896c9557dce79aaae9b1080832bc8c39094"},"version_scope_claim":"Same held edition288439, but only the individually compared complete source units are reusable; no full English-edition completeness is claimed."},"source_component_text_sha256":"0691afae7c3afad01e246d9236518f1ebeb59a454cab5343563ffce7e1c68336","source_graphic_observation_sha256":null,"source_graphic_reconciliation_sha256":null,"source_graphics":[],"source_kind":"OTHER","source_unit_evidence_hash_basis":{"source_component_text_sha256":"0691afae7c3afad01e246d9236518f1ebeb59a454cab5343563ffce7e1c68336","source_graphic_observation_sha256":null,"source_graphic_reconciliation_sha256":null,"source_graphics":[],"source_law_id":"kr-002619-288439-ko","source_xml_sha256":"6fddccc8dd40d065ba4af293d38ee89d2ecaf5b6b4ebb45961fc19ab8c83311e","unit_key":"addenda-36235-20260401"},"source_unit_evidence_sha256":"298c164b922a68845fe11518523cf846d2535c4faf5290d9ca4941763bd2880f","source_unit_ordinal":108,"source_xml_attributes":{"부칙키":"2026040136235"},"source_xml_tag":"부칙단위","target_body_sha256":"b65eb52afea87474752dace75fa4e9d71dd1a9f6341e107ee5e0174a1681c32d","target_ordinal":0,"unit_key":"addenda-36235-20260401"}],"structural_heading_count":0,"task_id":"WORKC_1129_2094","translation_complete":tru