6834dc423bfebd463ce3c7fd173c293a126cea2576e"},"source_temporal_metadata":{"effective":"2025-03-21","promulgated":"2025-03-21"},"source_unit_count":1,"source_unit_map":[{"api_kind":"FORM","author_source_review_evidence":{"exact_author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\bc983949d570f5413dd3a44458be46f793eb6d524b183665bf2730e9a80d6dd2.ascii.json","sha256":"bc983949d570f5413dd3a44458be46f793eb6d524b183665bf2730e9a80d6dd2"},"protocol":"WORKC_P04_1526_EXPLICIT_SOURCE_REVIEWED_AUTHOR_INPUT_V1","reviewed_source_units":[{"source_component_text_sha256":"b1e4a463c7501dd3f653fb7c1f83a82eaf52ba14dd05fe09686702b840d28444","unit_key":"form-000700F"},{"source_component_text_sha256":"b26c129f82d4bacf505211a448a76a4c380f55c49236b642b8149f576822a358","unit_key":"form-000800F"}],"source_component_text_sha256":"b1e4a463c7501dd3f653fb7c1f83a82eaf52ba14dd05fe09686702b840d28444","source_law_id":"kr-006574-270243-ko","source_review_complete":true,"source_xml_sha256":"99129fa87198dde7d65113cb7db1fbce6f402e0eebdd4849d79cfbe3f5e1d12e","target_body_sha256":"2d183fb435af34b735ed179f501b8eafd275041971191d46f72f8247abaa5305","unit_key":"form-000700F"},"kind":"FORM","matrix_counted":true,"operative_db_projection_sha256":"2950cfa9dd51dcc8879a2b3ce60ec10e6095c153d4443943ca177c96e9fe2471","operative_db_projection_text":"교통·에너지·환경세[수출·군납]면세반출[승인신청서·승인서]\n[별지 제7호서식] <개정 2007.4.5>                                        (앞  쪽)                \n\n\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━━━━┓\n\n\n┃                      ┌ □수 출 ┐          ┌ □승인신청서┐                │처리기간      ┃\n\n\n┃  교통ㆍ에너지ㆍ환경세│         │ 면세반출 │             │                ├───────┨\n\n\n┃                      └ □군 납 ┘          └ □승  인  서┘                │5일           ┃\n\n\n┠────┬───────────┬──────────┬─────────┬─┴───────┨\n\n\n┃신 ?   │① 성 명(대 표 자)    │                    │② 주민(법인)등록번호│                  ┃\n\n\n┃   반   ├───────────┼──────────┼─────────┼─────────┨\n\n\n┃청 출   │③ 상 호(법 인 명)    │                    │④ 전  화   번   호│                  ┃\n\n\n┃   자   ├───────────┼──────────┴─────────┴─────────┨\n\n\n┃인 ?   │⑤ 주 소(본점소재지)  │                                                            ┃\n\n\n┃        ├───────────┼──────────┬─────────┬─────────┨\n\n\n┃        │⑥ 판 매ㆍ반 출 장 소 │                    │⑦ 사업자등록번호 │                  ┃\n\n\n┠────┴───────────┴──────────┴─────────┴─────────┨\n\n\n┃신      청     내      용                                                                     ┃\n\n\n┠─────┬────┬──────┬─────┬─────┬─────┬─────┬─────┨\n\n\n┃⑧ 품  명 │⑨ 수 량│⑩ 규  격   │⑪ 단   가│⑫ 가   격│⑬ 세  율 │⑭ 세  액 │⑮ 적  요 ┃\n\n\n┠─────┼────┼──────┼─────┼─────┼─────┼─────┼─────┨\n\n\n┃          │        │            │          │          │          │          │          ┃\n\n\n┠─────┼────┼──────┼─────┼─────┼─────┼─────┼─────┨\n\n\n┃          │        │            │          │          │          │          │          ┃\n\n\n┠─────┴────┴───┬──┴─────┴─────┴─────┴─────┴─────┨\n\n\n┃ 수 출 (군  납) 처          │                                                                ┃\n\n\n┠──────────────┼────────────────────────────────┨\n\n\n┃ 수 출 세 관 명             │                                                                ┃\n\n\n┠────┬─────────┼───────────┬───────────┬────────┨\n\n\n┃수 ?   │ 성 명(대표자)    │        (서명 또는 인)│ 주민(법인)등록번호   │                ┃\n\n\n┃   납   ├─────────┼───────────┼───────────┼────────┨\n\n\n┃출 품   │ 상 호(법인명)    │                      │ 사업자등록번호       │                ┃\n\n\n┃   자   ├─────────┼───────────┴───────────┴────────┨\n\n\n┃자 ?   │ 주소(본점소재지) │                                                                ┃\n\n\n┠────┴─────────┼───────────┬───────────┬────────┨\n\n\n┃ 반 출 예 정 일 자          │   년   월   일       │ 용도증명서제출기한   │   년   월   일 ┃\n\n\n┠──────────────┼───────────┴───────────┴────────┨\n\n\n┃ 승 인 신 청 사 유          │「교통ㆍ에너지ㆍ환경세법」   제13조 제1항 제   호               ┃\n\n\n┠──────────────┼────────────────────────────────┨\n\n\n┃ 참    고    사    항       │                                                                ┃\n\n\n┠──────────────┴────────────────────────────────┨\n\n\n┃                                                                                              ┃\n\n\n┃   「교통ㆍ에너지ㆍ환경세법」 제13조제1항에 따라 면세반출하기 위하여 그 승인을 신청합니       ┃\n\n\n┃다.                                                                                           ┃\n\n\n┃                                                                                              ┃\n\n\n┃      년       월       일                                                                    ┃\n\n\n┃                                                  신청인             (서명 또는 인)           ┃\n\n\n┃      세무서장                                                                                ┃\n\n\n┃                  귀하                                                                        ┃\n\n\n┃      세 관 장                                                                                ┃\n\n\n┠───────────────────────────────────────────────┨\n\n\n┃  제     호                                                                                   ┃\n\n\n┃                                                                                              ┃\n\n\n┃     위와 같이    년   월   일까지 용도증명서를 제출할 것을 조건으로 승인합니다.              ┃\n\n\n┃                                                                                              ┃\n\n\n┃      년       월       일                                                                    ┃\n\n\n┃                                                             세무서장                         ┃\n\n\n┃                                                                              ??            ┃\n\n\n┃                                                             세 관 장                         ┃\n\n\n┃               귀하                                                                           ┃\n\n\n┠──────────────────────────────────────────┬────┨\n\n\n┃   구비서류 : 수출신용장 또는 납품계약서의 사본                                     │수 수 료┃\n\n\n┃  ※ 이 신청서는 무료로 배부합니다.                                                 ├────┨\n\n\n┃                                                                                    │없    음┃\n\n\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┷━━━━┛\n\n\n  일반용지 60g/㎡(재활용품) 또는 신문용지 54g/㎡(재활용품)                                        \n\n\n                                                                                                  \n\n\n\n\n\n\n                                          \n\n\n  (뒤쪽)                                  \n\n\n┏━━━━━━━━━━━━━━━━━━━┓\n\n\n┃이 신청서는 아래와 같이 처리됩니다.   ┃\n\n\n┠─────────┬─────────┨\n\n\n┃신청인            │처리기관          ┃\n\n\n┃                  ├─────────┨\n\n\n┃                  │사업장 관할 세무서장ㆍ세관장┃\n\n\n┠─────────┼─────────┨\n\n\n┃                  │                  ┃\n\n\n┃┌───────┐│    ┌─────┐┃\n\n\n┃│신청서작성    ││    │접수      │┃\n\n\n┃│              ├┼─▶│(민원봉사실)│┃\n\n\n┃│              ││    │          │┃\n\n\n┃│              ││    │          │┃\n\n\n┃│              ││    │          │┃\n\n\n┃│              ││    │          │┃\n\n\n┃└───────┘│    └──┬──┘┃\n\n\n┃      ▲          │          │      ┃\n\n\n┃                  │          │      ┃\n\n\n┃      │          │          │      ┃\n\n\n┃      │          │                  ┃\n\n\n┃      │          │          ▼      ┃\n\n\n┃      │          │    ┌─────┐┃\n\n\n┃      │승        │    │조사ㆍ확인│┃\n\n\n┃      │인        │    │(담당과)  │┃\n\n\n┃      │서        │    │          │┃\n\n\n┃      │          │    │          │┃\n\n\n┃      │교        │    └──┬──┘┃\n\n\n┃      │부        │          │      ┃\n\n\n┃      │          │          │      ┃\n\n\n┃      │          │                  ┃\n\n\n┃      │          │          ▼      ┃\n\n\n┃      │          │    ┌─────┐┃\n\n\n┃      │          │    │결재      │┃\n\n\n┃      │          │    │(과장전결)│┃\n\n\n┃      │          │    │          │┃\n\n\n┃      │          │    └──┬──┘┃\n\n\n┃      │          │          │      ┃\n\n\n┃      │          │          │      ┃\n\n\n┃      │          │                  ┃\n\n\n┃      │          │          ▼      ┃\n\n\n┃      │          │    ┌─────┐┃\n\n\n┃      │          │    │승인서작성│┃\n\n\n┃      └─────┼──┤(담당과)  │┃\n\n\n┃                  │    │          │┃\n\n\n┃                  │    └─────┘┃\n\n\n┃                  │                  ┃\n\n\n┗━━━━━━━━━┷━━━━━━━━━┛","registered_author_completion":{"author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\bc983949d570f5413dd3a44458be46f793eb6d524b183665bf2730e9a80d6dd2.ascii.json","sha256":"bc983949d570f5413dd3a44458be46f793eb6d524b183665bf2730e9a80d6dd2"},"handoff":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_completions\\bc983949d570f5413dd3a44458be46f793eb6d524b183665bf2730e9a80d6dd2.json","sha256":"290f524457206d4ae549e350910b0a5376ab263d1e8e24ac0ad031d392ff8b1d"},"registration":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\direct_ingest_v1\\registered_author_handoffs\\bc983949d570f5413dd3a44458be46f793eb6d524b183665bf2730e9a80d6dd2.json","sha256":"82b5d4389c4b5865aef824f136b35411cf04641e581a3242fd204d7fbb8a67da"}},"source_component_text_sha256":"b1e4a463c7501dd3f653fb7c1f83a82eaf52ba14dd05fe09686702b840d28444","source_graphic_observation_sha256":null,"source_graphic_reconciliation_sha256":null,"source_graphics":[{"asset_byte_length":48323,"asset_file":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\source_assets_v1\\assets\\RULE\\150201515.gif","asset_key":"RULE_150201515","asset_sha256