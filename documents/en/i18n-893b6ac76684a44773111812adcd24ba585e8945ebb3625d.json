\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8.ascii.json","sha256":"a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8"},"protocol":"WORKC_P04_1526_EXPLICIT_SOURCE_REVIEWED_AUTHOR_INPUT_V1","reviewed_source_units":[{"source_component_text_sha256":"864f46fc9e3ef54987f62687924080f898cfa33f05b6c7ca797cc723577766ee","unit_key":"form-001000F"},{"source_component_text_sha256":"7e57073c7af5751fc175897ecc215ea7b44af817c0024e3150d9a05cf4031892","unit_key":"form-001100F"}],"source_component_text_sha256":"7e57073c7af5751fc175897ecc215ea7b44af817c0024e3150d9a05cf4031892","source_law_id":"kr-006574-270243-ko","source_review_complete":true,"source_xml_sha256":"99129fa87198dde7d65113cb7db1fbce6f402e0eebdd4849d79cfbe3f5e1d12e","target_body_sha256":"5d555a21c672cb2777c757089c7c67f715def42873d05dfd408d6ea32ddff184","unit_key":"form-001100F"},"kind":"FORM","matrix_counted":true,"operative_db_projection_sha256":"9e69ae61a1ae8570ecc390e134d7841771f430ada4d8ed288ca941d382c101e4","operative_db_projection_text":"교통·에너지·환경세[미납세·면세]반출물품멸실[증명증명신청서·증명서]\n[별지 제11호서식] <개정 2007.4.5>                                         (앞  쪽)    \n\n\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━━┓\n\n\n┃                    ┌ □미납세 ┐                 ┌ □증명신청서 ┐   │처리기간  ┃\n\n\n┃ 교통ㆍ에너지ㆍ환경세│          │반출물품멸실증명│              │   ├─────┨\n\n\n┃                    └ □면  세 ┘                 └ □증  명  서 ┘   │5일       ┃\n\n\n┠─┬─────────────┬────────┬──────────┬┴─────┨\n\n\n┃신│① 성  명(대 표 자)       │                │② 주민(법인)등록번호│            ┃\n\n\n┃  ├─────────────┼────────┼──────────┼──────┨\n\n\n┃청│③ 상  호(법 인 명)       │                │④ 전  화   번   호 │            ┃\n\n\n┃  ├─────────────┼────────┴──────────┴──────┨\n\n\n┃인│⑤ 주  소(본점소재지)     │                                                    ┃\n\n\n┃  ├─────────────┼────────┬──────────┬──────┨\n\n\n┃  │⑥ 제 조 장 소 재 지      │                │⑦ 사업자등록번호   │            ┃\n\n\n┠─┴─────────────┼────────┴──────────┴──────┨\n\n\n┃⑧ 승 인 세 무 서 명          │ 세무서                                             ┃\n\n\n┠───────────────┼────────┬──────────┬──────┨\n\n\n┃⑨ 승 인 연 월 일             │  년    월    일│⑩ 승   인   번   호│제       호 ┃\n\n\n┠───────────────┴────────┴──────────┴──────┨\n\n\n┃신      청     내      용                                                           ┃\n\n\n┠─────┬────────┬─────┬─────┬─────┬───┬─────┨\n\n\n┃⑪ 품  명 │⑫ 수  량       │⑬ 규  격 │⑭ 단  가 │⑮ 가  격 │ 세 율│ 세 액    ┃\n\n\n┠─────┼────────┼─────┼─────┼─────┼───┼─────┨\n\n\n┃          │                │          │          │          │      │          ┃\n\n\n┠─────┼────────┼─────┼─────┼─────┼───┼─────┨\n\n\n┃          │                │          │          │          │      │          ┃\n\n\n┠───┬─┴───────┬┴─────┴┬────┴──┬──┴───┴─────┨\n\n\n┃반출자│ 성명(대 표 자)   │              │ 상 호(법인명)│                        ┃\n\n\n┃      ├─────────┼───────┴───────┴────────────┨\n\n\n┃      │ 주소(본점소재지) │                                                        ┃\n\n\n┠───┴─────────┼────────────────────────────┨\n\n\n┃ 멸  실  연  월  일       │년        월         일                                 ┃\n\n\n┠─────────────┼────────────────────────────┨\n\n\n┃ 멸   실   사   유        │                                                        ┃\n\n\n┠─────────────┼────────────────────────────┨\n\n\n┃ 멸실물품의 처리방법      │                                                        ┃\n\n\n┠─────────────┼────────────────────────────┨\n\n\n┃ 참    고    사    항     │                                                        ┃\n\n\n┠─────────────┴────────────────────────────┨\n\n\n┃   위와 같이 멸실하였음을 「교통ㆍ에너지ㆍ환경세법 시행령」 제18조제2항에 따라 증명 ┃\n\n\n┃하여 주시기 바랍니다.                                                               ┃\n\n\n┃                                                                                    ┃\n\n\n┃      년       월       일                                                          ┃\n\n\n┃                                                      신청인         (서명 또는 인) ┃\n\n\n┃       세무서장  귀하                                                               ┃\n\n\n┠──────────────────────────────────────────┨\n\n\n┃  제     호                                                                         ┃\n\n\n┃     위 사실에 관하여 상위없음을 증명합니다.                                        ┃\n\n\n┃      년       월       일                                                          ┃\n\n\n┃                                                              세무서장  ??        ┃\n\n\n┃                귀하                                                                ┃\n\n\n┠─────────────────────────────────────┬────┨\n\n\n┃   구비서류 : 없 음                                                       │수 수 료┃\n\n\n┃  ※ 이 신청서는 무료로 배부합니다.                                       ├────┨\n\n\n┃                                                                          │없    음┃\n\n\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┷━━━━┛\n\n\n  일반용지 60g/㎡(재활용품) 또는 신문용지 54g/㎡(재활용품)                              \n\n\n                                                                                        \n\n\n\n\n\n\n                                              \n\n\n  (뒤쪽)                                      \n\n\n┏━━━━━━━━━━━━━━━━━━━━━┓\n\n\n┃이 신청서는 아래와 같이 처리됩니다.       ┃\n\n\n┠──────────┬──────────┨\n\n\n┃신청인              │처리기관            ┃\n\n\n┃                    ├──────────┨\n\n\n┃                    │사업장 관할 세무서장┃\n\n\n┠──────────┼──────────┨\n\n\n┃                    │                    ┃\n\n\n┃┌────────┐│    ┌──────┐┃\n\n\n┃│신청서작성      ││  ▶│접수        │┃\n\n\n┃│                ├┼─  │(민원봉사실)│┃\n\n\n┃│                ││    │            │┃\n\n\n┃└────────┘│    └┬─────┘┃\n\n\n┃  ▲                │      │            ┃\n\n\n┃                    │                    ┃\n\n\n┃  │증명서 교부     │      ▼            ┃\n\n\n┃  │                │    ┌──────┐┃\n\n\n┃  │                │    │조사ㆍ확인  │┃\n\n\n┃  │                │    │(담당과)    │┃\n\n\n┃  │                │    └┬─────┘┃\n\n\n┃  │                │      │            ┃\n\n\n┃  │                │                    ┃\n\n\n┃  │                │      ▼            ┃\n\n\n┃  │                │    ┌──────┐┃\n\n\n┃  │                │    │결재        │┃\n\n\n┃  │                │    │(과장전결)  │┃\n\n\n┃  │                │    └┬─────┘┃\n\n\n┃  │                │      │            ┃\n\n\n┃  │                │                    ┃\n\n\n┃  │                │      ▼            ┃\n\n\n┃  │                │    ┌──────┐┃\n\n\n┃  └────────┼──┤증명서작성  │┃\n\n\n┃                    │    │(담당과)    │┃\n\n\n┃                    │    └──────┘┃\n\n\n┃                    │                    ┃\n\n\n┗━━━━━━━━━━┷━━━━━━━━━━┛","registered_author_completion":{"author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8.ascii.json","sha256":"a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8"},"handoff":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_completions\\a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8.json","sha256":"f383b25c559f8636456cd27c6bbe53433a8effc08406718daf349d3ee24c363c"},"registration":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\direct_ingest_v1\\registered_author_handoffs\\a8fece4cdc5d5b1b99158d4997bc18258db34ad54cc96963e23ebf7c7b7f5bc8.json","sha256":"4fe14632256a11a5bafc9c8144dba93f03f88f216bdaa21a818d000e4de408d1"}},"source_component_text_sha256":"7e57073c7af5751fc175897ecc215ea7b44af817c0024e3150d9a05cf4031892","source_graphic_observation_sha256":null,"source_graphic_reconciliation_sha256":null,"source_graphics":[{"as