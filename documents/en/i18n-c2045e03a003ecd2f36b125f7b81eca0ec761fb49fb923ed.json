af90424eaa2e60628d4453c5b40878a07833b921c7c2796a82bb091","unit_key":"form-001400F"},{"source_component_text_sha256":"e40dfc5e45e4154389a0b54aeaf861b765aa5db1abe74375e28006d402411c0d","unit_key":"form-001500F"}],"source_component_text_sha256":"e40dfc5e45e4154389a0b54aeaf861b765aa5db1abe74375e28006d402411c0d","source_law_id":"kr-006574-270243-ko","source_review_complete":true,"source_xml_sha256":"99129fa87198dde7d65113cb7db1fbce6f402e0eebdd4849d79cfbe3f5e1d12e","target_body_sha256":"ffd80cf48018c636b09c791ec8e9d3d23de41a6342c648398832477cebac12eb","unit_key":"form-001500F"},"kind":"FORM","matrix_counted":true,"operative_db_projection_sha256":"615d3c4f98e735f79f589ad4210c5493e0ed5119e19e051f4d229726e20d92de","operative_db_projection_text":"유류면세용도사용보고서\n[별지 제15호서식] <개정 2007.4.5>                                         (앞  쪽)              \n\n\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━━━━━┓\n\n\n┃유류면세용도사용보고서                                                      │처리기간        ┃\n\n\n┃                                                                            ├────────┨\n\n\n┃                                                                            │즉    시        ┃\n\n\n┠─┬───────────┬───────┬──────────────┬─┴────────┨\n\n\n┃보│① 성  명(대 표 자)   │              │② 주민(법인)등록번호       │                    ┃\n\n\n┃  ├───────────┼───────┼──────────────┼──────────┨\n\n\n┃고│③ 상  호(법 인 명)   │              │④ 전  화   번   호         │                    ┃\n\n\n┃  ├───────────┼───────┴──────────────┴──────────┨\n\n\n┃자│⑤ 주  소(본점소재지) │                                                                  ┃\n\n\n┠─┴───────────┴─────────────────────────────────┨\n\n\n┃사      용     내      용                                                                     ┃\n\n\n┠──────────┬─────┬─────┬──────────────┬─────────┨\n\n\n┃⑥ 유  류  명       │⑦ 수   량│⑧ 단   가│⑨ 금  액                   │⑩ 적  요         ┃\n\n\n┠──────────┼─────┼─────┼──────────────┼─────────┨\n\n\n┃                    │          │          │                            │                  ┃\n\n\n┠──────────┼─────┼─────┼──────────────┼─────────┨\n\n\n┃                    │          │          │                            │                  ┃\n\n\n┠──────────┼─────┴───┬─┴────────────┬─┴─────────┨\n\n\n┃⑪ 사   용   장   소│                  │⑫ 사업자등록번호           │                      ┃\n\n\n┠──────────┼─────────┼──────────────┼───────────┨\n\n\n┃⑬ 사   용   일   자│     년   월   일 │⑭ 반   입    일   자       │      년   월   일    ┃\n\n\n┠──────────┼─────────┴──────────────┴───────────┨\n\n\n┃⑮ 사   용   용   도│                                                                        ┃\n\n\n┠──────────┴────────────────────────────────────┨\n\n\n┃                                                                                              ┃\n\n\n┃                                                                                              ┃\n\n\n┃  위와 같이 당해 용도에 사용하였음을 「교통ㆍ에너지ㆍ환경세법 시행    □ 제23조제1항제2호     ┃\n\n\n┃령」                                                              ┌─                    ─┐┃\n\n\n┃                                                                  │                        │┃\n\n\n┃                                                                  │                        │┃\n\n\n┃                                                                  │  □ 제24조제2항제4호   │┃\n\n\n┃                                                                  └─                    ─┘┃\n\n\n┃                                                                                              ┃\n\n\n┃                                                                                              ┃\n\n\n┃ 에 따라 보고합니다.                                                                          ┃\n\n\n┃                                                                                              ┃\n\n\n┃                                                                                              ┃\n\n\n┃      년       월       일                                                                    ┃\n\n\n┃                                                                                              ┃\n\n\n┃                                                      보고자         (서명 또는 인)           ┃\n\n\n┃             세무서장   귀하                                                                  ┃\n\n\n┠───────────────────────────────────────┬───────┨\n\n\n┃   구비서류 : 없 음                                                           │수 수 료      ┃\n\n\n┃  ※ 이 보고서는 무료로 배부합니다.                                           ├───────┨\n\n\n┃                                                                              │없    음      ┃\n\n\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┷━━━━━━━┛\n\n\n  일반용지 60g/㎡(재활용품) 또는 신문용지 54g/㎡(재활용품)                                        \n\n\n                                                                                                  \n\n\n\n\n\n\n\n\n\n\n                                        \n\n\n  (뒤쪽)                                \n\n\n┏━━━━━━━━━━━━━━━━━━┓\n\n\n┃  이 보고서는 아래와 같이 처리됩니다.┃\n\n\n┠───────┬──────────┨\n\n\n┃보고자        │처리기관            ┃\n\n\n┃              ├──────────┨\n\n\n┃              │사업장 관할 세무서장┃\n\n\n┠───────┼──────────┨\n\n\n┃              │                    ┃\n\n\n┃┌─────┐│    ┌──────┐┃\n\n\n┃│보고서작성││  ▶│접수        │┃\n\n\n┃│          ├┼─  │(민원봉사실)│┃\n\n\n┃│          ││    │            │┃\n\n\n┃└─────┘│    └┬─────┘┃\n\n\n┃              │      │            ┃\n\n\n┃              │                    ┃\n\n\n┃              │      ▼            ┃\n\n\n┃              │    ┌──────┐┃\n\n\n┃              │    │조사ㆍ확인  │┃\n\n\n┃              │    │(담당과)    │┃\n\n\n┃              │    └┬─────┘┃\n\n\n┃              │      │            ┃\n\n\n┃              │                    ┃\n\n\n┃              │      ▼            ┃\n\n\n┃              │    ┌──────┐┃\n\n\n┃              │    │결재        │┃\n\n\n┃              │    │(과장 전결) │┃\n\n\n┃              │    └──────┘┃\n\n\n┃              │                    ┃\n\n\n┗━━━━━━━┷━━━━━━━━━━┛","registered_author_completion":{"author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c.ascii.json","sha256":"389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c"},"handoff":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_completions\\389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c.json","sha256":"c7ae6b500f8cd8a98a8b58cf24f72ccbece8ba3c58142be0a559682da67e9a42"},"registration":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\direct_ingest_v1\\registered_author_handoffs\\389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c.json","sha256":"76d7ca435043db40a4ef4d2a3c5dde9f907b2a5b4b78a63e1cc13b1fed878d08"}},"source_component_text_sha256":"e40dfc5e45e4154389a0b54aeaf861b765aa5db1abe74375e28006d402411c0d","source_graphic_observation_sha256":null,"source_graphic_reconciliation_sha256":null,"source_graphics":[{"asset_byte_length":30698,"asset_file":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\source_assets_v1\\assets\\RULE\\150201587.gif","asset_key":"RULE_150201587","asset_sha256":"7b1cbe6eb8a86ee2d26452a5880c603024bb5c000a84948929fb53c424300c9a","component":"RULE","final_url":"https://www.law.go.kr/LSW/flDownload.do?flSeq=150201587","graphic_path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\source_assets_v1\\assets\\RULE\\150201587.gif","graphic_sha256":"7b1cbe6eb8a86ee2d26452a5880c603024bb5c000a84948929fb53c424300c9a","http