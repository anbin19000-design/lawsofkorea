w_pending\\WORKC_G01_P04\\1522_KR000068\\inventory_v1\\component_manifest.TONNAGE_RULE.v1.json","sha256":"da5362b58cbb95087fe6314c77559fe386dcdd68b8f5dedd94b851dbe3f9b26a"},"formal_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\inputs\\WORKC_G01_P04\\1522_KR000068\\input.json","sha256":"01e3dbe95ca728336f66a43437c1c1b9d3b9bce62b0acae19ca3d72be11209d8"}},"source_body_sha256":"48fb03f08910e36b3bd72867668123ed0e063c19a5636fe306400af68ec6478e","source_component_text_sha256":"8a2be0588bb33d939376887564539370a1efd9fedb7e3aabc8063ea32d4d0d7e","source_fragment_reuse_evidence":[],"source_preflight_record":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1522_KR000068\\direct_ingest_v1\\source_preflight.json","sha256":"99458a5fdfcceca04aa033e81460dc7c8e93a0598f0fe453aad31142eabea3ab"},"source_temporal_metadata":{"effective":"2021-06-30","promulgated":"2021-06-30"},"source_unit_count":1,"source_unit_map":[{"kind":"ARTICLE","matrix_counted":true,"operative_db_projection_sha256":"b4de20f55e2a688e1acbfdadd1f5f916e76a58aee3379674fac8787b1f5a5045","operative_db_projection_text":"제36조(2층 이상의 갑판이 있는 선박의 총톤수의 산정방법)\n①2층 이상의 갑판이 있는 선박의 총톤수는 제9조의 규정에 의한 국제총톤수에 다음 산식에 의하여 산정된 계수를 곱하여 얻은 값에 용적톤을 붙인 것으로 한다.\n    \n  (0.6+   t       )×(1+  30-t  )ㆍ(  B   -0.25)\n        ─────      ────    ───\n          10,000          180         A\n\n    t는 제9조의 규정에 의한 국제총톤수\n    A는 수선간장의 중앙에서의 형깊이에서 별표 6의 수선간장의 구분에 따라 동표에서 정하는 수치를 공제한 값(이하 이 조에서 같다)\n    B는 수선간장의 중앙에서 형깊이의 하단으로부터 선측에서 제2층에 있는 갑판의 하면까지의 수직거리(이하 이 조에서 같다)\n    \n  (0.6+   t       )\n        ─────\n          10,000\n의 값이 1 이상일 때에는 그 값을 1로 한다.\n    \n  (1+   30-t  )\n      ────\n        180\n의 값이 1 미만일 때에는 그 값을 1로 한다.\n    \n  B\n───\n  A\n의 값이 0.7 미만일 때에는 그 값을 0.7로 한다.\n②제1항의 규정에 의하여 총톤수를 산정하는 선박은 「선박안전법」 제27조에 따른 만재흘수선의 표시를 하는 선박으로서 다음의 요건에 적합하여야 한다. <개정 2007.11.23>\n1. 만재흘수선의 위치가 상갑판으로부터 제2층에 있는 갑판(이하 \"제2갑판\"이라 한다)을 건현갑판으로 하여 만재흘수선규정에 의하여 산정된 건현의 하단 또는 그 하방에 있을 것\n2. 상갑판과 제2갑판 사이에 있어서의 선수격벽과 선미격벽 사이에 있는 장소가 기관실ㆍ화물적재장소(포장되지 아니한 액체 또는 기체를 적재하기 위한 장소를 제외한다)ㆍ선용품창고ㆍ공작창 또는 이들에 부속된 장소일 것\n3. 다음 산식을 충족할 것\n    \n  B   ?0.9\n───\n  A\n","source_component_text_sha256":"8a2be0588bb33d939376887564539370a1efd9fedb7e3aabc8063ea32d4d0d7e","source_graphic_observation_sha256":null,"source_graphic_reconciliation_sha256":null,"source_graphics":[{"asset_byte_length":1360,"asset_file":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1522_KR000068\\source_assets_v1\\files\\graphic-ea560d8dd2c8ba3d3ffc.gif","asset_key":"graphic-ea560d8dd2c8ba3d3ffc","asset_sha256":"5ebff83b61549a91b6e83c6ce11bf47576aaf40dd6cb1e490a30b19023e9f4f4","exact_xml_node_verification":{"asset_key":"graphic-ea560d8dd2c8ba3d3ffc","component_kind":"TONNAGE_RULE","exact_reference":{"ancestor_chain":[{"attributes":{"법령키":"0074672021063000486"},"tag":"법령"},{"attributes":{},"tag":"조문"},{"attributes":{"조문키":"0036001"},"tag":"조문단위"},{"attributes":{},"tag":"항"},{"attributes":{},"tag":"항내용"}],"container":{"annex_title":null,"article_branch":null,"article_number":"36","article_title":"2층 이상의 갑판이 있는 선박의 총톤수의 산정방법","attributes":{"조문키":"0036001"},"tag":"조문단위"},"kind":"INLINE_IMAGE_IN_XML_TEXT","source_text_end":150,"source_text_start":92,"url":"http://www.law.go.kr/flDownload.do?flSeq=8412053"},"matching_leaf_nodes":[{"exact_url_span_end":150,"exact_url_span_start":102,"leaf_attributes":{},"leaf_tag":"항내용","leaf_text_sha256":"77e4a2b5a08f94e5be1b82be68ef4bf56601f59db78e36759aa78ddf01c61a85","source_inline_fragment":"<img src=\"http://www.law.go.kr/flDownload.do?flSeq=8412053","source_inline_fragment_sha256":"7d235d18a21601e8b9a30eca1c6a68e4b16109870bbfa467d7c13225ea923e73"}],"node_verified":true,"reference_index_zero_based":5,"source_law_id":"kr-007467-233591-ko","source_xml_sha256":"86d0a65be806f7367d84c8e503c399209a614e2ef6ffb877cf8a6bbdcaf5f140"},"final_url":"h