e3c7fd173c293a126cea2576e"},"source_temporal_metadata":{"effective":"2025-03-21","promulgated":"2025-03-21"},"source_unit_count":1,"source_unit_map":[{"api_kind":"FORM","author_source_review_evidence":{"exact_author_input":{"path":"D:\\lawsofkorea\\projece\\07_법률번역\\06_법령별다국어완성\\LAW12_20261018_1442\\workc_1129_2094\\review_pending\\WORKC_G01_P04\\1526_KR000623\\translations\\author_inputs\\389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c.ascii.json","sha256":"389efdda511138000ae8757dda9aa35320a03de9399e08064ec50cebd75f3b7c"},"protocol":"WORKC_P04_1526_EXPLICIT_SOURCE_REVIEWED_AUTHOR_INPUT_V1","reviewed_source_units":[{"source_component_text_sha256":"2fb7bd6f40dafc97c3fe591fd13656f131f2d10c77acbae7b6b54b31cab2dfd8","unit_key":"form-001200F"},{"source_component_text_sha256":"9486d42e7f358af6c08656eb99055e7f13534dfab5962c212fce58b39d0b4648","unit_key":"form-001300F"},{"source_component_text_sha256":"0c06f3f3baf90424eaa2e60628d4453c5b40878a07833b921c7c2796a82bb091","unit_key":"form-001400F"},{"source_component_text_sha256":"e40dfc5e45e4154389a0b54aeaf861b765aa5db1abe74375e28006d402411c0d","unit_key":"form-001500F"}],"source_component_text_sha256":"9486d42e7f358af6c08656eb99055e7f13534dfab5962c212fce58b39d0b4648","source_law_id":"kr-006574-270243-ko","source_review_complete":true,"source_xml_sha256":"99129fa87198dde7d65113cb7db1fbce6f402e0eebdd4849d79cfbe3f5e1d12e","target_body_sha256":"1c44e7bf3b13e5dcb52006df8dc0df107c68640c6882bf57c5cc0ce1535f51c9","unit_key":"form-001300F"},"kind":"FORM","matrix_counted":true,"operative_db_projection_sha256":"2307d3f2ff8f15f9201d5e89068061361464d682a72e4d30c2523c64203716bc","operative_db_projection_text":"외교공관용 석유류 판매보고 및 교통ㆍ에너지ㆍ환경세 공제(환급) 신청서\n■ 교통ㆍ에너지ㆍ환경세법 시행규칙 [별지 제13호서식] <개정 2014.5.26>                             \n\n\n                                                                                                    \n\n\n  외교공관용 석유류 판매보고 및 교통ㆍ에너지ㆍ환경세 공제(환급) 신청서                              \n\n\n                                                                                                    \n\n\n                                                                                                    \n\n\n──────────────────┬─────────┬───────────┬─────────\n\n\n  접수번호                          │접수일            │처리일                │처리기간    5일   \n\n\n──────────────────┴─────────┴───────────┴─────────\n\n\n                                                                                                    \n\n\n─────┬──────────────────────────────┬─────────────\n\n\n  신청인  │ 성 명(대표자)                                              │ 사업자등록번호           \n\n\n          ├──────────────────────────────┼─────────────\n\n\n          │ 상 호(법인명)                                              │                          \n\n\n          ├──────────────────────────────┼─────────────\n\n\n          │ 주 소(본점 소재지)                                         │ 전화번호                 \n\n\n          ├──────────────────────────────┴─────────────\n\n\n          │ 제조장 소재지                                                                          \n\n\n─────┴────────────────────────────────────────────\n\n\n                                                                                                    \n\n\n──────────────────────────────────────────────────\n\n\n   신 청 내용                                                                                       \n\n\n────┬─────┬──────┬──┬──┬───┬─────┬─────┬──────────\n\n\n  유류별│판매자    │판매 연월일 │수량│단가│금액  │공제(환급)│외교공관명│추천서 발행         \n\n\n        │          │            │    │    │      │세액      │          │연월일 및 일련번호  \n\n\n────┼─────┼──────┼──┼──┼───┼─────┼─────┼──────────\n\n\n        │          │            │    │    │      │          │          │                    \n\n\n────┼─────┼──────┼──┼──┼───┼─────┼─────┼──────────\n\n\n        │          │            │    │    │      │          │          │                    \n\n\n────┼─────┼──────┼──┼──┼───┼─────┼─────┼──────────\n\n\n        │          │            │    │    │      │          │          │                    \n\n\n────┼─────┼──────┼──┼──┼───┼─────┼─────┼──────────\n\n\n        │          │            │    │    │      │          │          │                    \n\n\n────┼─────┼──────┼──┼──┼───┼─────┼─────┼──────────\n\n\n        │          │            │    │    │      │          │          │                    \n\n\n────┼─────┼──────┼──┼──┼───┼─────┼─────┼──────────\n\n\n        │          │            │    │    │      │          │          │                    \n\n\n────┼─────┼──────┼──┼──┼───┼─────┼─────┼──────────\n\n\n        │          │            │    │    │      │          │          │                    \n\n\n────┼─────┼──────┼──┼──┼───┼─────┼─────┼──────────\n\n\n        │          │            │    │    │      │          │          │                    \n\n\n────┼─────┼──────┼──┼──┼───┼─────┼─────┼──────────\n\n\n        │          │            │    │    │      │          │          │                    \n\n\n────┼─────┼──────┼──┼──┼───┼─────┼─────┼──────────\n\n\n        │          │            │    │    │      │          │          │                    \n\n\n────┼─────┼──────┼──┼──┼───┼─────┼─────┼──────────\n\n\n        │          │            │    │    │      │          │          │                    \n\n\n────┴─────┴──────┴──┴──┴───┴─────┴─────┴──────────\n\n\n                                                                                                    \n\n\n                                                                                                    \n\n\n     위와 같이 외교공관용 석유류를 판매하였으므로 「교통ㆍ에너지ㆍ환경세법 시행령」 제20조제3항에   \n\n\n  따라 보고하며, 교통ㆍ에너지ㆍ환경세를 공제(환급)해 주시기 바랍니다.                               \n\n\n                                                                                                    \n\n\n    년          월          일                                                                      \n\n\n                                                                                                    \n\n\n  신청인                                              (서명 또는 인)                                \n\n\n                                                                                                    \n\n\n          세무서장   귀하                                                                           \n\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n\n                                                                                                    \n\n\n──────┬──────────────────────────────────┬────────\n\n\n  첨부서류  │면세석유류 구입추천서                                               │수수료          \n\n\n            │                                                                    │                \n\n\n            │                                                                    │없 음           \n\n\n──────┴──────────────────────────────────┴────────\n\n\n                                                                                                    \n\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n\n  처 리 절 차                                                                                       \n\n\n──────────────────────────────────────────────────\n\n\n                                                                                                    \n\n\n                                                                                                    \n\n\n┌────────┐  ┌─────────┐      ┌─────────┐    ┌──────────┐\n\n\n│신청서 작성     │?│접 수             │?    │조사 및 확인      │?  │결재 및 시행        │\n\n\n└────────┘  └─────────┘      └─────────┘    └──────────┘\n\n\n  신청인            납세 지원 담당 부서           세원 관리 담당 부서                               \n\n\n                                                                                                    \n\n\n                                                                                                    \n\n\n─────────────────────────